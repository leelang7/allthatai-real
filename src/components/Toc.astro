---
// Auto-generates table of contents from h2/h3 headings inside the article via client-side script.
---
<aside class="hidden xl:block">
  <div class="sticky top-24">
    <p class="text-[10px] font-bold uppercase tracking-widest text-zinc-500 mb-3">목차</p>
    <ul id="toc-list" class="space-y-1.5 text-sm text-zinc-400 max-h-[60vh] overflow-y-auto pr-2"></ul>
  </div>
</aside>
<script is:inline>
  (function () {
    const list = document.getElementById('toc-list');
    if (!list) return;
    const article = document.querySelector('article');
    if (!article) return;
    const headings = article.querySelectorAll('h2, h3');
    headings.forEach((h, i) => {
      if (!h.id) h.id = 'h' + i;
      const li = document.createElement('li');
      li.className = h.tagName === 'H3' ? 'pl-3 text-zinc-500' : '';
      const a = document.createElement('a');
      a.href = '#' + h.id;
      a.textContent = h.textContent || '';
      a.className = 'block hover:text-cyan-300 transition py-0.5 border-l border-transparent pl-2 -ml-2';
      a.addEventListener('click', (e) => {
        e.preventDefault();
        h.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      li.appendChild(a);
      list.appendChild(li);
    });
    // Highlight active section on scroll
    const links = list.querySelectorAll('a');
    const onScroll = () => {
      let activeIdx = 0;
      headings.forEach((h, i) => {
        if (h.getBoundingClientRect().top < 120) activeIdx = i;
      });
      links.forEach((a, i) => {
        a.classList.toggle('!text-cyan-300', i === activeIdx);
        a.classList.toggle('!border-cyan-500', i === activeIdx);
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
