---
import '../styles/global.css';
import StickyCta from '../components/StickyCta.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'AllThatAI Real — 불필요한 대행 거치지 마세요',
  description = '한국에서 모르고 돈 내고 있는 절차의 무료 우회 경로. AI · 세금 · 직구 · Play Store 가이드 + 시간 사는 풀패키지.',
  ogImage = '/og.png?v=6',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isHome = path === '/';
---
<!doctype html>
<html lang="ko" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/appicon.png" />
    <link rel="apple-touch-icon" href="/appicon.png" />
    <link rel="icon" type="image/svg+xml" href="/appicon.svg" />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="alternate" type="application/rss+xml" title="AllThatAI Real" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pretendard+Variable:wght@400;500;600;700;800;900&display=swap" />

    <title>{title}</title>
    <meta name="description" content={description} />

    {import.meta.env.PUBLIC_NAVER_SITE_VERIFICATION && (
      <meta name="naver-site-verification" content={import.meta.env.PUBLIC_NAVER_SITE_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {import.meta.env.PUBLIC_ADSENSE_CLIENT && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT}`} crossorigin="anonymous"></script>
    )}

    {import.meta.env.PUBLIC_GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}></script>
        <script is:inline define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId, { anonymize_ip: true });
        </script>
      </>
    )}

    <style is:global>
      :root {
        --font-sans: 'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
      }
      html, body { font-family: var(--font-sans); }
      body { font-feature-settings: 'ss06'; }

      /* mesh gradient bg */
      .bg-mesh {
        background-image:
          radial-gradient(at 20% 0%, rgba(34, 211, 238, 0.18) 0px, transparent 50%),
          radial-gradient(at 80% 0%, rgba(168, 85, 247, 0.16) 0px, transparent 50%),
          radial-gradient(at 0% 60%, rgba(236, 72, 153, 0.10) 0px, transparent 50%);
      }
      .glass {
        background: rgba(24, 24, 27, 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }
      /* card hover lift */
      .card-lift { transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease; }
      .card-lift:hover { transform: translateY(-2px); }

      /* gradient text */
      .text-gradient {
        background: linear-gradient(135deg, #22d3ee 0%, #a855f7 50%, #ec4899 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .text-gradient-cyan {
        background: linear-gradient(120deg, #22d3ee 0%, #06b6d4 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      /* subtle grid bg */
      .bg-grid {
        background-image:
          linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
        background-size: 32px 32px;
      }

      /* scrolling header */
      .nav-scroll {
        transition: background-color .2s ease, border-color .2s ease;
      }
      .nav-scroll.scrolled {
        background: rgba(9, 9, 11, 0.85);
        border-bottom-color: rgba(63, 63, 70, 0.6);
      }
    </style>
  </head>
  <body class="bg-zinc-950 text-zinc-100 antialiased min-h-dvh flex flex-col">
    <header id="topnav" class="nav-scroll sticky top-0 z-50 border-b border-transparent">
      <div class="mx-auto max-w-6xl flex items-center justify-between gap-3 px-4 py-3 sm:py-4">
        <a href="/" class="flex items-center gap-2 font-bold text-base sm:text-lg group shrink-0">
          <img src="/logo.png" alt="AllThatAI" width="32" height="32" class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl object-cover shadow-lg shadow-cyan-500/20" loading="eager" />
          <span class="text-white whitespace-nowrap">AllThatAI <span class="text-cyan-400">Real</span></span>
        </a>

        <!-- Desktop: 3 핵심 + 메뉴 토글 -->
        <nav class="hidden md:flex items-center gap-5 text-sm text-zinc-400">
          <a href="/jeonse" class="hover:text-rose-300 transition font-semibold whitespace-nowrap">
            <span class="text-rose-400">🏠</span> 전세사기
          </a>
          <a href="/traps" class="hover:text-rose-300 transition font-semibold whitespace-nowrap hidden lg:inline">
            <span class="text-rose-400">⚠</span> 대행함정
          </a>
          <a href="/store" class="hover:text-amber-300 transition font-semibold whitespace-nowrap">
            <span class="text-amber-400">$</span> 스토어
          </a>
          <a href="/deals/" class="hover:text-cyan-300 transition font-semibold whitespace-nowrap">핫딜</a>
          <a href="/tools/" class="hover:text-emerald-300 transition font-semibold whitespace-nowrap">계산기</a>
          <a href="/lol/" class="hover:text-violet-300 transition font-semibold whitespace-nowrap">
            <span class="text-violet-400">⚔</span> LoL
          </a>
          <a href="/search" class="hover:text-white transition" aria-label="검색">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </a>
          <button type="button" id="menu-toggle" class="rounded-lg border border-zinc-800 bg-zinc-900/50 px-3 py-1.5 hover:border-cyan-500/50 hover:text-white transition flex items-center gap-1.5" aria-label="메뉴 열기" aria-expanded="false">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            <span class="text-xs">메뉴</span>
          </button>
        </nav>

        <!-- Mobile: 햄버거만 -->
        <button type="button" id="menu-toggle-mobile" class="md:hidden rounded-lg border border-zinc-800 bg-zinc-900/50 p-2 hover:border-cyan-500/50 transition" aria-label="메뉴 열기" aria-expanded="false">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>

      <!-- DROPDOWN PANEL -->
      <div id="menu-panel" class="hidden border-t border-zinc-800 bg-zinc-950/95 backdrop-blur-md">
        <div class="mx-auto max-w-6xl px-4 py-6 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-6 gap-y-5">
          <div>
            <p class="text-[10px] font-black text-zinc-500 uppercase tracking-widest mb-2">콘텐츠</p>
            <ul class="space-y-1.5 text-sm">
              <li><a href="/jeonse/" class="text-rose-300 hover:text-rose-200">🏠 전세사기 방지</a></li>
              <li><a href="/traps/" class="text-rose-300 hover:text-rose-200">⚠ 대행함정</a></li>
              <li><a href="/issues/" class="text-zinc-300 hover:text-white">이슈 (자동)</a></li>
              <li><a href="/guides/" class="text-zinc-300 hover:text-white">가이드</a></li>
              <li><a href="/trackers/" class="text-zinc-300 hover:text-white">실시간 추적</a></li>
            </ul>
          </div>
          <div>
            <p class="text-[10px] font-black text-zinc-500 uppercase tracking-widest mb-2">핫딜 / 비교</p>
            <ul class="space-y-1.5 text-sm">
              <li><a href="/deals/ai/" class="text-cyan-300 hover:text-cyan-200">AI 도구</a></li>
              <li><a href="/deals/games/" class="text-zinc-300 hover:text-white">스팀 세일</a></li>
              <li><a href="/deals/keys/" class="text-zinc-300 hover:text-white">게임 키</a></li>
              <li><a href="/deals/vpn/" class="text-zinc-300 hover:text-white">VPN 비교</a></li>
              <li><a href="/deals/hotels/" class="text-zinc-300 hover:text-white">호텔</a></li>
              <li><a href="/deals/flights/" class="text-zinc-300 hover:text-white">항공권</a></li>
              <li><a href="/deals/aliexpress/" class="text-zinc-300 hover:text-white">알리·Temu</a></li>
            </ul>
          </div>
          <div>
            <p class="text-[10px] font-black text-zinc-500 uppercase tracking-widest mb-2">도구 / 계산기</p>
            <ul class="space-y-1.5 text-sm">
              <li><a href="/jeonse/risk-calc/" class="text-rose-300 hover:text-rose-200">전세 위험 점수</a></li>
              <li><a href="/jeonse/etungi-analyzer/" class="text-rose-300 hover:text-rose-200">등기부등본 분석</a></li>
              <li><a href="/tools/agent-fee-calc/" class="text-zinc-300 hover:text-white">대행 절감 계산</a></li>
              <li><a href="/tools/ai-pricing/" class="text-zinc-300 hover:text-white">AI 비용 계산</a></li>
              <li><a href="/tools/card-pick/" class="text-zinc-300 hover:text-white">카드 추천</a></li>
              <li><a href="/tools/team-plan-match/" class="text-zinc-300 hover:text-white">팀 플랜 분담</a></li>
              <li><a href="/lol/spell-timer/" class="text-zinc-300 hover:text-white">롤 스펠 쿨다운</a></li>
              <li><a href="/lotto/" class="text-amber-300 hover:text-amber-200">로또 추천</a></li>
            </ul>
          </div>
          <div>
            <p class="text-[10px] font-black text-zinc-500 uppercase tracking-widest mb-2">기타</p>
            <ul class="space-y-1.5 text-sm">
              <li><a href="/store/" class="text-amber-300 hover:text-amber-200">$ 스토어</a></li>
              <li><a href="/free/" class="text-emerald-300 hover:text-emerald-200">무료 자료</a></li>
              <li><a href="/services/play-launch/" class="text-zinc-300 hover:text-white">출시 대행</a></li>
              <li><a href="/snippets/" class="text-zinc-300 hover:text-white">복붙 스니펫</a></li>
              <li><a href="/symbols/" class="text-zinc-300 hover:text-white">☑ 특수문자</a></li>
              <li><a href="/lol/" class="text-zinc-300 hover:text-white">⚔ LoL 가이드</a></li>
              <li><a href="/contact/" class="text-zinc-300 hover:text-white">광고 문의</a></li>
            </ul>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <StickyCta />


    <footer class="border-t border-zinc-900 mt-24 bg-zinc-950">
      <div class="mx-auto max-w-6xl px-4 py-12">
        <div class="grid md:grid-cols-4 gap-8 mb-8">
          <div class="md:col-span-2">
            <div class="flex items-center gap-2.5 font-bold text-lg">
              <img src="/logo.png" alt="AllThatAI" width="36" height="36" class="w-9 h-9 rounded-xl object-cover" loading="lazy" />
              <span>AllThatAI Real</span>
            </div>
            <p class="mt-3 text-sm text-zinc-500 max-w-md leading-relaxed">
              한국에서 알아야 돈 안 잃는 정보. AI · 세금 · 직구 · 인디 개발 가이드와
              시간을 사는 옵션을 한 곳에.
            </p>
          </div>
          <div>
            <div class="text-xs font-bold text-zinc-300 mb-3 uppercase tracking-wider">메뉴</div>
            <ul class="space-y-2 text-sm text-zinc-500">
              <li><a href="/guides" class="hover:text-white">가이드</a></li>
              <li><a href="/trending" class="hover:text-white">트렌드</a></li>
              <li><a href="/services/play-launch" class="hover:text-white">출시 풀패키지</a></li>
            </ul>
          </div>
          <div>
            <div class="text-xs font-bold text-zinc-300 mb-3 uppercase tracking-wider">기타</div>
            <ul class="space-y-2 text-sm text-zinc-500">
              <li><a href="/contact" class="hover:text-white">광고 문의</a></li>
              <li><a href="/privacy" class="hover:text-white">개인정보</a></li>
            </ul>
          </div>
        </div>
        <div class="pt-6 border-t border-zinc-900 flex flex-wrap items-center justify-between gap-3 text-xs text-zinc-600">
          <div>© {new Date().getFullYear()} AllThatAI Real. 공식 출처 기반 Real 포털.</div>
          <div>대행 안 거치는 진짜 무료 경로</div>
        </div>
      </div>
    </footer>

    <script>
      const nav = document.getElementById('topnav');
      const onScroll = () => {
        if (!nav) return;
        if (window.scrollY > 8) nav.classList.add('scrolled');
        else nav.classList.remove('scrolled');
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Menu dropdown toggle
      const panel = document.getElementById('menu-panel');
      const toggles = [
        document.getElementById('menu-toggle'),
        document.getElementById('menu-toggle-mobile'),
      ].filter(Boolean);
      function togglePanel(force) {
        if (!panel) return;
        const isOpen = !panel.classList.contains('hidden');
        const next = force == null ? !isOpen : force;
        if (next) panel.classList.remove('hidden');
        else panel.classList.add('hidden');
        toggles.forEach((t) => t && t.setAttribute('aria-expanded', String(next)));
      }
      toggles.forEach((t) => t && t.addEventListener('click', (e) => {
        e.stopPropagation();
        togglePanel();
      }));
      // Close on outside click or escape
      document.addEventListener('click', (e) => {
        if (!panel || panel.classList.contains('hidden')) return;
        if (!panel.contains(e.target) && !toggles.some((t) => t && t.contains(e.target))) {
          togglePanel(false);
        }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') togglePanel(false);
      });
    </script>

    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>
  </body>
</html>
