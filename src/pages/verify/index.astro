---
import Layout from '../../layouts/Layout.astro';
import { verifyCategories } from '../../data/scam-verify';

const grouped: Record<string, typeof verifyCategories> = {};
verifyCategories.forEach((v) => {
  if (!grouped[v.category]) grouped[v.category] = [];
  grouped[v.category].push(v);
});

const catOrder = ['이미지·영상', '음성', '문서·증명서', '약관·계약', '텍스트', '리뷰·평판'];
const polluted = verifyCategories.filter((v) => v.prevalence === '폭증');
---
<Layout
  title="AI 사기 검증 — 딥페이크·딥보이스·문서위조·약관함정·피싱 한국어 통합"
  description="이미지·음성·문서·약관·텍스트 사기 13가지 통합 검증. 한국어 native AI. 자동 ₩2,900~9,900, 정밀 의뢰 ₩49K~199K."
>
  <section class="mx-auto max-w-5xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-rose-500/40 bg-rose-500/10 px-3 py-1 text-xs">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-rose-400 animate-pulse"></span>
      <span class="font-bold text-rose-300">한국 시장 폭증 사기 {polluted.length}개 카테고리</span>
    </div>
    <h1 class="mt-4 text-4xl sm:text-6xl font-black leading-tight">
      <span class="text-gradient">AI 사기 검증</span><br />
      <span class="text-zinc-300 text-2xl sm:text-3xl">아무도 안 하는 한국어 통합 (13개)</span>
    </h1>
    <p class="mt-4 text-lg text-zinc-400 leading-relaxed max-w-3xl">
      딥페이크·딥보이스·문서위조·약관함정·피싱·로맨스스캠·가짜리뷰 — 한국어 native. 자동 ₩2,900~ / 정밀 의뢰 ₩49K~199K. <strong class="text-rose-300">상용 한국어 솔루션 0개</strong> 시장.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="#categories" class="rounded-xl bg-rose-500 hover:bg-rose-400 text-white px-6 py-3 font-black transition shadow-lg shadow-rose-500/20">13개 검증 보기</a>
      <a href="/verify/auto/" class="rounded-xl bg-cyan-500 hover:bg-cyan-400 text-black px-6 py-3 font-black transition shadow-lg shadow-cyan-500/20">⚡ 붙여넣기만 하세요 — 자동 대조</a>
      <a href="/verify/benchmarks" class="rounded-xl border border-zinc-700 hover:bg-zinc-900 px-6 py-3 font-bold transition">🧪 모델 정확도 공개</a>
      <a href="/verify/report" class="rounded-xl border border-emerald-500/40 hover:bg-emerald-500/10 text-emerald-300 px-6 py-3 font-bold transition">💰 사기 제보 ₩5K</a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-6">
    <div class="grid sm:grid-cols-4 gap-3">
      <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-5">
        <p class="text-[10px] font-black text-zinc-400 uppercase tracking-widest">검증 카테고리</p>
        <p class="mt-1 text-3xl font-black text-white tabular-nums">{verifyCategories.length}</p>
      </div>
      <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-5">
        <p class="text-[10px] font-black text-zinc-400 uppercase tracking-widest">폭증 사기</p>
        <p class="mt-1 text-3xl font-black text-rose-300 tabular-nums">{polluted.length}</p>
      </div>
      <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-5">
        <p class="text-[10px] font-black text-zinc-400 uppercase tracking-widest">최소 단가</p>
        <p class="mt-1 text-3xl font-black text-emerald-300 tabular-nums">₩2,900</p>
      </div>
      <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-5">
        <p class="text-[10px] font-black text-zinc-400 uppercase tracking-widest">자체 모델</p>
        <p class="mt-1 text-3xl font-black text-violet-300 tabular-nums">5개</p>
        <p class="text-[10px] text-zinc-500">한국어 native</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-6">
    <h2 class="text-2xl font-black mb-4 text-rose-300">🔥 한국 폭증 사기 (즉시 검증 필요)</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {polluted.map((v) => (
        <a href={`/verify/${v.slug}/`} class="card-lift group block rounded-2xl border-2 border-rose-500/30 hover:border-rose-400 bg-gradient-to-br from-rose-500/10 to-zinc-900/60 p-5 transition">
          <div class="flex items-start justify-between mb-2">
            <span class="text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-300">{v.scamType}</span>
            <span class="text-xs font-black text-emerald-300 tabular-nums">자동 {v.automation}%</span>
          </div>
          <h3 class="font-black text-white group-hover:text-rose-300 transition">{v.title}</h3>
          <p class="mt-2 text-xs text-zinc-400 line-clamp-2 leading-relaxed">{v.tagline}</p>
          <div class="mt-3 flex items-center justify-between">
            <span class="text-xs text-zinc-500">⏱ {v.autoTime}</span>
            <span class="text-sm font-black text-emerald-300 tabular-nums">무료 {v.autoPrice.free}회</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section id="categories" class="mx-auto max-w-5xl px-4 py-10">
    <h2 class="text-3xl font-black mb-6">전체 카테고리별</h2>
    {catOrder.filter((cat) => grouped[cat]?.length > 0).map((cat) => (
      <div class="mb-8">
        <h3 class="text-sm font-black text-zinc-400 uppercase tracking-widest mb-3">{cat}</h3>
        <div class="grid sm:grid-cols-2 gap-3">
          {grouped[cat].map((v) => (
            <a href={`/verify/${v.slug}/`} class="card-lift block rounded-2xl border border-zinc-800 hover:border-rose-500/40 bg-zinc-900/40 p-5 transition">
              <div class="flex items-start justify-between gap-3 mb-2">
                <h4 class="font-black text-white">{v.title}</h4>
                <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full ${v.prevalence === '폭증' ? 'bg-rose-500/20 text-rose-300' : v.prevalence === '높음' ? 'bg-amber-500/20 text-amber-300' : 'bg-zinc-700 text-zinc-300'}`}>{v.prevalence}</span>
              </div>
              <p class="text-xs text-zinc-400 leading-relaxed mt-1">{v.tagline}</p>
              <div class="mt-3 flex items-center justify-between text-[10px]">
                <span class="text-zinc-500">⏱ {v.autoTime} · 자동 {v.automation}%</span>
                <span class="text-emerald-300 tabular-nums font-bold">{v.autoPrice.paid}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10">
    <div class="rounded-3xl border-2 border-rose-500/40 bg-gradient-to-br from-rose-500/15 via-orange-500/10 to-zinc-950 p-10">
      <h2 class="text-3xl font-black">💡 왜 우리</h2>
      <div class="mt-6 grid sm:grid-cols-3 gap-4 text-sm">
        <div class="rounded-2xl bg-zinc-900/60 p-5">
          <p class="text-xs font-black text-rose-300 uppercase mb-2">한국어 native</p>
          <p class="text-zinc-200">Sensity·GPTZero·Fakespot 등 글로벌 솔루션은 모두 영어 강함, 한국어 약함. 한국 사기 패턴은 한국어 데이터로만 잡힘.</p>
        </div>
        <div class="rounded-2xl bg-zinc-900/60 p-5">
          <p class="text-xs font-black text-cyan-300 uppercase mb-2">통합 13개</p>
          <p class="text-zinc-200">이미지·음성·문서·약관·텍스트·리뷰 따로따로 가지 마세요. 1개 사이트에서 전부.</p>
        </div>
        <div class="rounded-2xl bg-zinc-900/60 p-5">
          <p class="text-xs font-black text-emerald-300 uppercase mb-2">일반인 가격</p>
          <p class="text-zinc-200">경쟁사 $1,000/월 B2B만. 우리 ₩2,900/건 또는 월 ₩9,900 무제한.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
