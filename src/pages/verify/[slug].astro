---
import Layout from '../../layouts/Layout.astro';
import { verifyCategories } from '../../data/scam-verify';

export const prerender = true;

export function getStaticPaths() {
  return verifyCategories.map((v) => ({ params: { slug: v.slug }, props: { item: v } }));
}

const { item } = Astro.props;
const others = verifyCategories.filter((v) => v.slug !== item.slug).slice(0, 4);

// Determine input type for the form
const isPersonTheft = item.slug === 'person-theft';
const isText = ['phishing-text', 'romance-scam', 'health-gym-terms', 'insurance-terms', 'telecom-terms', 'subscription-terms', 'fake-review', 'ai-text-detection'].includes(item.slug);
const isImage = ['deepfake-image', 'document-forgery', 'etungi-forgery'].includes(item.slug) || isPersonTheft;
const isAudio = item.slug === 'deepvoice';
const isBizNo = item.slug === 'business-forgery';

// API endpoint
const apiEndpoint = isPersonTheft ? '/api/verify-person-theft'
  : isText ? '/api/verify-text'
  : (['deepfake-image', 'document-forgery', 'etungi-forgery'].includes(item.slug)) ? '/api/verify-image'
  : isAudio ? '/api/verify-voice'
  : isBizNo ? '/api/business-status'
  : '/api/verify-text';

// Model used
const modelUsed = isPersonTheft ? '자체 모델 (ArcFace 얼굴 + DINOv2 인물 + pHash + 재사용 DB)'
  : isAudio ? '자체 한국어 모델 (Phase 2 출시 예정)'
  : isImage ? '자체 이미지 모델 + 시각화'
  : ['ai-text-detection', 'fake-review', 'romance-scam'].includes(item.slug) ? '자체 한국어 모델 + Gemini Flash'
  : 'Gemini 2.0 Flash';
---
<Layout title={`${item.title} — 무료 ${item.autoPrice.free}회 / ${item.autoPrice.paid}`} description={`${item.title}. ${item.tagline}. ${item.autoTime} 안에 자동 분석. 정밀 의뢰 ${item.premiumPrice}.`}>
  <section class="mx-auto max-w-3xl px-4 pt-12 pb-6">
    <a href="/verify/" class="text-sm text-zinc-500 hover:text-rose-300 transition">← 사기 검증 전체</a>
    <div class="mt-4 flex flex-wrap gap-2">
      <span class="rounded-full border border-rose-500/40 bg-rose-500/10 px-3 py-1 text-xs font-bold text-rose-300">{item.scamType}</span>
      <span class={`rounded-full px-3 py-1 text-xs font-bold ${item.prevalence === '폭증' ? 'bg-rose-500/15 text-rose-300' : 'bg-amber-500/15 text-amber-300'}`}>위험도: {item.prevalence}</span>
      <span class="rounded-full bg-zinc-800 text-zinc-300 px-3 py-1 text-xs font-bold">⏱ {item.autoTime}</span>
      <span class="rounded-full bg-cyan-500/15 text-cyan-300 px-3 py-1 text-xs font-bold">자동 {item.automation}%</span>
    </div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight">{item.title}</h1>
    <p class="mt-3 text-lg text-zinc-300">{item.tagline}</p>
    <p class="mt-2 text-xs text-zinc-500">🤖 사용 모델: {modelUsed}</p>
  </section>

  <!-- Pricing -->
  <section class="mx-auto max-w-3xl px-4 py-4">
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border-2 border-emerald-500/40 bg-emerald-500/5 p-6">
        <p class="text-[10px] font-bold text-emerald-300 uppercase tracking-widest">자동 분석</p>
        <p class="mt-2 text-3xl font-black text-emerald-300 tabular-nums">무료 {item.autoPrice.free}회</p>
        <p class="mt-1 text-sm text-zinc-300">이후 {item.autoPrice.paid}</p>
        <a href="#try" class="mt-3 inline-flex text-xs font-black text-emerald-300">지금 시도 →</a>
      </div>
      <div class="rounded-2xl border-2 border-violet-500/40 bg-violet-500/5 p-6">
        <p class="text-[10px] font-bold text-violet-300 uppercase tracking-widest">정밀 의뢰</p>
        <p class="mt-2 text-3xl font-black text-violet-300 tabular-nums">{item.premiumPrice}</p>
        <p class="mt-1 text-sm text-zinc-300">사람 + 다중 AI · 24시간</p>
        <a href="#premium" class="mt-3 inline-flex text-xs font-black text-violet-300">의뢰하기 →</a>
      </div>
    </div>
  </section>

  <!-- Try form -->
  <section id="try" class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-3xl border-2 border-emerald-500/40 bg-gradient-to-br from-emerald-500/15 to-zinc-950 p-6">
      <h2 class="text-2xl font-black mb-2">🤖 자동 분석</h2>
      <div class="mb-4 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-3 py-2 text-[11px] text-emerald-200/90 flex items-start gap-2">
        <span class="flex-shrink-0">🔒</span>
        <span>입력 텍스트·이미지는 <strong>저장하지 않습니다</strong>. 분석 중 메모리에서만 처리되고 응답 직후 폐기됩니다. <a href="/privacy/" class="underline hover:text-emerald-100">방침 →</a></span>
      </div>
      {isText && (
        <textarea id="input-text" rows="6" placeholder="의심되는 텍스트 (SMS·카톡·이메일·약관 등) 붙여넣기" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-3 text-sm text-zinc-200"></textarea>
      )}
      {isImage && (
        <div>
          <label for="img-file" class="block cursor-pointer rounded-xl border-2 border-dashed border-zinc-700 hover:border-emerald-500/60 bg-zinc-900/60 p-6 text-center transition">
            <div id="img-drop-text">
              <p class="text-3xl">🖼️</p>
              <p class="mt-2 text-sm font-bold text-zinc-200">사진 선택 / 촬영</p>
              <p class="mt-1 text-xs text-zinc-500">탭하여 갤러리·카메라에서 선택 (자동 압축, 서버에 저장 안 함)</p>
            </div>
            <img id="img-preview" class="hidden mx-auto max-h-64 rounded-lg" alt="미리보기" />
          </label>
          <input id="img-file" type="file" accept="image/*" class="hidden" />
          <details class="mt-2">
            <summary class="text-xs text-zinc-500 cursor-pointer">또는 이미지 URL 입력</summary>
            <input id="img-url" type="text" placeholder="https://...jpg" class="mt-2 w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-2 text-sm text-zinc-200" />
          </details>
          {isPersonTheft && (
            <div class="mt-3">
              <label class="block text-xs font-bold text-zinc-300 mb-1">이 사진이 "누구"라고 주장하나요? (선택)</label>
              <input id="identity-input" type="text" placeholder="예: 김민수 / David / @프로필ID / 판매자닉네임" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-2 text-sm text-zinc-200" />
              <p class="mt-1 text-[11px] text-zinc-500">같은 얼굴이 <b>다른 이름</b>으로 이미 등록돼 있으면 도용·사칭으로 판단합니다. 신고가 쌓일수록 정확해집니다.</p>
            </div>
          )}
          <textarea id="input-text" class="hidden"></textarea>
        </div>
      )}
      {isAudio && (
        <div class="rounded-lg border border-amber-500/40 bg-amber-500/5 p-5 text-center">
          <p class="text-amber-300 font-bold">🚧 자체 한국어 음성 모델 학습 중</p>
          <p class="mt-2 text-sm text-zinc-300">Phase 2 (2~4주 내 출시). 베타 신청은 정밀 의뢰로.</p>
          <p class="mt-3 text-xs text-zinc-500">현재는 Pindrop·Resemble로 영어 음성만 정확도 95%+. 한국어는 60% 미만이라 출시 보류.</p>
        </div>
      )}
      {isBizNo && (
        <input id="input-text" type="text" placeholder="사업자등록번호 10자리 (예: 1234567890)" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-3 text-sm text-zinc-200 tabular-nums" />
      )}
      {!isAudio && (
        <button id="analyze" type="button" class="mt-3 w-full rounded-lg bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-black py-3 disabled:opacity-50">
          분석 시작 (무료 {item.autoPrice.free}회)
        </button>
      )}
      <p id="status" class="mt-2 text-xs text-zinc-400 text-center"></p>
    </div>
  </section>

  <!-- Result -->
  <section id="result" class="hidden mx-auto max-w-3xl px-4 py-4 space-y-3">
    <div id="result-box" class="rounded-3xl border-2 p-8">
      <p class="text-[10px] font-bold uppercase tracking-widest" id="r-label">위험 점수</p>
      <p id="r-score" class="mt-2 text-6xl font-black tabular-nums">-</p>
      <p id="r-verdict" class="mt-2 text-2xl font-black">-</p>
      <p id="r-summary" class="mt-3 text-sm text-zinc-300"></p>
    </div>
    <!-- 시각화 (자체 이미지 모델일 때만) — 상세는 유료, 블러로 잠금 -->
    <div id="r-visual" class="hidden rounded-2xl border border-violet-500/40 bg-violet-500/5 p-5">
      <div class="flex items-center justify-between mb-3">
        <h4 class="text-xs font-black text-violet-300 uppercase">🔬 상세 분석 (의심 영역·근거)</h4>
        <span id="r-paid-badge" class="hidden text-[10px] font-bold text-emerald-300 bg-emerald-500/15 px-2 py-0.5 rounded-full">✓ 잠금 해제됨</span>
      </div>
      <!-- 블러 래퍼 -->
      <div class="relative">
        <div id="r-visual-inner" class="transition-all duration-300" style="filter: blur(9px); pointer-events: none; user-select: none;">
          <img id="r-annotated" class="w-full rounded-lg border border-zinc-700" alt="의심 영역 표시" />
          <p class="mt-2 text-[10px] text-zinc-500">빨간 박스·히트맵 = 위조/합성 의심 영역 (자체 모델 + 픽셀 포렌식)</p>
          <div id="r-signals" class="mt-4 space-y-2"></div>
        </div>
        <!-- 잠금 오버레이 -->
        <div id="r-lock" class="absolute inset-0 flex flex-col items-center justify-center text-center p-4">
          <div class="text-4xl mb-2">🔒</div>
          <p class="text-sm font-black text-white">상세 분석이 준비됐어요</p>
          <p class="mt-1 text-xs text-zinc-300 max-w-xs">의심 영역 표시 이미지 · 신호별 점수 · 픽셀 근거를<br/>결제하면 선명하게 볼 수 있어요</p>
          <button id="r-unlock" class="mt-4 rounded-xl bg-violet-500 hover:bg-violet-400 text-white font-black px-6 py-2.5 text-sm transition">
            🔓 상세 분석 잠금 해제 · ₩1,900
          </button>
          <p class="mt-2 text-[10px] text-zinc-500">건당 결제 · 부정확하면 100% 환불</p>
        </div>
      </div>
    </div>
    <div class="rounded-2xl border border-rose-500/40 bg-rose-500/5 p-5">
      <h4 class="text-xs font-black text-rose-300 uppercase mb-3">🚨 탐지된 위험 신호</h4>
      <ul id="r-flags" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul>
    </div>
    <div class="rounded-2xl border border-cyan-500/40 bg-cyan-500/5 p-5">
      <h4 class="text-xs font-black text-cyan-300 uppercase mb-3">📌 다음 조치</h4>
      <ul id="r-actions" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul>
    </div>
    <div class="rounded-2xl border border-violet-500/40 bg-violet-500/5 p-5">
      <h4 class="text-xs font-black text-violet-300 uppercase mb-2">정밀 의뢰가 필요한가</h4>
      <p id="r-need-premium" class="text-sm text-zinc-200"></p>
      <a href="#premium" class="mt-3 inline-flex text-xs font-black text-violet-300">정밀 의뢰 →</a>
    </div>
  </section>

  <!-- 보정 vs 위조 구분 (이미지 검증만) -->
  {isImage && (
    <section class="mx-auto max-w-3xl px-4 py-4">
      <div class="rounded-2xl border border-amber-500/40 bg-amber-500/5 p-5">
        <h3 class="text-sm font-black text-amber-300 mb-2">💄 "셀카 보정"이랑 헷갈리지 않나요?</h3>
        <p class="text-xs text-zinc-300 leading-relaxed mb-3">
          스노우·유라이크 같은 <b>미용 보정</b>(피부·눈·턱)과, <b>딥페이크·위조</b>(얼굴 통째 교체·문서 변조)는 전혀 다릅니다.
          올댓AI는 둘을 구분하도록 설계됐습니다.
        </p>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <div class="rounded-lg bg-zinc-900/60 p-3">
            <p class="font-bold text-emerald-300 mb-1">✓ 보정 = 정상 처리</p>
            <p class="text-zinc-400">피부 매끈·눈 확대·턱 깎기·필터는 <b>전역(전체)에 균일</b>하게 적용 → "보정됨"으로 분류, 위조로 보지 않음</p>
          </div>
          <div class="rounded-lg bg-zinc-900/60 p-3">
            <p class="font-bold text-rose-300 mb-1">⚠ 위조 = 탐지 대상</p>
            <p class="text-zinc-400"><b>특정 영역만</b> 다른 출처가 합성됨(얼굴 교체·금액 변조) → 경계·압축·노이즈 불일치를 잡아냄</p>
          </div>
        </div>
        <p class="mt-3 text-[11px] text-zinc-500">
          핵심: 보정은 <b>한 사람·한 카메라가 전체를 균일하게</b> 바꾸지만, 위조는 <b>다른 출처를 일부에 끼워넣어</b> 픽셀 통계가 영역마다 어긋납니다. 그 어긋남을 모델·포렌식이 봅니다.
        </p>
      </div>
    </section>
  )}

  <!-- 다른 방법과 비교 (차별점) -->
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-3xl border border-zinc-800 bg-gradient-to-br from-zinc-900/80 to-zinc-950 p-6">
      <h2 class="text-lg font-black text-white mb-1">🆚 다른 방법으로 하면?</h2>
      <p class="text-xs text-zinc-500 mb-4">같은 걸 {isImage ? '네이버·구글 렌즈나 ' : ''}ChatGPT 단독으로 했을 때와 비교</p>
      <div class="overflow-x-auto">
        <table class="w-full text-xs sm:text-sm">
          <thead class="text-zinc-400 border-b border-zinc-700">
            <tr>
              <th class="text-left py-2 pr-2 font-bold">항목</th>
              {isImage && <th class="text-center py-2 px-1 font-bold">네이버/구글 렌즈</th>}
              <th class="text-center py-2 px-1 font-bold">{isImage ? 'ChatGPT Vision' : 'ChatGPT·생성형AI'}</th>
              <th class="text-center py-2 px-1 font-black text-emerald-300">올댓AI</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-800/60">
            {(isImage ? [
              ['일반인·한국 특화', '약함 (유명인 위주)', '환각·추측', '자체 한국 모델'],
              ['변형(크롭·압축) 견딤', '✗ 못 찾음', '✗', 'pHash+임베딩 ✓'],
              ['도용·재사용 이력', '✗ 없음', '✗ 없음', '누적 DB 그래프 ✓'],
              ['사기 여부 판단', '✗ 유사이미지만', '불확실', '점수+근거 ✓'],
              ['내 사진 보호', '추적·색인됨', '학습에 쓰일 수도', '비저장 ✓'],
            ] : [
              ['한국어 사기 패턴', '—', '일반론·환각', '자체 한국 모델 ✓'],
              ['실시간 판단', '—', '불확실', '점수+근거 ✓'],
              ['최신 수법 반영', '—', '학습 시점 한정', '한국 사례 DB ✓'],
              ['입력 데이터 보호', '—', '학습에 쓰일 수도', '비저장 ✓'],
            ]).map((row) => (
              <tr>
                <td class="py-2.5 pr-2 text-zinc-300 font-medium">{row[0]}</td>
                {isImage && <td class="py-2.5 px-1 text-center text-zinc-500">{row[1]}</td>}
                <td class="py-2.5 px-1 text-center text-zinc-500">{isImage ? row[2] : row[1]}</td>
                <td class="py-2.5 px-1 text-center text-emerald-300 font-bold">{isImage ? row[3] : row[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs text-zinc-400 leading-relaxed">
        💡 {isImage
          ? '렌즈는 "비슷한 이미지 어디 있나"까지만, 생성형AI는 추측만 합니다. 올댓AI는 변형을 견디는 매칭 + 재사용 이력 + 사기 여부 판단까지 한국 도메인에 특화해 드립니다.'
          : '생성형AI는 일반적인 답·환각이 섞입니다. 올댓AI는 한국 사기 패턴에 학습된 자체 모델로 점수와 근거를 제시하고, 입력은 저장하지 않습니다.'}
      </p>
    </div>
  </section>

  <!-- Checkpoints -->
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
      <h2 class="text-xs font-black text-zinc-300 uppercase tracking-widest mb-4">🔍 분석하는 것</h2>
      <ul class="space-y-2">
        {item.checkpoints.map((c) => (
          <li class="flex items-start gap-3 text-sm text-zinc-200">
            <span class="text-emerald-400 flex-shrink-0">✓</span>
            <span>{c}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Red Flags + Real Cases -->
  <section class="mx-auto max-w-3xl px-4 py-4 space-y-3">
    <div class="rounded-2xl border border-rose-500/40 bg-rose-500/5 p-5">
      <h3 class="text-xs font-black text-rose-300 uppercase tracking-widest mb-3">🚨 즉시 의심 신호</h3>
      <ul class="space-y-1 text-sm text-zinc-300 list-disc list-inside">
        {item.redFlags.map((f) => <li>{f}</li>)}
      </ul>
    </div>
    <div class="rounded-2xl border border-amber-500/40 bg-amber-500/5 p-5">
      <h3 class="text-xs font-black text-amber-300 uppercase tracking-widest mb-3">📰 실제 한국 사기 사례</h3>
      <ul class="space-y-1 text-sm text-zinc-300 list-disc list-inside">
        {item.realCases.map((c) => <li>{c}</li>)}
      </ul>
    </div>
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-5">
      <h3 class="text-xs font-black text-zinc-300 uppercase tracking-widest mb-3">🤖 사용 기술</h3>
      <div class="flex flex-wrap gap-2">
        {item.poweredBy.map((p) => (
          <span class="rounded-full bg-zinc-800 text-zinc-200 px-3 py-1 text-xs">{p}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Premium 의뢰 -->
  <section id="premium" class="mx-auto max-w-3xl px-4 py-10">
    <div class="rounded-3xl border-2 border-violet-500/40 bg-gradient-to-br from-violet-500/10 to-zinc-950 p-8">
      <h2 class="text-2xl font-black mb-2">정밀 의뢰 — {item.premiumPrice}</h2>
      <p class="text-sm text-zinc-400 mb-6">자동 분석으로 판단 어려운 케이스. 다중 AI + 사람 검토. 24시간 처리.</p>
      <p class="text-sm text-zinc-300 mb-4">법적 증거 활용 가능한 PDF 보고서. 필요 시 변호사 연결.</p>
      <a href={`/services/jeonse-full-review/`} class="inline-flex rounded-xl bg-violet-500 hover:bg-violet-400 text-white px-6 py-3 font-black transition">의뢰 신청 페이지로 →</a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-8">
    <h3 class="text-sm font-black text-zinc-400 uppercase tracking-widest mb-3">다른 검증</h3>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-2">
      {others.map((o) => (
        <a href={`/verify/${o.slug}/`} class="card-lift block rounded-xl border border-zinc-800 hover:border-rose-500/40 bg-zinc-900/40 p-3 transition">
          <p class="text-xs font-bold text-white truncate">{o.title}</p>
          <p class="mt-1 text-[10px] text-emerald-300">무료 {o.autoPrice.free}회</p>
        </a>
      ))}
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ apiEndpoint, slug: item.slug, isBizNo, isImage }}>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

  // 상세 분석 잠금 해제 (블러 제거)
  function applyUnlock(unlocked) {
    const inner = $('r-visual-inner'), lock = $('r-lock'), badge = $('r-paid-badge');
    if (!inner) return;
    if (unlocked) {
      inner.style.filter = 'none'; inner.style.pointerEvents = 'auto'; inner.style.userSelect = 'auto';
      if (lock) lock.classList.add('hidden');
      if (badge) badge.classList.remove('hidden');
    } else {
      inner.style.filter = 'blur(9px)'; inner.style.pointerEvents = 'none';
      if (lock) lock.classList.remove('hidden');
      if (badge) badge.classList.add('hidden');
    }
  }
  // 잠금 해제 버튼 (결제 — 현재는 게이트, PG 연동 추후)
  document.addEventListener('click', (e) => {
    if (e.target && e.target.id === 'r-unlock') {
      // TODO: 결제(PG) 연동. 지금은 안내.
      if (confirm('상세 분석 잠금 해제 — ₩1,900 (건당)\n\n결제 연동 준비 중입니다. 베타 기간 동안 무료로 열어드릴까요?')) {
        localStorage.setItem('detail_unlocked_' + slug, '1');
        applyUnlock(true);
      }
    }
  });

  // 이미지: 파일 선택 → canvas 리사이즈(최대 1280px) → JPEG base64 (Vercel 4.5MB 제한 회피)
  if (isImage) {
    const fileEl = $('img-file');
    if (fileEl) {
      fileEl.addEventListener('change', (e) => {
        const f = e.target.files && e.target.files[0];
        if (!f) return;
        const reader = new FileReader();
        reader.onload = (ev) => {
          const img = new Image();
          img.onload = () => {
            const max = 1280;
            let { width: w, height: h } = img;
            if (w > max || h > max) {
              const r = Math.min(max / w, max / h);
              w = Math.round(w * r); h = Math.round(h * r);
            }
            const cv = document.createElement('canvas');
            cv.width = w; cv.height = h;
            cv.getContext('2d').drawImage(img, 0, 0, w, h);
            const b64 = cv.toDataURL('image/jpeg', 0.85);
            $('input-text').value = b64;
            const pv = $('img-preview');
            pv.src = b64; pv.classList.remove('hidden');
            $('img-drop-text').classList.add('hidden');
          };
          img.src = ev.target.result;
        };
        reader.readAsDataURL(f);
      });
    }
    const urlEl = $('img-url');
    if (urlEl) urlEl.addEventListener('input', () => { $('input-text').value = urlEl.value.trim(); });
  }

  const btn = $('analyze');
  if (btn) {
    btn.addEventListener('click', async () => {
      const inputEl = $('input-text');
      if (!inputEl) return;
      const text = inputEl.value.trim();
      const minLen = isImage ? 1 : 5;
      if (text.length < minLen) {
        $('status').textContent = isImage ? '⚠ 사진을 선택하세요' : '⚠ 입력 필요';
        $('status').className = 'mt-2 text-xs text-rose-300 text-center';
        return;
      }

      // Free count check (localStorage)
      const usedKey = 'verify_used_' + slug;
      const usedCount = parseInt(localStorage.getItem(usedKey) || '0', 10);
      // Free limit check (use category data via hidden field would be cleaner, but skip for now)

      btn.disabled = true;
      $('status').textContent = '🤖 분석 중...';
      $('status').className = 'mt-2 text-xs text-cyan-300 text-center animate-pulse';

      // 액세스 코드 (베타 — 지정인만). localStorage 보관.
      let accessCode = localStorage.getItem('access_code') || '';
      if (!accessCode) {
        accessCode = (prompt('베타 액세스 코드를 입력하세요 (지정된 사용자 전용)') || '').trim();
        if (accessCode) localStorage.setItem('access_code', accessCode);
      }

      const identityEl = $('identity-input');
      const identity = identityEl ? identityEl.value.trim() : '';
      const body = isBizNo
        ? { bizNo: text, accessCode }
        : (slug === 'person-theft')
        ? { input: text, slug, identity, accessCode }
        : isImage
        ? { type: 'image', input: text, slug, accessCode }
        : { type: 'text', input: text, slug, accessCode };

      try {
        const res = await fetch(apiEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Access-Code': accessCode },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (!data.ok) {
          // 액세스 코드 문제면 저장된 코드 삭제(재입력 유도)
          if (data.reason === 'invalid_access_code' || data.reason === 'access_code_required') {
            localStorage.removeItem('access_code');
          }
          $('status').textContent = '❌ ' + (data.error || '분석 실패');
          $('status').className = 'mt-2 text-xs text-rose-300 text-center';
          btn.disabled = false;
          return;
        }

        localStorage.setItem(usedKey, String(usedCount + 1));

        $('result').classList.remove('hidden');
        $('status').textContent = '✓ 완료 (사용 ' + (usedCount + 1) + '회)';
        $('status').className = 'mt-2 text-xs text-emerald-300 text-center';

        const score = data.riskScore || data.scamScore || 0;
        const verdict = data.verdict || data.status || '-';
        let color = 'text-emerald-300', bg = 'border-emerald-500/40 bg-emerald-500/5';
        if (score >= 75) { color = 'text-rose-300'; bg = 'border-rose-500/40 bg-rose-500/10'; }
        else if (score >= 50) { color = 'text-orange-300'; bg = 'border-orange-500/40 bg-orange-500/5'; }
        else if (score >= 25) { color = 'text-amber-300'; bg = 'border-amber-500/40 bg-amber-500/5'; }

        $('result-box').className = 'rounded-3xl border-2 p-8 ' + bg;
        $('r-label').className = 'text-[10px] font-bold uppercase tracking-widest ' + color;
        $('r-score').className = 'mt-2 text-6xl font-black tabular-nums ' + color;
        $('r-verdict').className = 'mt-2 text-2xl font-black ' + color;
        $('r-score').textContent = isBizNo ? '-' : (score + ' / 100');
        $('r-verdict').textContent = verdict;
        $('r-summary').textContent = data.summary || '';

        // 시각화 (자체 이미지 모델 결과)
        const vis = $('r-visual');
        if (data.annotatedImage && vis) {
          $('r-annotated').src = data.annotatedImage;
          const sigs = (data.signals || []).filter((s) => s.score > 0).slice(0, 6);
          $('r-signals').innerHTML = sigs.map((s) => {
            const w = Math.min(100, s.score);
            const col = s.score >= 70 ? 'bg-rose-500' : s.score >= 40 ? 'bg-amber-500' : 'bg-emerald-500';
            return '<div><div class="flex justify-between text-[11px] text-zinc-300 mb-0.5"><span>' + esc(s.signal) + '</span><span class="font-bold">' + s.score + '</span></div>'
              + '<div class="h-2 rounded-full bg-zinc-800 overflow-hidden"><div class="h-full ' + col + '" style="width:' + w + '%"></div></div></div>';
          }).join('');
          // 잠금 상태 적용 (이미 해제한 적 있으면 선명하게)
          const unlocked = localStorage.getItem('detail_unlocked_' + slug) === '1';
          applyUnlock(unlocked);
          vis.classList.remove('hidden');
        } else if (vis) {
          vis.classList.add('hidden');
        }

        // 인물 도용: 재사용 신원 + AI 확률
        let flagsHtml = (data.redFlags || data.warnings || []).map((f) => '<li>' + esc(f) + '</li>').join('');
        if (slug === 'person-theft') {
          const reused = data.reusedIdentities || [];
          if (reused.length) {
            flagsHtml = '<li class="text-rose-300 font-bold">⚠ 같은 ' +
              (reused[0].via === 'face' ? '얼굴' : reused[0].via === 'phash' ? '사진' : '인물') +
              '이 다른 신원으로 발견: ' + reused.map((r) => esc(r.identity || '미상')).join(', ') + '</li>' + flagsHtml;
          }
          if (data.hasFace === false) {
            flagsHtml += '<li class="text-zinc-400">얼굴 미검출 — 전신·배경 기준으로 비교했습니다</li>';
          }
        }
        $('r-flags').innerHTML = flagsHtml || '<li class="list-none text-zinc-500">탐지된 신호 없음</li>';
        $('r-actions').innerHTML = (data.nextSteps || data.actionItems || data.recommendations || []).map((a) => '<li>' + esc(a) + '</li>').join('') || '<li class="list-none text-zinc-500">없음</li>';
        $('r-need-premium').textContent = score >= 50 ? '⚠ 위험도 높음 — 정밀 의뢰 권장 (변호사 의견 포함)' : '✓ 자동 분석으로 충분';

        if (window.va) { try { window.va('event', { name: 'verify_run', data: { slug, score } }); } catch (_) {} }
      } catch (e) {
        $('status').textContent = '❌ ' + e.message;
        $('status').className = 'mt-2 text-xs text-rose-300 text-center';
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
