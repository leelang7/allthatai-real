---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="검색 — AllThatAI Real"
  description="AllThatAI Real의 모든 가이드/이슈에서 검색"
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-24">
    <div class="inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-500/5 px-3 py-1 text-xs text-cyan-300">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
      사이트 검색
    </div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black">전체 검색</h1>
    <p class="mt-3 text-zinc-400">제목 / 본문 / 태그를 한 번에 검색합니다.</p>

    <div id="search" class="mt-10"></div>
  </section>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI === 'undefined') {
        document.getElementById('search').innerHTML =
          '<div class="rounded-xl border border-amber-500/30 bg-amber-500/5 p-6 text-amber-200 text-sm">검색 인덱스는 빌드 시점에만 생성됩니다. 개발 모드에서는 비어 있고, 배포본에서 정상 동작합니다.</div>';
        return;
      }
      new PagefindUI({
        element: '#search',
        showImages: false,
        showSubResults: true,
        translations: {
          placeholder: '검색어를 입력하세요 (예: 청약, 클로드 할인)',
          clear_search: '지우기',
          load_more: '더 보기',
          search_label: '검색',
          filters_label: '필터',
          zero_results: '결과 없음 — [SEARCH_TERM]',
          many_results: '[COUNT]건 — [SEARCH_TERM]',
          one_result: '1건 — [SEARCH_TERM]',
          alt_search: '결과 없음 — [SEARCH_TERM]. 대신 [DIFFERENT_TERM]:',
          search_suggestion: '결과 없음 — [SEARCH_TERM]. 시도: [DIFFERENT_TERM]',
          searching: '검색 중 — [SEARCH_TERM]',
        },
      });
    });
  </script>

  <style is:global>
    :root {
      --pagefind-ui-scale: 1;
      --pagefind-ui-primary: #22d3ee;
      --pagefind-ui-text: #fafafa;
      --pagefind-ui-background: #0a0a0a;
      --pagefind-ui-border: #27272a;
      --pagefind-ui-tag: #18181b;
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 12px;
      --pagefind-ui-image-border-radius: 8px;
      --pagefind-ui-image-box-ratio: 3 / 2;
      --pagefind-ui-font: var(--font-sans);
    }
    .pagefind-ui__result-link { color: #22d3ee !important; font-weight: 700; }
    .pagefind-ui__result-link:hover { color: #67e8f9 !important; }
    .pagefind-ui__result-excerpt { color: #a1a1aa !important; line-height: 1.6 !important; }
    mark { background: rgba(34, 211, 238, 0.25) !important; color: #fafafa !important; }
  </style>
</Layout>
