---
/**
 * /jeonse — 전세사기 방지 종합 허브.
 *
 * 한국 매우 큰 사회 문제 + 검색량 폭발. 2022-2025 전세사기 피해 ₩수천억.
 * 정부 특별법까지 발의된 상황. 도구 1개 ₩9,900에 팔리는 시장.
 *
 * 본 허브:
 *   - 위험 체크리스트 (즉시 확인)
 *   - 위험 점수 계산기 (보증금/시세/근저당 입력 → 점수)
 *   - 등기부등본 자동 분석기 (텍스트 복붙 → 위험요소 추출)
 *   - 실거래가 비교 (국토부 OpenAPI)
 *   - 사기 사례 자동 추적 (Google News RSS)
 */
import Layout from '../../layouts/Layout.astro';

const checkpoints = [
  {
    risk: 'high',
    title: '시세 대비 보증금 80% 초과',
    desc: '시세 5억 집에 4억 이상 보증금 → 경매 시 보호 못 받음. 시세 80% 이하만 안전.',
    action: '국토부 실거래가 + KB시세 둘 다 확인',
  },
  {
    risk: 'high',
    title: '등기부등본 근저당이 시세 60% 초과',
    desc: '집주인이 은행 빚 많이 있으면 경매 시 임차인 보증금이 후순위로 밀림.',
    action: '계약 전 등기부등본 떼서 근저당설정액 확인 (인터넷등기소 ₩700)',
  },
  {
    risk: 'high',
    title: '신탁등기 / 압류 / 가압류',
    desc: '신탁회사 명의이거나 가압류 있으면 임대인 권한 없음. 사기 1순위 신호.',
    action: '등기부등본 갑구·을구 모두 확인',
  },
  {
    risk: 'high',
    title: '계약일 vs 잔금일 차이로 등기 변동',
    desc: '계약-잔금 사이 임대인이 추가 대출 받거나 매도 → 사기 흔한 패턴',
    action: '잔금 당일 등기부등본 한 번 더 발급',
  },
  {
    risk: 'high',
    title: '깡통전세 (보증금 = 매매가)',
    desc: '집주인이 매매가만큼 보증금 받고 잠적 → 경매 시 다 못 받음',
    action: '시세 대비 70% 이하 보증금만 안전',
  },
  {
    risk: 'mid',
    title: '임대인 본인 vs 대리인 계약',
    desc: '대리인이면 인감증명서 + 위임장 원본 확인. 신분증 진위 의심',
    action: '정부24에서 인감증명 진위 확인',
  },
  {
    risk: 'mid',
    title: '공인중개사 등록증 미확인',
    desc: '미등록 중개사·자칭 중개사. 등록번호 한국공인중개사협회에서 검증',
    action: '구·시청 부동산정보과 또는 협회 사이트 확인',
  },
  {
    risk: 'mid',
    title: '확정일자 / 전입신고 안 함',
    desc: '계약 후 즉시 동주민센터 → 확정일자 + 전입신고. 안 하면 보증금 보호 못 받음',
    action: '잔금 + 입주 당일 동주민센터 방문 (5분)',
  },
  {
    risk: 'mid',
    title: '전세보증보험 미가입',
    desc: 'HUG/SGI 전세금반환보증보험. 보증금 80% 이하면 가입 가능, 1% 수수료로 안전',
    action: 'HUG 안심전세 또는 SGI 보증 가입',
  },
  {
    risk: 'low',
    title: '잔금 직전 임대인 변경',
    desc: '계약 후 집주인이 매도해서 새 임대인. 새 임대인과 재계약 또는 계약 해지 권리',
    action: '임대인 변경 즉시 통보받아야',
  },
  {
    risk: 'low',
    title: '동일 주소 다중 전세 계약',
    desc: '한 집에 여러 명한테 동시 전세 → 1.5세대 미만 다가구 가능. 등기 확인',
    action: '등기부등본의 임차인 표시 확인',
  },
  {
    risk: 'low',
    title: '소유주와 임대인 다름',
    desc: '소유주 ≠ 임대인이면 위임 관계 명확히. 가족 명의·법인 명의 주의',
    action: '소유주 동의서 필수',
  },
  {
    risk: 'low',
    title: '월세 → 전세 전환 강요',
    desc: '집주인이 갑자기 월세 → 전세 권유 + 큰 보증금 → 사기 가능성',
    action: '의심되면 계약 보류',
  },
];

const riskColor = {
  high: { bg: 'bg-rose-500/10', border: 'border-rose-500/40', text: 'text-rose-300', label: '🔴 고위험' },
  mid: { bg: 'bg-amber-500/10', border: 'border-amber-500/40', text: 'text-amber-300', label: '🟡 중위험' },
  low: { bg: 'bg-cyan-500/10', border: 'border-cyan-500/40', text: 'text-cyan-300', label: '🔵 저위험' },
};

const tools = [
  { href: '/jeonse/risk-calc/', title: '위험 점수 계산기', desc: '보증금·시세·근저당 입력 → 0–100 위험점수', emoji: '📊' },
  { href: '/jeonse/etungi-analyzer/', title: '등기부등본 자동 분석', desc: '등본 텍스트 복붙 → 위험 요소 자동 추출', emoji: '🔍' },
  { href: '/jeonse/price-compare/', title: '실거래가 비교', desc: '국토부 공식 데이터 — 동일 단지 평균 시세', emoji: '💰' },
  { href: '/jeonse/contract-checklist/', title: '계약 체크리스트', desc: '계약 현장 들고 가는 48개 항목 (인쇄 가능)', emoji: '📋' },
  { href: '/trackers/jeonse-fraud/', title: '사기 사례 자동 추적', desc: '매일 갱신 — 새 사기 수법·판결·정부 발표', emoji: '⚠️' },
];

const SITE = 'https://allthatai-real.vercel.app';
const url = `${SITE}/jeonse/`;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'AllThatAI Real', item: SITE },
    { '@type': 'ListItem', position: 2, name: '전세사기 방지', item: url },
  ],
};
---
<Layout
  title="전세사기 방지 — 13개 위험 신호 + 등기부등본 자동 분석 + 실거래가 비교"
  description="계약 전 5분 안에 위험 진단. 13개 사기 신호 체크리스트 + 등기부등본 자동 분석 + 국토부 실거래가 비교. 무료."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>

  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-zinc-900">
    <div class="absolute inset-0 bg-mesh opacity-60"></div>
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-rose-500/15 rounded-full blur-3xl"></div>
    <div class="relative mx-auto max-w-5xl px-4 pt-16 pb-12">
      <div class="inline-flex items-center gap-2 rounded-full border border-rose-500/40 bg-rose-500/10 px-3 py-1 text-xs text-rose-300">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-rose-400 animate-pulse"></span>
        2022–2025 피해 ₩수천억
      </div>
      <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.1] tracking-tight">
        전세사기<br/>
        <span class="text-rose-400">계약 전</span> 5분 진단
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-zinc-400 leading-relaxed max-w-3xl">
        13개 사기 신호 체크리스트 + 등기부등본 자동 분석기 + 국토부 실거래가 비교.
        본인이 계약 전 5분에 99% 사기 거를 수 있음.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/jeonse/risk-calc/" class="rounded-xl bg-rose-500 hover:bg-rose-400 text-white px-6 py-3.5 font-bold transition">
          내 계약 위험 점수 계산 →
        </a>
        <a href="#checklist" class="rounded-xl border border-zinc-700 bg-zinc-900/40 backdrop-blur px-6 py-3.5 font-semibold hover:border-rose-500/50 transition">
          체크리스트 보기
        </a>
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="text-2xl font-black mb-6">4개 무료 도구</h2>
    <div class="grid sm:grid-cols-2 gap-4">
      {tools.map((t) => (
        <a href={t.href} class="card-lift block rounded-2xl border border-zinc-800 hover:border-rose-500/40 bg-zinc-900/40 p-6 transition">
          <span class="text-3xl">{t.emoji}</span>
          <h3 class="mt-3 font-black text-lg">{t.title}</h3>
          <p class="mt-2 text-sm text-zinc-400 leading-relaxed">{t.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- CHECKLIST -->
  <section id="checklist" class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="text-2xl font-black mb-2">13개 위험 신호 체크리스트</h2>
    <p class="text-sm text-zinc-400 mb-6">하나라도 해당되면 즉시 보류 또는 추가 확인 필요.</p>
    <div class="space-y-3">
      {checkpoints.map((c, i) => {
        const r = riskColor[c.risk as keyof typeof riskColor];
        return (
          <div class={`rounded-2xl border ${r.border} ${r.bg} p-5`}>
            <div class="flex items-start gap-3">
              <span class="text-[10px] font-bold w-12 shrink-0 mt-1">#{String(i + 1).padStart(2, '0')}</span>
              <div class="flex-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class={`text-[10px] font-bold ${r.text}`}>{r.label}</span>
                  <h3 class="font-black text-white">{c.title}</h3>
                </div>
                <p class="mt-2 text-sm text-zinc-300 leading-relaxed">{c.desc}</p>
                <p class="mt-2 text-xs text-zinc-500"><strong>→ 확인 방법:</strong> {c.action}</p>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- LEGAL / GOV LINKS -->
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="text-2xl font-black mb-6">공식 자료 / 신고 경로</h2>
    <div class="grid sm:grid-cols-2 gap-3">
      <a href="https://www.iros.go.kr" target="_blank" rel="noopener" class="card-lift block rounded-xl border border-zinc-800 hover:border-cyan-500/40 bg-zinc-900/40 p-5 transition">
        <p class="font-black">대한민국 법원 인터넷등기소</p>
        <p class="mt-1 text-xs text-zinc-400">등기부등본 발급 (₩700) — 사기 방지 1순위</p>
      </a>
      <a href="https://rt.molit.go.kr" target="_blank" rel="noopener" class="card-lift block rounded-xl border border-zinc-800 hover:border-cyan-500/40 bg-zinc-900/40 p-5 transition">
        <p class="font-black">국토부 실거래가 공개시스템</p>
        <p class="mt-1 text-xs text-zinc-400">공식 실거래가 — 보증금 vs 시세 비교</p>
      </a>
      <a href="https://www.khug.or.kr" target="_blank" rel="noopener" class="card-lift block rounded-xl border border-zinc-800 hover:border-cyan-500/40 bg-zinc-900/40 p-5 transition">
        <p class="font-black">HUG 안심전세</p>
        <p class="mt-1 text-xs text-zinc-400">전세보증금 반환보증 (수수료 1%)</p>
      </a>
      <a href="https://www.sgic.co.kr" target="_blank" rel="noopener" class="card-lift block rounded-xl border border-zinc-800 hover:border-cyan-500/40 bg-zinc-900/40 p-5 transition">
        <p class="font-black">SGI 서울보증</p>
        <p class="mt-1 text-xs text-zinc-400">전세금 반환보증 + 대출 보증</p>
      </a>
      <a href="https://www.molit.go.kr" target="_blank" rel="noopener" class="card-lift block rounded-xl border border-zinc-800 hover:border-cyan-500/40 bg-zinc-900/40 p-5 transition">
        <p class="font-black">국토교통부 전세사기 피해자 지원</p>
        <p class="mt-1 text-xs text-zinc-400">특별법 신청 자격·절차·문의</p>
      </a>
      <a href="https://kab.co.kr" target="_blank" rel="noopener" class="card-lift block rounded-xl border border-zinc-800 hover:border-cyan-500/40 bg-zinc-900/40 p-5 transition">
        <p class="font-black">한국감정원 부동산 정보</p>
        <p class="mt-1 text-xs text-zinc-400">공시지가 + 시세 추정</p>
      </a>
    </div>
  </section>

  <!-- DISCLAIMER -->
  <section class="mx-auto max-w-5xl px-4 py-6">
    <div class="rounded-2xl border border-amber-500/30 bg-amber-500/5 p-6 text-sm text-zinc-300">
      <p class="font-bold text-amber-300 mb-2">⚠ 본 도구는 참고용</p>
      <p class="text-xs leading-relaxed">
        본 사이트는 공개 정보 기반 위험도 진단을 제공합니다. <strong>실제 계약 결정은 본인 책임</strong>이며,
        분쟁 발생 시 공인된 법무사·변호사·부동산 전문가 상담 권장. 등기부등본·실거래가·보증보험 가입 등은
        공식 기관에서 직접 확인하세요.
      </p>
    </div>
  </section>
</Layout>
