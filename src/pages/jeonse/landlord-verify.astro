---
/**
 * /jeonse/landlord-verify — 임대인 사업자등록 진위 + 체납 확인 가이드.
 *
 * 외부 데이터:
 *   - 국세청 사업자등록상태 조회 API (무료, 공공데이터포털)
 *   - 정부24 인감증명서 진위 확인 (수동)
 *   - 사업자등록번호 체크섬 검증 (정규식, 즉시)
 */
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="임대인 검증 — 사업자등록번호 진위 / 체납 / 인감증명 확인 가이드"
  description="임대인 사업자등록번호 검증 + 체납 압류 확인 + 인감증명 진위. 전세사기 80%가 임대인 검증 부족."
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <a href="/jeonse/" class="text-sm text-zinc-500 hover:text-zinc-300 transition">← 전세사기 방지</a>
    <h1 class="mt-4 text-3xl sm:text-4xl font-black leading-tight">
      임대인 <span class="text-gradient">검증</span> 가이드
    </h1>
    <p class="mt-4 text-base text-zinc-400 leading-relaxed">
      사업자등록번호 자동 검증 + 정부24 공식 진위 확인 경로.
    </p>
  </section>

  <!-- Business number validator -->
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
      <h2 class="font-black mb-3">1. 사업자등록번호 형식 + 체크섬 검증 (즉시)</h2>
      <p class="text-xs text-zinc-400 mb-4">국세청 공식 알고리즘으로 체크 디지트 검증. 가짜 번호 즉시 탐지.</p>
      <label class="block">
        <span class="block text-xs font-bold text-zinc-300 mb-1.5">사업자등록번호 (10자리)</span>
        <input id="bizno" type="text" placeholder="123-45-67890 또는 1234567890" maxlength="13" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-rose-500 outline-none px-4 py-3 text-xl font-mono text-white tabular-nums" />
      </label>
      <div id="bizno-result" class="mt-4 hidden"></div>
    </div>
  </section>

  <!-- Official check links -->
  <section class="mx-auto max-w-3xl px-4 py-6">
    <h2 class="text-xl font-black mb-3">2. 공식 진위 확인 (5분)</h2>
    <div class="grid sm:grid-cols-2 gap-3">
      <a href="https://www.hometax.go.kr/websquare/websquare.html?w2xPath=/ui/ab/a/a/UTEABAAA13.xml" target="_blank" rel="noopener" class="card-lift block rounded-2xl border border-zinc-800 hover:border-rose-500/40 bg-zinc-900/40 p-5 transition">
        <p class="font-black">📋 홈택스 — 사업자상태 조회</p>
        <p class="mt-2 text-xs text-zinc-400">사업자번호 → 휴/폐업 여부 확인. 폐업했으면 임대인 신용 의심.</p>
      </a>
      <a href="https://www.gov.kr/portal/main" target="_blank" rel="noopener" class="card-lift block rounded-2xl border border-zinc-800 hover:border-rose-500/40 bg-zinc-900/40 p-5 transition">
        <p class="font-black">🏛 정부24 — 인감증명 진위확인</p>
        <p class="mt-2 text-xs text-zinc-400">대리인 계약 시 인감증명 발급일자 + 사용용도 확인.</p>
      </a>
      <a href="https://www.iros.go.kr" target="_blank" rel="noopener" class="card-lift block rounded-2xl border border-zinc-800 hover:border-rose-500/40 bg-zinc-900/40 p-5 transition">
        <p class="font-black">📜 인터넷등기소 — 갑구 소유주</p>
        <p class="mt-2 text-xs text-zinc-400">실 소유주 = 임대인 본인 일치 여부 확인.</p>
      </a>
      <a href="https://nadt.go.kr" target="_blank" rel="noopener" class="card-lift block rounded-2xl border border-zinc-800 hover:border-rose-500/40 bg-zinc-900/40 p-5 transition">
        <p class="font-black">⚖ 대법원 나의사건검색</p>
        <p class="mt-2 text-xs text-zinc-400">임대인이 사기·횡령 등으로 형사재판 진행 중인지 확인.</p>
      </a>
    </div>
  </section>

  <!-- Red flags -->
  <section class="mx-auto max-w-3xl px-4 py-6">
    <h2 class="text-xl font-black mb-3">3. 임대인 사기 신호 (즉시 보류)</h2>
    <div class="space-y-2">
      {[
        { text: '소유주(등기) ≠ 임대인(계약자)', detail: '대리 위임이라면 인감증명+위임장 원본 필수' },
        { text: '계약금/잔금을 본인 이름 아닌 다른 계좌로 요청', detail: '제3자 송금 = 사기 의심 100%' },
        { text: '직접 보지 않고 계약 진행 강요', detail: '매물 실물 확인 + 신분증 대조 필수' },
        { text: '시세보다 30% 이상 저렴한 보증금 제안', detail: '깡통 또는 다중 계약 의심' },
        { text: '확정일자/전입신고를 미루라고 함', detail: '특별한 이유 없는 한 즉시 OK해야 함' },
        { text: '집주인이 자주 바뀌었다 (등기 갑구 다수)', detail: '명의자 바꿔치기 사기 가능성' },
        { text: '국세 체납 사실 숨김', detail: '체납 시 압류 → 보증금 후순위' },
      ].map((flag, i) => (
        <div class="rounded-xl border border-rose-500/30 bg-rose-500/5 p-4">
          <p class="font-bold text-sm text-rose-300">⚠ {flag.text}</p>
          <p class="mt-1 text-xs text-zinc-400">→ {flag.detail}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script is:inline>
  function validateBizNo(num) {
    const digits = num.replace(/[-\s]/g, '').split('').map(Number);
    if (digits.length !== 10 || digits.some(isNaN)) return { ok: false, reason: '10자리 숫자가 아님' };
    const k = [1, 3, 7, 1, 3, 7, 1, 3, 5];
    let sum = digits.slice(0, 9).reduce((s, d, i) => s + d * k[i], 0);
    sum += Math.floor((digits[8] * 5) / 10);
    const checkDigit = (10 - (sum % 10)) % 10;
    return checkDigit === digits[9]
      ? { ok: true, reason: '체크섬 일치 — 형식상 유효' }
      : { ok: false, reason: `체크 디지트 불일치 — 예상 ${checkDigit}, 실제 ${digits[9]}` };
  }

  const $in = document.getElementById('bizno');
  const $res = document.getElementById('bizno-result');

  async function callApi(bizNo) {
    try {
      const res = await fetch('/api/business-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bizNo }),
      });
      return await res.json();
    } catch (e) {
      return { ok: false, error: 'API 호출 실패' };
    }
  }

  let timeoutId = null;
  $in.addEventListener('input', () => {
    const v = $in.value.trim();
    clearTimeout(timeoutId);
    if (v.length < 10) {
      $res.classList.add('hidden');
      return;
    }
    const r = validateBizNo(v);
    $res.classList.remove('hidden');

    if (!r.ok) {
      $res.innerHTML = `
        <div class="rounded-xl border border-rose-500/40 bg-rose-500/10 p-4">
          <p class="font-bold text-rose-300">✗ ${r.reason}</p>
          <p class="mt-2 text-xs text-zinc-300">⚠ 가짜 사업자등록번호일 가능성. 임대인에게 다시 확인 필요.</p>
        </div>`;
      return;
    }

    // 형식 OK → 실제 휴/폐업 자동 조회 (debounce)
    $res.innerHTML = `
      <div class="rounded-xl border border-cyan-500/40 bg-cyan-500/10 p-4">
        <p class="font-bold text-cyan-300">✓ 형식 통과 — 국세청 실시간 조회 중…</p>
      </div>`;

    timeoutId = setTimeout(async () => {
      const api = await callApi(v);
      if (!api.ok) {
        if (api.error && api.error.includes('등록되지 않은')) {
          $res.innerHTML = `
            <div class="rounded-xl border border-rose-500/40 bg-rose-500/10 p-4">
              <p class="font-bold text-rose-300">⚠ 미등록 사업자</p>
              <p class="mt-2 text-xs text-zinc-300">국세청 DB에 등록되지 않은 번호. 임대인 사기 가능성 높음.</p>
            </div>`;
        } else {
          $res.innerHTML = `
            <div class="rounded-xl border border-emerald-500/40 bg-emerald-500/10 p-4">
              <p class="font-bold text-emerald-300">✓ ${r.reason}</p>
              <p class="mt-2 text-xs text-amber-300">⚠ 실시간 조회 실패: ${api.error}</p>
              <p class="mt-2 text-xs text-zinc-300">홈택스에서 수동 확인:</p>
              <a href="https://teht.hometax.go.kr/websquare/websquare.html?w2xPath=/ui/pp/index_pp.xml&tmIdx=124&tmAbrNm=%EC%82%AC%EC%97%85%EC%9E%90%EC%83%81%ED%83%9C%EC%A1%B0%ED%9A%8C" target="_blank" rel="noopener" class="mt-2 inline-block text-xs text-cyan-300 hover:text-cyan-200 underline">홈택스 사업자상태 조회 →</a>
            </div>`;
        }
        return;
      }

      // 실제 조회 성공
      let bgColor, borderColor, textColor, icon;
      if (api.statusCode === '01') {
        bgColor = 'bg-emerald-500/10'; borderColor = 'border-emerald-500/40'; textColor = 'text-emerald-300'; icon = '✓';
      } else if (api.statusCode === '02') {
        bgColor = 'bg-amber-500/10'; borderColor = 'border-amber-500/40'; textColor = 'text-amber-300'; icon = '⚠';
      } else {
        bgColor = 'bg-rose-500/10'; borderColor = 'border-rose-500/40'; textColor = 'text-rose-300'; icon = '✗';
      }

      $res.innerHTML = `
        <div class="rounded-xl border ${borderColor} ${bgColor} p-4">
          <p class="font-bold ${textColor}">${icon} ${api.status}</p>
          <div class="mt-2 space-y-1 text-xs text-zinc-300">
            <p><strong>사업자번호:</strong> ${api.bizNo}</p>
            <p><strong>과세 유형:</strong> ${api.taxType || '?'}</p>
            ${api.endDate ? `<p><strong>폐업일:</strong> ${api.endDate}</p>` : ''}
          </div>
          ${api.statusCode === '02' ? '<p class="mt-3 text-xs text-amber-300">⚠ 휴업 중인 사업자. 계약 보류 또는 휴업 사유 확인 필수.</p>' : ''}
          ${api.statusCode === '03' ? '<p class="mt-3 text-xs text-rose-300">🚨 폐업한 사업자. 임대 권한 의심. 절대 계약 금지.</p>' : ''}
        </div>`;

      if (window.va) { try { window.va('event', { name: 'landlord_api_check', data: { status: api.status } }); } catch (_) {} }
      if (window.gtag) { try { window.gtag('event', 'landlord_api_check', { status: api.status, event_category: 'tools' }); } catch (_) {} }
    }, 500);
  });
</script>
