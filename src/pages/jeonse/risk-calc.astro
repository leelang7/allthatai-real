---
/**
 * /jeonse/risk-calc — 전세 위험 점수 계산기.
 *
 * 입력: 보증금 / 시세 / 근저당설정액 / 압류 유무 / 신탁 유무 / 임대인 유형 등
 * 출력: 0-100 위험 점수 + 색상 + 권장 조치 + 신고 경로
 */
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="전세 위험 점수 계산기 — 보증금·시세·근저당 입력 → 0–100점"
  description="전세 계약 전 위험 점수 자가 진단. 보증금·KB시세·근저당·압류 등 입력 → 위험도 + 권장 조치 즉시 표시."
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <a href="/jeonse/" class="text-sm text-zinc-500 hover:text-zinc-300 transition">← 전세사기 방지</a>
    <div class="mt-4 inline-flex items-center gap-2 rounded-full border border-rose-500/30 bg-rose-500/5 px-3 py-1 text-xs text-rose-300">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-rose-400"></span>
      위험 점수 계산
    </div>
    <h1 class="mt-3 text-3xl sm:text-4xl font-black leading-tight">
      <span class="text-gradient">위험 점수</span> 0–100 자가 진단
    </h1>
    <p class="mt-4 text-base text-zinc-400 leading-relaxed">
      계약 전 1분. 등기부등본 + KB시세만 있으면 본인이 위험도 계산.
    </p>
  </section>

  <!-- FORM -->
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-5">
      <div class="grid sm:grid-cols-2 gap-4">
        <label class="block">
          <span class="block text-xs font-bold text-zinc-300 mb-1.5">전세 보증금 (₩)</span>
          <input id="deposit" type="number" value="300000000" step="10000000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-rose-500 outline-none px-4 py-3 text-xl font-black text-white tabular-nums" />
        </label>
        <label class="block">
          <span class="block text-xs font-bold text-zinc-300 mb-1.5">시세 — KB / 국토부 (₩)</span>
          <input id="market" type="number" value="400000000" step="10000000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-rose-500 outline-none px-4 py-3 text-xl font-black text-white tabular-nums" />
        </label>
        <label class="block sm:col-span-2">
          <span class="block text-xs font-bold text-zinc-300 mb-1.5">등기부등본 근저당설정액 합계 (₩) — 을구</span>
          <input id="mortgage" type="number" value="100000000" step="10000000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-rose-500 outline-none px-4 py-3 text-lg text-white tabular-nums" />
          <span class="block text-[10px] text-zinc-500 mt-1">을구 "근저당설정"의 채권최고액 합산</span>
        </label>
      </div>

      <div class="space-y-2">
        <p class="text-xs font-bold text-zinc-300">갑구 / 을구 위험 요소 (해당 시 체크)</p>
        <label class="flex items-center gap-2 cursor-pointer text-sm">
          <input id="seized" type="checkbox" class="w-4 h-4 accent-rose-500" />
          <span class="text-zinc-300">갑구에 <strong class="text-rose-300">압류 / 가압류</strong> 표시</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer text-sm">
          <input id="trust" type="checkbox" class="w-4 h-4 accent-rose-500" />
          <span class="text-zinc-300">소유주가 <strong class="text-rose-300">신탁회사</strong> 명의 (한국토지신탁 등)</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer text-sm">
          <input id="auction" type="checkbox" class="w-4 h-4 accent-rose-500" />
          <span class="text-zinc-300">현재 <strong class="text-rose-300">경매 또는 임의경매</strong> 진행 중</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer text-sm">
          <input id="tax" type="checkbox" class="w-4 h-4 accent-rose-500" />
          <span class="text-zinc-300">국세 / 지방세 <strong class="text-rose-300">체납 압류</strong> 표시</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer text-sm">
          <input id="agent" type="checkbox" class="w-4 h-4 accent-amber-500" />
          <span class="text-zinc-300">계약 — <strong class="text-amber-300">임대인 본인 아닌 대리인</strong></span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer text-sm">
          <input id="newOwner" type="checkbox" class="w-4 h-4 accent-amber-500" />
          <span class="text-zinc-300">최근 <strong class="text-amber-300">1년 이내 매매 등기</strong> (소유주 변경)</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer text-sm">
          <input id="multi" type="checkbox" class="w-4 h-4 accent-amber-500" />
          <span class="text-zinc-300"><strong class="text-amber-300">다가구 / 다세대</strong> 1.5세대 이상</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer text-sm">
          <input id="cheap" type="checkbox" class="w-4 h-4 accent-amber-500" />
          <span class="text-zinc-300">시세보다 <strong class="text-amber-300">현저히 저렴한 보증금</strong> 제안 (할인 ↑ → 의심)</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer text-sm">
          <input id="hugYes" type="checkbox" class="w-4 h-4 accent-emerald-500" checked />
          <span class="text-zinc-300">전세금 <strong class="text-emerald-300">반환보증보험 가입 가능</strong> (HUG/SGI) — 안전</span>
        </label>
      </div>
    </div>
  </section>

  <!-- RESULT -->
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div id="result-panel" class="rounded-3xl border-2 p-8" style="border-color: #71717a;">
      <p class="text-[10px] font-bold uppercase tracking-widest text-zinc-400">위험 점수</p>
      <div class="mt-2 flex items-baseline gap-3 flex-wrap">
        <p id="r-score" class="text-7xl sm:text-8xl font-black text-white tabular-nums">-</p>
        <p class="text-2xl text-zinc-500 font-bold">/ 100</p>
      </div>
      <p id="r-label" class="mt-3 text-2xl font-black">-</p>
      <p id="r-summary" class="mt-3 text-sm text-zinc-300 leading-relaxed">-</p>

      <div id="r-breakdown" class="mt-6 space-y-1.5 text-xs text-zinc-400"></div>

      <div id="r-actions" class="mt-6 space-y-2"></div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-xl border border-amber-500/30 bg-amber-500/5 p-5 text-sm text-zinc-300">
      <p class="font-bold text-amber-300 mb-2">⚠ 본 계산은 참고용</p>
      <p class="text-xs leading-relaxed">
        실제 사기는 더 복잡한 패턴 — 본 점수가 낮아도 100% 안전 X. 분쟁 발생 시 전문가 상담 필수.
        본 도구는 위험 신호 1차 스크리닝.
      </p>
    </div>
  </section>
</Layout>

<script is:inline>
  const $ = (id) => document.getElementById(id);

  function calc() {
    const deposit = +$('deposit').value || 0;
    const market = +$('market').value || 0;
    const mortgage = +$('mortgage').value || 0;

    let score = 0;
    const breakdown = [];

    // 1. 보증금 / 시세 비율 (가장 큰 가중치)
    if (market > 0) {
      const ratio = deposit / market;
      let pts = 0;
      if (ratio >= 1.0) { pts = 40; breakdown.push(`보증금 ≥ 시세 100% (깡통전세 위험): +${pts}점`); }
      else if (ratio >= 0.9) { pts = 32; breakdown.push(`보증금 90–100% — 매우 위험: +${pts}점`); }
      else if (ratio >= 0.8) { pts = 22; breakdown.push(`보증금 80–90% — 위험: +${pts}점`); }
      else if (ratio >= 0.7) { pts = 10; breakdown.push(`보증금 70–80% — 주의: +${pts}점`); }
      else if (ratio >= 0.6) { pts = 3; breakdown.push(`보증금 60–70% — 양호: +${pts}점`); }
      else { breakdown.push(`보증금 < 시세 60% — 안전 (+0)`); }
      score += pts;
    }

    // 2. 보증금 + 근저당 / 시세 (Loan-to-Value 합산)
    if (market > 0) {
      const totalRatio = (deposit + mortgage) / market;
      let pts = 0;
      if (totalRatio >= 1.2) { pts = 25; breakdown.push(`(보증금+근저당) ≥ 시세 120% — 경매시 보호 X: +${pts}점`); }
      else if (totalRatio >= 1.0) { pts = 18; breakdown.push(`(보증금+근저당) 100–120%: +${pts}점`); }
      else if (totalRatio >= 0.9) { pts = 10; breakdown.push(`(보증금+근저당) 90–100%: +${pts}점`); }
      else if (totalRatio >= 0.8) { pts = 5; breakdown.push(`(보증금+근저당) 80–90%: +${pts}점`); }
      else { breakdown.push(`(보증금+근저당) < 시세 80% — 안전 (+0)`); }
      score += pts;
    }

    // 3. 갑구/을구 고위험 요소
    if ($('seized').checked) { score += 20; breakdown.push(`갑구 압류/가압류: +20점`); }
    if ($('trust').checked) { score += 25; breakdown.push(`신탁회사 명의 — 임대인 권한 모호: +25점`); }
    if ($('auction').checked) { score += 30; breakdown.push(`경매 진행 중 — 즉시 보류: +30점`); }
    if ($('tax').checked) { score += 18; breakdown.push(`세금 체납 압류: +18점`); }

    // 4. 중위험
    if ($('agent').checked) { score += 6; breakdown.push(`대리인 계약 — 위임장 확인 필요: +6점`); }
    if ($('newOwner').checked) { score += 8; breakdown.push(`1년 이내 매매 등기: +8점`); }
    if ($('multi').checked) { score += 5; breakdown.push(`다가구/다세대 — 임차인 분배 위험: +5점`); }
    if ($('cheap').checked) { score += 12; breakdown.push(`현저히 저렴한 보증금 — 의심: +12점`); }

    // 5. 안전 요소
    if ($('hugYes').checked) { score -= 15; breakdown.push(`반환보증보험 가입 가능 — 안전: −15점`); }

    score = Math.max(0, Math.min(100, score));

    let label, color, summary, actions;
    if (score >= 70) {
      label = '🔴 매우 위험 — 계약 보류 권장';
      color = '#ef4444';
      summary = '여러 사기 신호가 겹쳐 있음. 계약하지 마세요. 다른 매물 알아보거나 전문가 상담 필수.';
      actions = [
        { label: '계약 즉시 보류', sub: '다른 매물 알아보기' },
        { label: 'HUG 안심전세 콜센터 1566-9009', sub: '무료 상담 가능', url: 'https://www.khug.or.kr' },
        { label: '대한법률구조공단 132', sub: '무료 법률 상담' },
      ];
    } else if (score >= 40) {
      label = '🟠 위험 — 추가 검증 필수';
      color = '#f97316';
      summary = '주요 위험 신호가 있음. 등기부등본 잔금일 재발급 + HUG 보증 가입 확인 + 공인된 법무사 상담.';
      actions = [
        { label: '잔금일 등기부등본 재발급', sub: '인터넷등기소 ₩700', url: 'https://www.iros.go.kr' },
        { label: 'HUG 안심전세 가입 가능 여부 확인', sub: '0.5–1% 수수료', url: 'https://www.khug.or.kr' },
        { label: '국토부 실거래가 한 번 더 확인', sub: '동일 단지 시세', url: 'https://rt.molit.go.kr' },
      ];
    } else if (score >= 15) {
      label = '🟡 주의 — 일반 검증 진행';
      color = '#eab308';
      summary = '대부분 안전 신호. 일반적인 확인 절차만 진행하면 OK. 잔금 + 입주 당일 전입신고 + 확정일자 필수.';
      actions = [
        { label: '잔금 + 입주 당일 동주민센터', sub: '전입신고 + 확정일자' },
        { label: '전세보증보험 가입', sub: 'HUG 안심전세 — 수수료 0.5–1%', url: 'https://www.khug.or.kr' },
      ];
    } else {
      label = '🟢 안전 — 일반 절차';
      color = '#10b981';
      summary = '큰 사기 신호 없음. 일반적인 계약 절차 진행. 잔금일 등기 한 번 더 확인 권장.';
      actions = [
        { label: '잔금 + 입주 당일 전입신고', sub: '확정일자 동시 발급' },
      ];
    }

    $('r-score').textContent = score;
    $('r-score').style.color = color;
    $('r-label').textContent = label;
    $('r-label').style.color = color;
    $('r-summary').textContent = summary;
    document.getElementById('result-panel').style.borderColor = color;

    document.getElementById('r-breakdown').innerHTML = breakdown.map((b) => `<p>• ${b}</p>`).join('');
    document.getElementById('r-actions').innerHTML = actions.map((a) => `
      <div class="rounded-xl border border-zinc-700 bg-zinc-900/60 p-4">
        <p class="font-bold text-sm">${a.label}</p>
        <p class="text-xs text-zinc-400 mt-1">${a.sub}</p>
        ${a.url ? `<a href="${a.url}" target="_blank" rel="noopener" class="mt-2 inline-block text-xs text-cyan-300 hover:text-cyan-200 underline">바로가기 →</a>` : ''}
      </div>
    `).join('');

    if (window.va) { try { window.va('event', { name: 'jeonse_risk_calc', data: { score } }); } catch (_) {} }
    if (window.gtag) { try { window.gtag('event', 'jeonse_risk_calc', { value: score, event_category: 'tools' }); } catch (_) {} }
  }

  ['deposit', 'market', 'mortgage', 'seized', 'trust', 'auction', 'tax', 'agent', 'newOwner', 'multi', 'cheap', 'hugYes'].forEach((id) => {
    $(id).addEventListener('input', calc);
    $(id).addEventListener('change', calc);
  });
  calc();
</script>
