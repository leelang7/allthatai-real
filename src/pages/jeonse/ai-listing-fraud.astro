---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="AI 매물 사기 패턴 탐지 — 매물 설명·시세 비교 → 사기 가능성 LLM" description="매물 광고 텍스트 + 시세 입력 → Gemini가 깡통전세·급매·신탁·계좌 패턴 등 사기 시그널 자동 탐지.">
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-rose-500/30 bg-rose-500/5 px-3 py-1 text-xs text-rose-300">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-rose-400 animate-pulse"></span>Gemini — 사기 패턴 탐지
    </div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight"><span class="text-gradient">AI 매물 사기</span> 탐지</h1>
    <p class="mt-4 text-lg text-zinc-400">매물 설명 + 시세 → 사기 패턴 자동 분류.</p>
  </section>
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-3">
      <div class="grid sm:grid-cols-3 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">거래 유형</span><select id="dealType" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-rose-500 outline-none px-3 py-2 text-white"><option value="jeonse">전세</option><option value="monthly">월세</option><option value="sale">매매</option></select></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">제시가 (₩)</span><input id="askPrice" type="number" value="300000000" step="10000000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-rose-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">주변 시세 (₩)</span><input id="marketPrice" type="number" value="350000000" step="10000000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-rose-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
      </div>
      <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">매물 설명 / 특이사항 / 임대인 발언</span><textarea id="listingText" rows="8" placeholder="네이버부동산·직방·다방 등에서 본 매물 설명, 임대인이 한 말, 계약 조건, 입금 계좌 등을 그대로 붙여넣으세요." class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-rose-500 outline-none px-4 py-3 text-sm text-zinc-200"></textarea></label>
      <button id="go" type="button" class="w-full rounded-lg bg-rose-500 hover:bg-rose-400 text-white font-black py-3 disabled:opacity-50">AI 사기 패턴 분석</button>
      <p id="status" class="text-xs text-zinc-400 text-center"></p>
    </div>
  </section>
  <section id="result" class="hidden mx-auto max-w-3xl px-4 py-2 space-y-3">
    <div id="box" class="rounded-3xl border-2 p-8">
      <p class="text-[10px] font-bold uppercase tracking-widest" id="lbl">사기 가능성</p>
      <p id="score" class="mt-2 text-6xl font-black tabular-nums">-</p>
      <p id="verdict" class="mt-2 text-2xl font-black">-</p>
      <p id="summary" class="mt-3 text-sm text-zinc-300"></p>
    </div>
    <div class="rounded-2xl border border-rose-500/40 bg-rose-500/5 p-5"><h4 class="text-xs font-black text-rose-300 uppercase tracking-widest mb-3">🚨 탐지된 패턴</h4><div id="patterns" class="space-y-2"></div></div>
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border border-amber-500/40 bg-amber-500/5 p-5"><h4 class="text-xs font-black text-amber-300 uppercase tracking-widest mb-3">⚠ 즉시 위험 신호</h4><ul id="redFlags" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
      <div class="rounded-2xl border border-cyan-500/40 bg-cyan-500/5 p-5"><h4 class="text-xs font-black text-cyan-300 uppercase tracking-widest mb-3">✓ 확인 체크리스트</h4><ul id="checkList" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
    </div>
    <div class="rounded-2xl border border-emerald-500/40 bg-emerald-500/5 p-5"><h4 class="text-xs font-black text-emerald-300 uppercase tracking-widest mb-3">📌 다음 행동</h4><ul id="nextSteps" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
  </section>
</Layout>
<script is:inline>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  $('go').addEventListener('click', async () => {
    const txt = $('listingText').value.trim();
    if (txt.length < 20) { $('status').textContent = '⚠ 매물 설명 20자 이상'; $('status').className = 'text-xs text-rose-300 text-center'; return; }
    $('go').disabled = true; $('status').textContent = '🤖 사기 패턴 분석 중...'; $('status').className = 'text-xs text-rose-300 text-center animate-pulse';
    try {
      const res = await fetch('/api/ai-listing-fraud', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ listingText: txt, marketPrice: +$('marketPrice').value, askPrice: +$('askPrice').value, dealType: $('dealType').value }) });
      const data = await res.json();
      if (!data.ok) { $('status').textContent = '❌ ' + data.error; $('status').className = 'text-xs text-rose-300 text-center'; $('go').disabled = false; return; }
      $('result').classList.remove('hidden'); $('status').textContent = '✓ 완료'; $('status').className = 'text-xs text-emerald-300 text-center';
      const s = data.fraudScore || 0;
      let color = 'text-emerald-300', bg = 'border-emerald-500/40 bg-emerald-500/5';
      if (s >= 75) { color = 'text-rose-300'; bg = 'border-rose-500/40 bg-rose-500/10'; }
      else if (s >= 50) { color = 'text-orange-300'; bg = 'border-orange-500/40 bg-orange-500/5'; }
      else if (s >= 25) { color = 'text-amber-300'; bg = 'border-amber-500/40 bg-amber-500/5'; }
      $('box').className = 'rounded-3xl border-2 p-8 ' + bg;
      $('lbl').className = 'text-[10px] font-bold uppercase tracking-widest ' + color;
      $('score').className = 'mt-2 text-6xl font-black tabular-nums ' + color;
      $('verdict').className = 'mt-2 text-2xl font-black ' + color;
      $('score').textContent = s + ' / 100';
      $('verdict').textContent = data.verdict || '-';
      $('summary').textContent = data.summary || '';
      $('patterns').innerHTML = (data.detectedPatterns || []).map((p) => {
        const sev = p.severity || '중간';
        const sc = sev === '높음' ? 'bg-rose-500' : sev === '낮음' ? 'bg-amber-500' : 'bg-orange-500';
        return `<div class="rounded-lg bg-zinc-900/60 p-3"><div class="flex items-center gap-2 mb-1"><span class="text-[10px] font-black px-2 py-0.5 rounded ${sc} text-white">${esc(sev)}</span><span class="text-sm font-bold text-zinc-200">${esc(p.pattern || '')}</span></div><p class="text-xs text-zinc-300">${esc(p.explanation || '')}</p></div>`;
      }).join('') || '<p class="text-sm text-zinc-500">탐지된 패턴 없음</p>';
      $('redFlags').innerHTML = (data.redFlags || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('checkList').innerHTML = (data.checkList || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('nextSteps').innerHTML = (data.nextSteps || []).map((x) => `<li>${esc(x)}</li>`).join('');
      if (window.va) { try { window.va('event', { name: 'ai_fraud', data: { score: s } }); } catch (_) {} }
    } catch (e) { $('status').textContent = '❌ ' + e.message; $('status').className = 'text-xs text-rose-300 text-center'; }
    finally { $('go').disabled = false; }
  });
</script>
