---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="AI 임대차 계약서 함정 탐지 — 불공정 조항 자동 추출 + 수정안"
  description="전세·월세·매매 계약서 텍스트 → Gemini가 함정 조항 추출 + 누락 조항 + 수정 제안. 사인 전 5초 검토."
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-rose-500/30 bg-rose-500/5 px-3 py-1 text-xs text-rose-300">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-rose-400"></span>
      Gemini LLM — 함정 조항 자동 추출
    </div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight">
      <span class="text-gradient">AI 계약서 검토</span>
    </h1>
    <p class="mt-4 text-lg text-zinc-400 leading-relaxed">사인 전 5초 — 불공정 조항·누락 조항·수정 제안 자동.</p>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-3">
      <label class="block">
        <span class="block text-xs font-bold text-zinc-300 mb-1.5">계약 유형</span>
        <select id="type" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-rose-500 outline-none px-4 py-2.5 text-white">
          <option value="jeonse">전세 임대차</option>
          <option value="monthly">월세 임대차</option>
          <option value="sale">매매</option>
        </select>
      </label>
      <label class="block">
        <span class="block text-xs font-bold text-zinc-300 mb-1.5">계약서 텍스트 (특약사항 포함 전문)</span>
        <textarea id="text" rows="14" placeholder="계약서·특약사항 텍스트를 그대로 붙여넣으세요. 개인정보(주민번호, 계좌번호 등)는 마스킹 후 사용 권장."
                  class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-rose-500 outline-none px-4 py-3 text-sm text-zinc-200 font-mono"></textarea>
        <span class="block text-[10px] text-zinc-500 mt-1">최소 100자, 최대 30,000자</span>
      </label>
      <button id="check" type="button" class="w-full rounded-lg bg-rose-500 hover:bg-rose-400 text-white font-black py-3 transition disabled:opacity-50">
        AI 함정 조항 분석 (약 5초)
      </button>
      <p id="status" class="text-xs text-zinc-400 text-center"></p>
    </div>
  </section>

  <section id="result" class="hidden mx-auto max-w-3xl px-4 py-2">
    <div id="score-box" class="rounded-3xl border-2 p-8">
      <p class="text-[10px] font-bold uppercase tracking-widest" id="score-label">계약 공정성 점수</p>
      <p id="score" class="mt-2 text-6xl font-black tabular-nums">-</p>
      <p id="verdict" class="mt-2 text-2xl font-black">-</p>
      <p id="summary" class="mt-3 text-sm text-zinc-300"></p>
    </div>

    <div class="mt-3 rounded-2xl border border-rose-500/40 bg-rose-500/5 p-5">
      <h4 class="text-xs font-black text-rose-300 uppercase tracking-widest mb-3">🚨 함정 조항</h4>
      <div id="redClauses" class="space-y-3"></div>
    </div>

    <div class="mt-3 rounded-2xl border border-amber-500/40 bg-amber-500/5 p-5">
      <h4 class="text-xs font-black text-amber-300 uppercase tracking-widest mb-3">⚠ 누락된 필수 조항</h4>
      <ul id="missing" class="space-y-1.5 text-sm text-zinc-300 list-disc list-inside"></ul>
    </div>

    <div class="mt-3 rounded-2xl border border-emerald-500/40 bg-emerald-500/5 p-5">
      <h4 class="text-xs font-black text-emerald-300 uppercase tracking-widest mb-3">✓ 수정·추가 권장</h4>
      <ul id="suggestions" class="space-y-1.5 text-sm text-zinc-300 list-disc list-inside"></ul>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
      <h2 class="font-black mb-3">자주 발견되는 함정 조항</h2>
      <ul class="space-y-2 text-sm text-zinc-300">
        <li>→ <strong>원상복구 무제한</strong>: "임차인은 모든 손상에 대해 원상복구" — 자연마모는 임대인 부담</li>
        <li>→ <strong>중도해지 위약금 과도</strong>: 월세 3개월 초과는 무효 가능</li>
        <li>→ <strong>임대인 수선의무 면제</strong>: 주임법 위반</li>
        <li>→ <strong>전세권 등기 금지</strong>: 임차인 권리 박탈, 무효</li>
        <li>→ <strong>관할 법원 임대인 소재지</strong>: 임차인 소재지 가능 안내 X</li>
        <li>→ <strong>묵시적 갱신 배제</strong>: 임차인 보호 박탈</li>
      </ul>
      <p class="mt-3 text-xs text-zinc-500">최종 검토는 부동산 변호사·법무사와 상담. AI 판단은 참고용.</p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-4">
    <div class="grid sm:grid-cols-3 gap-2">
      <a href="/jeonse/ai-etungi/" class="rounded-xl border border-zinc-800 hover:border-rose-500/40 bg-zinc-900/40 p-3 transition text-sm">AI 등기부 →</a>
      <a href="/tools/ai-tenant-letter/" class="rounded-xl border border-zinc-800 hover:border-rose-500/40 bg-zinc-900/40 p-3 transition text-sm">AI 임차인 공문 →</a>
      <a href="/jeonse/contract-checklist/" class="rounded-xl border border-zinc-800 hover:border-rose-500/40 bg-zinc-900/40 p-3 transition text-sm">계약 체크리스트 →</a>
    </div>
  </section>
</Layout>

<script is:inline>
  const $ = (id) => document.getElementById(id);
  function escapeHtml(s) { return String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

  async function check() {
    const text = $('text').value.trim();
    const type = $('type').value;
    if (text.length < 100) {
      $('status').textContent = '⚠ 최소 100자 이상 입력하세요'; $('status').className = 'text-xs text-rose-300 text-center'; return;
    }
    $('check').disabled = true;
    $('status').textContent = '🤖 Gemini 분석 중...';
    $('status').className = 'text-xs text-rose-300 text-center animate-pulse';
    try {
      const res = await fetch('/api/ai-contract-check', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text, type }),
      });
      const data = await res.json();
      if (!data.ok) {
        $('status').textContent = '❌ ' + (data.error || '분석 실패'); $('status').className = 'text-xs text-rose-300 text-center';
        $('check').disabled = false; return;
      }
      $('result').classList.remove('hidden');
      $('status').textContent = '✓ 완료';
      $('status').className = 'text-xs text-emerald-300 text-center';

      const score = data.fairnessScore || 0;
      let color = 'text-emerald-300', boxBg = 'border-emerald-500/40 bg-emerald-500/5';
      if (score < 50) { color = 'text-rose-300'; boxBg = 'border-rose-500/40 bg-rose-500/10'; }
      else if (score < 70) { color = 'text-orange-300'; boxBg = 'border-orange-500/40 bg-orange-500/5'; }
      else if (score < 85) { color = 'text-amber-300'; boxBg = 'border-amber-500/40 bg-amber-500/5'; }
      $('score-box').className = 'rounded-3xl border-2 p-8 ' + boxBg;
      $('score-label').className = 'text-[10px] font-bold uppercase tracking-widest ' + color;
      $('score').className = 'mt-2 text-6xl font-black tabular-nums ' + color;
      $('verdict').className = 'mt-2 text-2xl font-black ' + color;
      $('score').textContent = score + ' / 100';
      $('verdict').textContent = data.verdict || '-';
      $('summary').textContent = data.summary || '';

      $('redClauses').innerHTML = (data.redClauses || []).map((c) => {
        const sev = c.severity || '중간';
        const sevColor = sev === '높음' ? 'bg-rose-500' : sev === '낮음' ? 'bg-amber-500' : 'bg-orange-500';
        return `<div class="rounded-lg bg-zinc-900/60 p-3">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-[10px] font-black px-2 py-0.5 rounded ${sevColor} text-white">${sev}</span>
            <span class="text-xs font-mono text-zinc-400">"${escapeHtml(c.clause || '')}"</span>
          </div>
          <p class="text-sm text-zinc-200">${escapeHtml(c.issue || '')}</p>
        </div>`;
      }).join('') || '<p class="text-sm text-zinc-500">함정 조항 없음 ✨</p>';

      $('missing').innerHTML = (data.missingClauses || []).map((m) => `<li>${escapeHtml(m)}</li>`).join('') || '<li class="list-none text-zinc-500">없음</li>';
      $('suggestions').innerHTML = (data.suggestions || []).map((s) => `<li>${escapeHtml(s)}</li>`).join('') || '<li class="list-none text-zinc-500">없음</li>';

      if (window.va) { try { window.va('event', { name: 'ai_contract', data: { score, type } }); } catch (_) {} }
    } catch (e) {
      $('status').textContent = '❌ ' + e.message; $('status').className = 'text-xs text-rose-300 text-center';
    } finally { $('check').disabled = false; }
  }
  $('check').addEventListener('click', check);
</script>
