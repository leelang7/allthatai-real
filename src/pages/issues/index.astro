---
import Layout from '../../layouts/Layout.astro';
import { autoGuides } from '../../data/guides.auto';

const sorted = [...autoGuides].sort((a, b) => (a.generatedAt < b.generatedAt ? 1 : -1));

const tagColors: Record<string, string> = {
  '사회 이슈': 'bg-rose-500/10 text-rose-300 border-rose-500/20',
  '연예': 'bg-pink-500/10 text-pink-300 border-pink-500/20',
  '정치': 'bg-amber-500/10 text-amber-300 border-amber-500/20',
  '바이럴': 'bg-violet-500/10 text-violet-300 border-violet-500/20',
  '글로벌': 'bg-cyan-500/10 text-cyan-300 border-cyan-500/20',
  '스포츠': 'bg-emerald-500/10 text-emerald-300 border-emerald-500/20',
  'IT 이슈': 'bg-blue-500/10 text-blue-300 border-blue-500/20',
};
---
<Layout
  title="이슈 — AllThatAI Real"
  description="한국 주요 이슈를 1차 출처 기반으로 정리. 사실 / 양측 입장 / 미확인 항목까지 분리."
>
  <section class="mx-auto max-w-5xl px-4 pt-16 pb-12">
    <div class="inline-flex items-center gap-2 rounded-full border border-rose-500/30 bg-rose-500/5 px-3 py-1 text-xs text-rose-300">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-rose-400 animate-pulse"></span>
      6시간마다 자동 업데이트
    </div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black">이슈</h1>
    <p class="mt-3 text-zinc-400 text-lg max-w-2xl">
      한국 주요 트렌드 이슈를 1차 매체 출처 기반으로 정리. <strong class="text-white">사실 vs 루머</strong> 분리, 양측 입장, 미확인 항목까지 명시.
    </p>

    {sorted.length === 0 ? (
      <div class="mt-12 rounded-2xl border border-zinc-800 bg-zinc-900/40 p-10 text-center">
        <p class="text-zinc-400">아직 자동 발행된 이슈가 없습니다.</p>
        <p class="mt-2 text-xs text-zinc-500">GitHub Actions cron이 6시간마다 실행되며, 첫 실행 후 여기 채워집니다.</p>
      </div>
    ) : (
      <div class="mt-10 grid md:grid-cols-2 gap-4">
        {sorted.map((g) => (
          <a href={`/issues/${g.slug}/`} class="card-lift group block rounded-2xl border border-zinc-800 hover:border-cyan-500/40 bg-zinc-900/30 p-6 transition">
            <div class="flex items-center gap-2 text-[10px] font-bold tracking-widest uppercase">
              <span class={`rounded border px-2 py-0.5 ${tagColors[g.tag] || 'bg-zinc-800 text-zinc-300 border-zinc-700'}`}>{g.tag}</span>
              <span class="text-zinc-500">{g.minutes}분</span>
              <span class="text-zinc-600">· {g.generatedAt.slice(0, 10)}</span>
            </div>
            <h3 class="mt-3 text-lg font-bold leading-snug group-hover:text-cyan-300 transition">{g.title}</h3>
            <p class="mt-2 text-sm text-zinc-400 leading-relaxed">{g.excerpt}</p>
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>
