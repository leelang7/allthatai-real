---
/**
 * Game-key meta-search page (겜스고 어필 변형).
 *
 * Search box → query goes to 5 stores in parallel via affiliate links.
 * Same UX pattern as /deals/hotels and /deals/flights — proven funnel.
 *
 * Why this beats 겜스고 (재판매):
 *   - 0 inventory, 0 CS, 0 키 불량 환불 책임
 *   - 검색량 큰 SEO 잡음 (게임명 + "최저가")
 *   - Steam KRW > 글로벌 가격 차이 = 5–10% 어필
 */
import Layout from '../../layouts/Layout.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import KeyPriceCompare from '../../components/KeyPriceCompare.astro';

const popularGames = [
  'Cyberpunk 2077',
  'Elden Ring',
  'Baldur\'s Gate 3',
  'Hogwarts Legacy',
  'Red Dead Redemption 2',
  'GTA V',
  'The Witcher 3',
  'Black Myth: Wukong',
  'Stardew Valley',
  'Valheim',
  'Dave the Diver',
  'Stellar Blade',
];
---
<Layout
  title="게임 키 최저가 비교 — Kinguin · Eneba · Fanatical · GMG · Humble"
  description="같은 게임 키를 5개 합법 스토어에서 동시 검색. Steam KR보다 10–50% 싸게 살 수 있는 정식 키만."
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/5 px-3 py-1 text-xs text-amber-300">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-400"></span>
      게임 키 메타서치 ×5
    </div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight">
      <span class="text-gradient">게임 키</span> 5개 스토어 한번에
    </h1>
    <p class="mt-4 text-lg text-zinc-400 leading-relaxed">
      Kinguin · Eneba · Fanatical · GMG · Humble — Steam KR 가격보다
      <strong class="text-white">10–50% 싸게</strong> 살 수 있는 합법 키 스토어 동시 검색.
    </p>
  </section>

  <!-- SEARCH FORM -->
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
      <form id="key-form" class="space-y-3">
        <label class="block">
          <span class="block text-xs font-bold text-zinc-300 mb-1.5">게임 이름 (영어 권장 — 정확도 ↑)</span>
          <input
            id="game"
            type="text"
            placeholder="예: Cyberpunk 2077, Elden Ring"
            required
            class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 outline-none px-4 py-3 text-white"
          />
        </label>
        <button type="submit" class="w-full rounded-lg bg-amber-500 hover:bg-amber-400 text-zinc-950 font-bold px-6 py-3 transition">
          5개 스토어 동시 검색 →
        </button>
      </form>

      <div id="key-results" class="hidden mt-6"></div>
    </div>
  </section>

  <!-- POPULAR -->
  <section class="mx-auto max-w-3xl px-4 py-6">
    <h2 class="text-lg font-black mb-3">자주 검색되는 게임</h2>
    <div class="flex flex-wrap gap-2">
      {popularGames.map((g) => (
        <button type="button" class="quick-game rounded-full border border-zinc-700 hover:border-amber-500/60 hover:bg-amber-500/5 px-4 py-1.5 text-sm transition" data-game={g}>
          {g}
        </button>
      ))}
    </div>
  </section>

  <!-- PRE-RENDERED COMPARE for one popular game (SEO landing) -->
  <section class="mx-auto max-w-3xl px-4 py-6">
    <h2 class="text-lg font-black mb-3">예시 — Cyberpunk 2077 한 번에</h2>
    <KeyPriceCompare game="Cyberpunk 2077" />
  </section>

  <!-- WHY -->
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
      <h2 class="font-black mb-3">왜 Steam 보다 싼가</h2>
      <ul class="space-y-2 text-sm text-zinc-300">
        <li>→ <strong>지역 차이</strong>: Kinguin/Eneba는 글로벌 마켓플레이스. 일부 키가 EU/RU 지역 발매 → 한국 Steam KRW보다 10–30% 싸게.</li>
        <li>→ <strong>대량 구매 마진</strong>: Fanatical/GMG는 퍼블리셔에게 직접 대량 구매 후 할인 판매.</li>
        <li>→ <strong>Humble Choice</strong>: 월정액 ($11.99/월)로 매월 게임 8–10개 받음 — 개당 $1 수준.</li>
        <li>→ <strong>Steam에 활성</strong>: 키 받으면 그대로 Steam에 활성화 — 일반 Steam 게임처럼 작동.</li>
      </ul>
    </div>
  </section>

  <AffiliateDisclosure />
</Layout>

<script is:inline define:vars={{ popularGames }}>
  // Build search URLs in JS so we don't need server round-trip.
  const STORES = [
    { key: 'kinguin', brand: 'Kinguin', base: 'https://www.kinguin.net/listing?phrase=', param: 'tag', pitch: '글로벌 마켓플레이스, 종종 50–80% 싸게', color: 'from-amber-500/20 to-orange-500/5' },
    { key: 'eneba', brand: 'Eneba', base: 'https://www.eneba.com/store/all-products?text=', param: 'af_id', pitch: '신흥 강자, 같은 키 더 저렴', color: 'from-violet-500/20 to-purple-500/5' },
    { key: 'fanatical', brand: 'Fanatical', base: 'https://www.fanatical.com/en/search?search=', param: 'tap_a', pitch: '번들·인디 강함, AAA 80%+', color: 'from-rose-500/20 to-pink-500/5' },
    { key: 'gmg', brand: 'Green Man Gaming', base: 'https://www.greenmangaming.com/search/?query=', param: 'tap_s', pitch: 'VIP 신작 25%+ 추가 할인', color: 'from-emerald-500/20 to-green-500/5' },
    { key: 'humble', brand: 'Humble', base: 'https://www.humblebundle.com/store/search?search=', param: 'partner', pitch: 'Choice 멤버십 + 자선 분배', color: 'from-cyan-500/20 to-blue-500/5' },
  ];

  function showResults(game) {
    const q = encodeURIComponent(game);
    const html = `
      <p class="text-xs text-zinc-500 mb-3">"${game}" — 5개 스토어 새 탭으로 열기</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-2">
        ${STORES.map((s) => `
          <a href="${s.base}${q}" target="_blank" rel="sponsored noopener nofollow" data-keystore="${s.key}" data-game="${game.replace(/"/g, '&quot;')}" class="key-store-link card-lift block rounded-xl border border-zinc-700 bg-gradient-to-br ${s.color} p-3 transition hover:border-amber-500/60">
            <p class="font-black text-white text-sm">${s.brand}</p>
            <p class="mt-1 text-[10px] text-zinc-400 leading-snug">${s.pitch}</p>
            <p class="mt-2 text-[11px] text-amber-300 font-bold">검색 →</p>
          </a>
        `).join('')}
      </div>
    `;
    const r = document.getElementById('key-results');
    r.innerHTML = html;
    r.classList.remove('hidden');

    if (window.va) { try { window.va('event', { name: 'key_search', data: { game } }); } catch (_) {} }
    if (window.gtag) { try { window.gtag('event', 'key_search', { search_term: game, event_category: 'monetization' }); } catch (_) {} }
  }

  document.getElementById('key-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const game = document.getElementById('game').value.trim();
    if (game) showResults(game);
  });

  document.querySelectorAll('.quick-game').forEach((btn) => {
    btn.addEventListener('click', () => {
      const game = btn.getAttribute('data-game');
      document.getElementById('game').value = game;
      showResults(game);
    });
  });

  document.addEventListener('click', (e) => {
    const a = e.target.closest && e.target.closest('a.key-store-link');
    if (!a) return;
    const store = a.getAttribute('data-keystore');
    const game = a.getAttribute('data-game');
    if (window.va) { try { window.va('event', { name: 'key_store_click', data: { store, game } }); } catch (_) {} }
    if (window.gtag) { try { window.gtag('event', 'key_store_click', { store, game, event_category: 'monetization' }); } catch (_) {} }
  });
</script>
