---
import Layout from '../../layouts/Layout.astro';

const includes = [
  { t: '키스토어 생성 + 안전 보관 가이드', d: '실제 출시에 쓰는 upload-keystore.jks 직접 만들고 비밀번호 백업 체계 잡기.' },
  { t: '패키지 ID 결정 + Android/iOS 정합', d: 'com.example.* 함정 + 한 번 정하면 못 바꾸는 것 / iOS bundle ID 동기화.' },
  { t: 'AAB 서명 빌드 + 서명 검증', d: 'flutter build appbundle --release / R8/ProGuard 룰 / 네이티브 .so 16KB align.' },
  { t: '앱 아이콘 + 피처그래픽 + 스크린샷', d: '1024×1024 + 512×512 + 1024×500 + 폰 캡처 4–6장. flutter_launcher_icons 자동화.' },
  { t: 'i18n 셋업 (KO/EN 기본)', d: 'flutter_localizations + ARB + MaterialApp delegates. 출시 후 추가 언어 30분.' },
  { t: 'Play Console 13개 필수 항목', d: '개인정보처리방침 / 콘텐츠 등급 / 데이터 보안 / 타겟층 / 광고 / 정부·금융·건강 모두.' },
  { t: 'DUNS 무료 경로 가이드', d: 'NICE에 10–20만원 안 내고 D&B 본사 직접 신청.' },
  { t: '통신판매업 신고 정부24 안내', d: '면제 대상 vs 신고 의무 구분 + 신고증 PDF 발급.' },
  { t: 'IAP SKU 설계 + Google Play Billing 연동', d: 'in_app_purchase 패키지 + restore + completePurchase + 가격 현지화.' },
  { t: '14일 / 12명 면제', d: '개인사업자 → 조직 계정 전환 풀가이드 (DUNS 사용처).' },
  { t: '첫 출시 + 7일 크래시 대응 1회', d: 'Production 심사 통과까지 동행 + 출시 1주일 logcat·ANR 대응 1회 포함.' },
];

const faq = [
  {
    q: '왜 ₩39만원이에요? 너무 비싼 거 아닌가요?',
    a: '제가 1주일 +α 헤매며 만든 절차를 1–2일에 끝내드립니다. 시간당 환산하면 그렇게 비싸지 않습니다. 또한 Play Store 출시 한 번 망치면 재출시 비용이 39만원 이상이에요 (패키지명 변경 불가, 앱 평점 회복 어려움 등).'
  },
  {
    q: '대행사라면 위법 아닌가요?',
    a: '단순 컨설팅·기술 가이드는 자격증 불필요합니다. 통신판매업 신고·사업자등록 같은 자격사 영역은 본인 명의로 직접 하시도록 안내만 합니다 (수수료 0원). 행정사·세무사 자격이 필요한 영역에는 손대지 않습니다.'
  },
  {
    q: '환불 가능한가요?',
    a: '키스토어 생성 전(첫 30분 안)에 취소 시 100% 환불. 그 이후엔 진행도에 따라 부분 환불.'
  },
  {
    q: '개인사업자 아니어도 되나요?',
    a: '개인 계정으로도 출시 가능합니다. 다만 Play Store 정책상 개인 계정은 출시 전 14일 / 12명 Closed Testing이 의무이고, 이걸 면제받으려면 조직 계정 전환이 필요합니다. 개인 계정 그대로면 14일 운영을 함께 도와드립니다.'
  },
  {
    q: 'iOS도 같이 되나요?',
    a: '본 패키지는 Android Play Store 기준입니다. iOS App Store는 Apple Developer Program $99/년 + 별도 패키지로 제공 (₩49만원).'
  },
];
---
<Layout
  title="Play Store 출시 풀패키지 ₩39만원 — 노대로"
  description="키스토어부터 DUNS, 통신판매업, IAP 연동, 첫 출시 + 7일 크래시 대응까지. 인디 개발자가 5일 헤맬 일을 1-2일에."
>
  <section class="mx-auto max-w-4xl px-4 pt-16 pb-12">
    <p class="text-cyan-400 text-sm font-medium">Play Store 출시 풀패키지</p>
    <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold leading-tight">
      혼자 5일 vs 같이 1–2일.<br />
      <span class="text-zinc-400 text-3xl">₩390,000 / 1회 / 첫 출시.</span>
    </h1>
    <p class="mt-6 text-lg text-zinc-400">
      한국 인디 개발자가 Play Store 첫 출시에 부딪히는 모든 함정 — 키스토어, DUNS, 통신판매업,
      Play Console 13개 항목, IAP 연동, JNI 크래시까지 — 한 번에 끝내는 풀패키지.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#contact" class="rounded-lg bg-cyan-500 text-zinc-950 px-6 py-3 font-bold hover:bg-cyan-400">상담 신청</a>
      <a href="#includes" class="rounded-lg border border-zinc-700 px-6 py-3 font-semibold hover:bg-zinc-900">포함 내역 →</a>
    </div>
  </section>

  <section id="includes" class="mx-auto max-w-4xl px-4 py-12">
    <h2 class="text-2xl font-bold mb-6">포함 11개 항목</h2>
    <div class="grid md:grid-cols-2 gap-4">
      {includes.map((it, i) => (
        <div class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-5">
          <div class="text-xs text-cyan-400 font-mono">#{String(i+1).padStart(2,'0')}</div>
          <h3 class="mt-1 font-bold">{it.t}</h3>
          <p class="mt-2 text-sm text-zinc-400 leading-relaxed">{it.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-12">
    <h2 class="text-2xl font-bold mb-6">자주 묻는 것</h2>
    <div class="space-y-3">
      {faq.map((f) => (
        <details class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-5 group">
          <summary class="cursor-pointer font-bold list-none flex items-center justify-between">
            {f.q}
            <span class="text-zinc-500 group-open:rotate-180 transition">▾</span>
          </summary>
          <p class="mt-3 text-sm text-zinc-400 leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section id="contact" class="mx-auto max-w-4xl px-4 py-16">
    <div class="rounded-2xl border border-zinc-800 bg-gradient-to-br from-zinc-900 to-zinc-950 p-8 md:p-12 text-center">
      <h2 class="text-3xl font-bold">상담 신청</h2>
      <p class="mt-3 text-zinc-400">현재 앱 상태 + 마감 일정 알려주시면 24시간 내 답변.</p>
      <div class="mt-6 flex flex-wrap gap-3 justify-center">
        <a href="https://open.kakao.com/me/yourchannel" class="rounded-lg bg-yellow-400 text-zinc-950 px-6 py-3 font-bold hover:bg-yellow-300">카톡 오픈채팅</a>
        <a href="mailto:leescvsir@nate.com" class="rounded-lg border border-zinc-700 px-6 py-3 font-semibold hover:bg-zinc-900">이메일 문의</a>
      </div>
      <p class="mt-6 text-xs text-zinc-500">※ 결제는 상담 후 토스페이먼츠로 진행. 키스토어 생성 전 100% 환불.</p>
    </div>
  </section>
</Layout>
