---
<Layout
  title="특수문자 복사 — 체크박스 ☑ 별 ★ 화살표 → 한 번 클릭"
  description="체크박스·별·화살표·도형·통화·로마숫자 등 특수문자를 클릭 한 번에 복사. 한글 자모·괄호·이모지 카테고리별 정리."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>

  <section class="mx-auto max-w-5xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-500/5 px-3 py-1 text-xs text-cyan-300">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
      클릭 한 번 복사
    </div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight">
      <span class="text-gradient">특수문자</span> 복사
    </h1>
    <p class="mt-4 text-lg text-zinc-400 leading-relaxed max-w-3xl">
      체크박스 ☑ · 별 ★ · 화살표 → · 도형 ◆ · 통화 ₩ · 로마숫자 Ⅹ · 한글 자모 ㄱ —
      각 문자 <strong class="text-white">클릭 한 번에 복사</strong>됩니다.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-24 space-y-10">
    {groups.map((g) => (
      <div>
        <div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
          <div>
            <h2 class="text-xl font-black">{g.title}</h2>
            <p class="text-xs text-zinc-500 mt-0.5">{g.hint}</p>
          </div>
          <span class="text-xs text-zinc-500">{g.symbols.length}개</span>
        </div>
        <div class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-2">
          {g.symbols.map((s) => (
            <button
              type="button"
              class="sym-btn group rounded-xl border border-zinc-800 hover:border-cyan-500/60 bg-zinc-900/40 hover:bg-zinc-800/60 p-3 transition flex flex-col items-center justify-center min-h-[72px]"
              data-char={s.char}
              data-name={s.name}
              title={`${s.name} 복사`}
            >
              <span class="text-3xl text-white group-hover:scale-110 transition leading-none">{s.char}</span>
              <span class="mt-1.5 text-[9px] text-zinc-500 group-hover:text-zinc-300 leading-tight text-center line-clamp-1">{s.name}</span>
            </button>
          ))}
        </div>
      </div>
    ))}
  </section>

  <div id="toast" class="fixed bottom-20 left-1/2 -translate-x-1/2 z-50 rounded-xl bg-emerald-500 text-zinc-950 font-bold px-5 py-3 text-sm shadow-2xl shadow-emerald-500/30 opacity-0 transition-opacity duration-200 pointer-events-none">
    <span id="toast-msg">복사됨</span>
  </div>
</Layout>

<script is:inline>
  const toast = document.getElementById('toast');
  const toastMsg = document.getElementById('toast-msg');
  let toastTimer = null;

  function showToast(msg) {
    if (toastTimer) clearTimeout(toastTimer);
    toastMsg.textContent = msg;
    toast.style.opacity = '1';
    toastTimer = setTimeout(() => { toast.style.opacity = '0'; }, 1200);
  }

  async function copyChar(char, name) {
    try {
      await navigator.clipboard.writeText(char);
      showToast(`✓ ${char} 복사됨`);
    } catch (_) {
      const ta = document.createElement('textarea');
      ta.value = char;
      ta.style.position = 'fixed';
      ta.style.top = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); showToast(`✓ ${char} 복사됨`); }
      catch (_) { showToast('복사 실패'); }
      document.body.removeChild(ta);
    }
    if (window.va) { try { window.va('event', { name: 'symbol_copy', data: { char, name } }); } catch (_) {} }
    if (window.gtag) { try { window.gtag('event', 'symbol_copy', { char, name, event_category: 'engagement' }); } catch (_) {} }
  }

  document.querySelectorAll('.sym-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const char = btn.getAttribute('data-char');
      const name = btn.getAttribute('data-name');
      copyChar(char, name);
    });
  });
</script>
