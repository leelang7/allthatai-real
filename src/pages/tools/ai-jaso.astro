---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="AI 자기소개서 첨삭 — 항목별 점수 + 구체 개선안" description="자소서 붙여넣기 → Gemini가 구체성·직무적합·차별화·구조·한국어 5개 항목 점수 + 개선안.">
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-pink-500/30 bg-pink-500/5 px-3 py-1 text-xs text-pink-300">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-pink-400"></span>Gemini — 자소서 첨삭
    </div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight"><span class="text-gradient">AI 자소서</span> 첨삭</h1>
    <p class="mt-4 text-lg text-zinc-400">5개 항목 점수 + 구체 개선안.</p>
  </section>
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-3">
      <div class="grid sm:grid-cols-2 gap-3">
        <input id="jobTitle" type="text" placeholder="지원 직무 (예: 백엔드 개발자)" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-pink-500 outline-none px-4 py-2.5 text-white" />
        <input id="question" type="text" placeholder="자소서 문항 (예: 지원동기)" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-pink-500 outline-none px-4 py-2.5 text-white" />
      </div>
      <textarea id="text" rows="14" placeholder="자기소개서 본문 (100~5,000자)" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-pink-500 outline-none px-4 py-3 text-sm text-zinc-200"></textarea>
      <button id="go" type="button" class="w-full rounded-lg bg-pink-500 hover:bg-pink-400 text-white font-black py-3 disabled:opacity-50">AI 첨삭 시작</button>
      <p id="status" class="text-xs text-zinc-400 text-center"></p>
    </div>
  </section>
  <section id="result" class="hidden mx-auto max-w-3xl px-4 py-2 space-y-3">
    <div id="overall-box" class="rounded-3xl border-2 p-8">
      <p class="text-[10px] font-bold uppercase tracking-widest" id="overall-label">종합 점수</p>
      <p id="overall-score" class="mt-2 text-6xl font-black tabular-nums">-</p>
      <p id="overall-verdict" class="mt-2 text-2xl font-black">-</p>
      <p id="overall-summary" class="mt-3 text-sm text-zinc-300"></p>
    </div>
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-5">
      <h4 class="text-xs font-black text-zinc-300 uppercase tracking-widest mb-3">항목별 점수</h4>
      <div id="scores" class="space-y-2"></div>
    </div>
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border border-emerald-500/40 bg-emerald-500/5 p-5">
        <h4 class="text-xs font-black text-emerald-300 uppercase tracking-widest mb-3">✓ 강점</h4>
        <ul id="strengths" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul>
      </div>
      <div class="rounded-2xl border border-rose-500/40 bg-rose-500/5 p-5">
        <h4 class="text-xs font-black text-rose-300 uppercase tracking-widest mb-3">⚠ 약점 + 개선안</h4>
        <div id="weaknesses" class="space-y-2"></div>
      </div>
    </div>
    <div class="rounded-2xl border border-violet-500/40 bg-violet-500/5 p-5">
      <h4 class="text-xs font-black text-violet-300 uppercase tracking-widest mb-3">💡 첫 문장 재작성 제안</h4>
      <p id="rewrite" class="text-sm text-zinc-200"></p>
    </div>
    <div class="rounded-2xl border border-amber-500/40 bg-amber-500/5 p-5">
      <h4 class="text-xs font-black text-amber-300 uppercase tracking-widest mb-3">+ 보강할 요소</h4>
      <ul id="missing" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul>
    </div>
  </section>
</Layout>
<script is:inline>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  $('go').addEventListener('click', async () => {
    const text = $('text').value.trim();
    if (text.length < 100) { $('status').textContent = '⚠ 100자 이상'; $('status').className = 'text-xs text-rose-300 text-center'; return; }
    $('go').disabled = true; $('status').textContent = '🤖 첨삭 중...'; $('status').className = 'text-xs text-pink-300 text-center animate-pulse';
    try {
      const res = await fetch('/api/ai-jaso', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text, jobTitle: $('jobTitle').value, question: $('question').value }) });
      const data = await res.json();
      if (!data.ok) { $('status').textContent = '❌ ' + data.error; $('status').className = 'text-xs text-rose-300 text-center'; $('go').disabled = false; return; }
      $('result').classList.remove('hidden'); $('status').textContent = '✓ 완료'; $('status').className = 'text-xs text-emerald-300 text-center';
      const s = data.overallScore || 0;
      let color = 'text-emerald-300', bg = 'border-emerald-500/40 bg-emerald-500/5';
      if (s < 50) { color = 'text-rose-300'; bg = 'border-rose-500/40 bg-rose-500/10'; }
      else if (s < 70) { color = 'text-amber-300'; bg = 'border-amber-500/40 bg-amber-500/5'; }
      $('overall-box').className = 'rounded-3xl border-2 p-8 ' + bg;
      $('overall-label').className = 'text-[10px] font-bold uppercase tracking-widest ' + color;
      $('overall-score').className = 'mt-2 text-6xl font-black tabular-nums ' + color;
      $('overall-verdict').className = 'mt-2 text-2xl font-black ' + color;
      $('overall-score').textContent = s + ' / 100';
      $('overall-verdict').textContent = data.verdict || '-';
      $('overall-summary').textContent = data.summary || '';
      $('scores').innerHTML = Object.entries(data.scores || {}).map(([k, v]) => `<div class="flex items-center gap-3"><span class="text-sm text-zinc-300 w-24">${esc(k)}</span><div class="flex-1 bg-zinc-900 rounded-full h-2"><div class="bg-pink-500 h-2 rounded-full" style="width: ${(v/20)*100}%"></div></div><span class="text-sm font-bold tabular-nums w-12 text-right">${v}/20</span></div>`).join('');
      $('strengths').innerHTML = (data.strengths || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('weaknesses').innerHTML = (data.weaknesses || []).map((w) => `<div class="rounded-lg bg-zinc-900/60 p-3"><p class="text-sm font-bold text-rose-300">${esc(w.issue || '')}</p><p class="text-sm text-zinc-300 mt-1">→ ${esc(w.suggestion || '')}</p></div>`).join('');
      $('rewrite').textContent = data.rewriteSuggestion || '';
      $('missing').innerHTML = (data.missingElements || []).map((x) => `<li>${esc(x)}</li>`).join('');
      if (window.va) { try { window.va('event', { name: 'ai_jaso', data: { score: s } }); } catch (_) {} }
    } catch (e) { $('status').textContent = '❌ ' + e.message; $('status').className = 'text-xs text-rose-300 text-center'; }
    finally { $('go').disabled = false; }
  });
</script>
