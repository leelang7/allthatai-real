---
/**
 * 유튜브 링크 → 다운로드.
 *
 * 구조
 * ====
 *   1 링크 붙이기 → /api/yt-info (Vercel) → 홈 PC 서비스 /info → 제목·길이·화질
 *   2 화질 고르기 → 브라우저가 홈 PC /file 로 **직접** 받는다
 *
 * 2번이 Vercel 을 지나지 않는 것이 핵심이다. 서버리스 함수로 영상 바이트를 흘리면
 * 크기·시간 제한에 바로 걸린다. 함수는 작은 JSON 만 중계한다.
 *
 * 홈 PC 쪽은 scripts/yt-service/app.py. env YT_API, YT_KEY 가 있어야 동작한다.
 * 없으면 화면이 "아직 연결되지 않았다"고 정확히 말한다 — 버튼만 있고 아무 일도
 * 안 일어나는 상태를 만들지 않는다.
 */
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Callout from '../../components/Callout.astro';

const title = '유튜브 다운로드';
const description = '유튜브 링크를 붙이면 화질을 골라 내려받습니다. 파일은 서버를 거치지 않고 바로 전달됩니다.';
---

<Layout title={`${title} | 올댓AI Real`} description={description}>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-16">
    <Breadcrumb items={[{ label: '홈', href: '/' }, { label: '도구', href: '/tools/' }, { label: title }]} />

    <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
      <span class="text-gradient-cyan">유튜브</span> 다운로드
    </h1>
    <p class="mt-3 text-zinc-400">
      링크를 붙여 넣으면 제목과 화질을 먼저 보여 줍니다. 고른 화질만 내려받습니다.
    </p>

    <form id="f" class="mt-8 flex flex-col gap-3 sm:flex-row">
      <input
        id="url" type="url" inputmode="url" required
        placeholder="https://www.youtube.com/watch?v=..."
        class="flex-1 rounded-xl border border-zinc-800 bg-zinc-900/60 px-4 py-3 text-zinc-100 placeholder:text-zinc-600 focus:border-cyan-500/60 focus:outline-none"
      />
      <button
        type="submit" id="go"
        class="rounded-xl bg-cyan-500 px-6 py-3 font-semibold text-zinc-950 transition hover:bg-cyan-400 disabled:opacity-50"
      >불러오기</button>
    </form>

    <div id="code-row" class="mt-3 hidden">
      <input
        id="code" type="text" placeholder="액세스 코드"
        class="w-full rounded-xl border border-amber-700/60 bg-zinc-900/60 px-4 py-2.5 text-sm text-zinc-100 placeholder:text-zinc-600 focus:border-amber-500 focus:outline-none"
      />
      <p class="mt-1.5 text-xs text-zinc-500">이 기능은 코드를 받은 분만 쓸 수 있습니다.</p>
    </div>

    <p id="msg" class="mt-4 hidden rounded-xl border border-zinc-800 bg-zinc-900/40 px-4 py-3 text-sm"></p>

    <article id="card" class="mt-6 hidden overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/40">
      <div class="flex gap-4 p-4">
        <img id="thumb" alt="" width="160" height="90" class="h-[90px] w-[160px] shrink-0 rounded-lg object-cover bg-zinc-800" />
        <div class="min-w-0">
          <h2 id="t" class="line-clamp-2 font-semibold leading-snug text-zinc-100"></h2>
          <p id="meta" class="mt-1 text-sm text-zinc-500 tabular-nums"></p>
        </div>
      </div>
      <div class="border-t border-zinc-800 p-4">
        <p class="mb-2 text-xs font-semibold tracking-wide text-zinc-500">화질 선택</p>
        <div id="opts" class="flex flex-wrap gap-2"></div>
        <p class="mt-3 text-xs text-zinc-500">
          누르면 준비가 끝나는 대로 저장이 시작됩니다. 긴 영상은 1~2분 걸릴 수 있습니다.
        </p>
      </div>
    </article>

    <div class="mt-10">
      <Callout type="info" title="파일은 어디를 지나나">
        링크 정보만 이 사이트를 거치고, <b>영상 파일은 서버를 거치지 않고</b> 바로 전달됩니다.
        저장한 파일은 이 사이트에 남지 않으며, 준비용 임시 파일은 10분 뒤 지워집니다.
      </Callout>
    </div>

    <div class="mt-4">
      <Callout type="warn" title="쓰기 전에">
        내려받은 영상의 저작권은 올린 사람에게 있습니다. 개인 소장 범위를 넘어 다시 올리거나
        배포하면 문제가 될 수 있습니다. 1시간이 넘는 영상은 받지 않습니다.
      </Callout>
    </div>
  </section>
</Layout>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const msg = $('msg') as HTMLParagraphElement;
  let info: any = null;

  function say(text: string, kind: 'err' | 'ok' | 'wait' = 'err') {
    msg.textContent = text;
    msg.className =
      'mt-4 rounded-xl border px-4 py-3 text-sm ' +
      (kind === 'err'
        ? 'border-rose-800/60 bg-rose-950/30 text-rose-200'
        : kind === 'ok'
          ? 'border-emerald-800/60 bg-emerald-950/30 text-emerald-200'
          : 'border-zinc-800 bg-zinc-900/40 text-zinc-300');
  }
  function hideMsg() { msg.className = 'mt-4 hidden'; }

  function fmtDur(s: number) {
    const m = Math.floor(s / 60);
    return `${m}분 ${String(s % 60).padStart(2, '0')}초`;
  }

  $('f').addEventListener('submit', async (e) => {
    e.preventDefault();
    const url = ($('url') as HTMLInputElement).value.trim();
    const code = ($('code') as HTMLInputElement).value.trim();
    const go = $('go') as HTMLButtonElement;

    $('card').classList.add('hidden');
    go.disabled = true;
    go.textContent = '불러오는 중…';
    say('영상 정보를 확인하고 있습니다…', 'wait');

    try {
      const res = await fetch('/api/yt-info', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', ...(code ? { 'X-Access-Code': code } : {}) },
        body: JSON.stringify({ url, accessCode: code }),
      });
      const d = await res.json();

      if (res.status === 403) {
        $('code-row').classList.remove('hidden');
        say(d.error || '액세스 코드가 필요합니다.', 'err');
        return;
      }
      if (!res.ok || !d.ok) { say(d.error || '불러오지 못했습니다.', 'err'); return; }

      info = d;
      hideMsg();
      ($('thumb') as HTMLImageElement).src = d.thumbnail || `https://i.ytimg.com/vi/${d.id}/hqdefault.jpg`;
      $('t').textContent = d.title || d.id;
      $('meta').textContent = [d.uploader, d.duration ? fmtDur(d.duration) : null].filter(Boolean).join(' · ');

      const opts = $('opts');
      opts.innerHTML = '';
      const mk = (label: string, q: Record<string, string>) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = label;
        b.className =
          'rounded-lg border border-zinc-700 bg-zinc-800/60 px-3.5 py-2 text-sm font-medium text-zinc-200 transition hover:border-cyan-500/60 hover:text-white';
        b.onclick = () => grab(q, label);
        opts.appendChild(b);
      };
      (d.heights || []).forEach((h: number) => mk(`${h}p`, { height: String(h) }));
      if (d.audioOnly) mk('소리만 (m4a)', { audio: '1' });
      $('card').classList.remove('hidden');
    } catch {
      say('연결하지 못했습니다. 잠시 후 다시 시도해 주세요.', 'err');
    } finally {
      go.disabled = false;
      go.textContent = '불러오기';
    }
  });

  // 파일은 홈 PC 주소로 직접 받는다. 이 사이트의 함수를 지나지 않는다.
  function grab(q: Record<string, string>, label: string) {
    if (!info?.fileBase || !info?.token) { say('다시 불러와 주세요.', 'err'); return; }
    const p = new URLSearchParams({ token: info.token, ...q });
    say(`${label} 준비 중입니다. 끝나면 저장이 시작됩니다…`, 'wait');
    window.location.href = `${info.fileBase}?${p}`;
  }
</script>
