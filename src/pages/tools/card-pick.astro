---
/**
 * Korean credit-card recommendation calculator.
 *
 * Input: monthly spend pattern across categories.
 * Output: top 3 cards by estimated annual benefit.
 *
 * Korean card affiliate landscape: most issuers use 카드고릴라/뱅크샐러드
 * partner networks (require business verification). Without those, this page
 * still ranks for high-volume "카드 추천" / "신용카드 비교" searches and
 * funnels traffic to the rest of the site (issues, store, services).
 *
 * Static card data — periodically refreshed by the user OR via a future
 * cron that diffs official benefit pages. Conservative annual benefit
 * estimates (cap-aware, no exaggerated marketing claims).
 */
import Layout from '../../layouts/Layout.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';

interface Card {
  name: string;
  issuer: string;
  annualFee: number;
  benefits: {
    cafe?: number;       // % cashback
    grocery?: number;
    fuel?: number;
    transit?: number;
    streaming?: number;
    delivery?: number;
    travel?: number;
    overseas?: number;
    online?: number;
    monthlyCap?: number; // total monthly cashback cap (KRW)
  };
  url: string;
  highlight: string;
}

const cards: Card[] = [
  {
    name: '신한 Mr.Life',
    issuer: '신한카드',
    annualFee: 15000,
    benefits: {
      grocery: 5, fuel: 5, transit: 10, monthlyCap: 50000,
    },
    url: 'https://www.shinhancard.com/pconts/html/card/cardproduct/MOBFM441R/MF6_0207.html',
    highlight: '대형마트·주유 5%, 대중교통 10%',
  },
  {
    name: '삼성 taptap O',
    issuer: '삼성카드',
    annualFee: 10000,
    benefits: {
      cafe: 5, delivery: 5, streaming: 10, monthlyCap: 30000,
    },
    url: 'https://www.samsungcard.com/personal/card/UHPPCA0101M0.jsp',
    highlight: '카페·배달·OTT 청구할인',
  },
  {
    name: 'KB국민 노리체크 v2',
    issuer: 'KB국민카드',
    annualFee: 0,
    benefits: {
      online: 3, transit: 5, monthlyCap: 30000,
    },
    url: 'https://card.kbcard.com/CRD/DVIEW/HCAMCXPRICAC0080?cooperationcode=NV02',
    highlight: '체크카드 — 연회비 0, 온라인 3%',
  },
  {
    name: '현대카드 ZERO Edition2',
    issuer: '현대카드',
    annualFee: 10000,
    benefits: {
      cafe: 1.5, grocery: 1.5, fuel: 1.5, online: 1.5,
      delivery: 1.5, transit: 1.5, streaming: 1.5,
    },
    url: 'https://www.hyundaicard.com/cpc/ma/CPCMA0101_01.hc?cardCd=ZRH',
    highlight: '한도 없이 모든 결제 1.5% (캡 없음)',
  },
  {
    name: '우리카드 카드의정석 위비',
    issuer: '우리카드',
    annualFee: 12000,
    benefits: {
      cafe: 7, delivery: 7, streaming: 10, monthlyCap: 30000,
    },
    url: 'https://pc.wooricard.com/dcp/yh/cdpd/cdtpcd/cdtpcd03/cdtpcdView.do?cdNm=11AAA1',
    highlight: '카페·배달·OTT 7%~10%',
  },
  {
    name: '하나 트래블로그',
    issuer: '하나카드',
    annualFee: 0,
    benefits: {
      overseas: 0, travel: 1.5, monthlyCap: 0,
    },
    url: 'https://www.kebhana.com/cont/mall/mall08/mall0805/index.jsp',
    highlight: '해외결제 무수수료 환전 (해외 100% 핵심)',
  },
  {
    name: '신한 처음 카드',
    issuer: '신한카드',
    annualFee: 0,
    benefits: {
      online: 5, delivery: 5, streaming: 5, monthlyCap: 15000,
    },
    url: 'https://www.shinhancard.com',
    highlight: '20대·신용 첫 발급용',
  },
  {
    name: 'BC 바로 클리어',
    issuer: 'BC카드',
    annualFee: 10000,
    benefits: {
      grocery: 5, fuel: 5, transit: 5, monthlyCap: 30000,
    },
    url: 'https://www.bccard.com',
    highlight: '청구할인 종합형',
  },
];

const categories = [
  { id: 'cafe', label: '카페 (스타벅스 등)', placeholder: '예: 100,000' },
  { id: 'grocery', label: '대형마트·식료품', placeholder: '예: 300,000' },
  { id: 'fuel', label: '주유소', placeholder: '예: 150,000' },
  { id: 'transit', label: '대중교통', placeholder: '예: 60,000' },
  { id: 'streaming', label: 'OTT 구독 (넷플릭스·디플)', placeholder: '예: 30,000' },
  { id: 'delivery', label: '배달·요기요·쿠팡이츠', placeholder: '예: 80,000' },
  { id: 'online', label: '온라인 쇼핑 (쿠팡·11번가)', placeholder: '예: 200,000' },
  { id: 'travel', label: '여행·항공·호텔', placeholder: '예: 0' },
  { id: 'overseas', label: '해외결제', placeholder: '예: 0' },
];
---
<Layout
  title="신용카드 추천 계산기 — 본인 소비 패턴 입력 → 최적 카드"
  description="월 소비 카테고리별 입력. 8개 인기 카드 중 연간 혜택 가장 많은 카드 추천. 한도·연회비 자동 계산."
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/5 px-3 py-1 text-xs text-amber-300">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-400"></span>
      카드 추천 계산기
    </div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight">
      내 소비에 진짜 <span class="text-gradient">이득인 카드</span>
    </h1>
    <p class="mt-4 text-lg text-zinc-400 leading-relaxed">
      한 달에 어디 얼마 쓰는지 입력 → 8개 인기 카드 중 연간 혜택 가장 큰 3개 추천.
      한도·연회비까지 차감한 실제 이득.
    </p>
  </section>

  <!-- INPUT FORM -->
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
      <h2 class="font-black mb-4">월 소비 카테고리별 (₩)</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        {categories.map((c) => (
          <label class="block">
            <span class="block text-xs font-semibold text-zinc-300 mb-1.5">{c.label}</span>
            <input
              type="number"
              data-cat={c.id}
              placeholder={c.placeholder}
              min="0"
              step="10000"
              class="cat-input w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 outline-none px-4 py-2.5 text-white"
            />
          </label>
        ))}
      </div>
      <button id="calc-btn" type="button" class="mt-5 w-full rounded-lg bg-amber-500 hover:bg-amber-400 text-zinc-950 font-bold px-6 py-3 transition">
        추천 카드 보기 →
      </button>
    </div>
  </section>

  <!-- RESULTS -->
  <section id="results" class="hidden mx-auto max-w-3xl px-4 py-6"></section>

  <!-- ALL CARDS REFERENCE -->
  <section class="mx-auto max-w-3xl px-4 py-8">
    <h2 class="text-xl font-black mb-4">전체 카드 목록 (8개)</h2>
    <div class="space-y-2">
      {cards.map((c) => (
        <a href={c.url} target="_blank" rel="sponsored noopener" data-card-name={c.name} class="card-link block rounded-xl border border-zinc-800 bg-zinc-900/40 p-4 hover:border-amber-500/40 transition">
          <div class="flex items-center justify-between gap-3">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-black text-white">{c.name}</span>
                <span class="text-[10px] text-zinc-500">{c.issuer}</span>
              </div>
              <p class="mt-1 text-xs text-zinc-400">{c.highlight}</p>
            </div>
            <div class="text-right shrink-0">
              <p class="text-xs text-zinc-500">연회비</p>
              <p class="font-bold">{c.annualFee === 0 ? '무료' : `₩${c.annualFee.toLocaleString()}`}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <AffiliateDisclosure />
</Layout>

<script is:inline define:vars={{ cards }}>
  function calcMonthlyBenefit(card, spend) {
    let raw = 0;
    for (const [cat, amt] of Object.entries(spend)) {
      const rate = card.benefits[cat] || 0;
      raw += (amt * rate) / 100;
    }
    // Apply monthly cap if set
    const cap = card.benefits.monthlyCap;
    return cap && cap > 0 ? Math.min(raw, cap) : raw;
  }

  document.getElementById('calc-btn').addEventListener('click', () => {
    const spend = {};
    document.querySelectorAll('.cat-input').forEach((i) => {
      const cat = i.getAttribute('data-cat');
      const v = parseInt(i.value, 10);
      if (!isNaN(v) && v > 0) spend[cat] = v;
    });

    const totalSpend = Object.values(spend).reduce((a, b) => a + b, 0);
    if (totalSpend === 0) {
      alert('카테고리 1개 이상 입력하세요.');
      return;
    }

    const ranked = cards.map((c) => {
      const monthly = calcMonthlyBenefit(c, spend);
      const annual = monthly * 12 - c.annualFee;
      return { card: c, monthly, annual };
    }).sort((a, b) => b.annual - a.annual).slice(0, 3);

    const results = document.getElementById('results');
    results.innerHTML = `
      <h2 class="text-2xl font-black mb-4">추천 카드 — 연간 이득 순</h2>
      <p class="mb-4 text-sm text-zinc-400">
        본인 입력 월 ₩${totalSpend.toLocaleString()} 기준
      </p>
      <div class="space-y-3">
        ${ranked.map((r, i) => `
          <a href="${r.card.url}" target="_blank" rel="sponsored noopener" data-card-name="${r.card.name}" class="card-link block rounded-2xl border ${i === 0 ? 'border-amber-500/50 bg-amber-500/5' : 'border-zinc-800 bg-zinc-900/40'} p-6 hover:border-amber-500/70 transition">
            ${i === 0 ? `<div class="text-[10px] font-black uppercase tracking-widest text-amber-300 mb-2">★ 최적</div>` : ''}
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 min-w-0">
                <p class="text-xs text-zinc-500">${r.card.issuer}</p>
                <h3 class="mt-1 text-xl font-black text-white">${r.card.name}</h3>
                <p class="mt-2 text-sm text-zinc-300">${r.card.highlight}</p>
              </div>
              <div class="text-right shrink-0">
                <p class="text-[10px] text-zinc-500">연 이득 추정</p>
                <p class="text-2xl font-black ${r.annual > 0 ? 'text-emerald-300' : 'text-zinc-400'}">₩${Math.round(r.annual).toLocaleString()}</p>
                <p class="text-[10px] text-zinc-500 mt-1">월 ₩${Math.round(r.monthly).toLocaleString()} − 연회비</p>
              </div>
            </div>
          </a>
        `).join('')}
      </div>
      <p class="mt-5 text-xs text-zinc-500 leading-relaxed">
        ※ 추정치 — 카드사 한도·실적 조건 충족 가정. 실제 발급 전 카드사 공식 페이지에서 최종 확인 권장.
        해외결제·OTT·배달 카테고리 5만원 미만이면 일반 1.5% 카드(현대 ZERO 등)가 더 유리한 경우 있음.
      </p>
    `;
    results.classList.remove('hidden');
    results.scrollIntoView({ behavior: 'smooth', block: 'start' });

    if (window.va) { try { window.va('event', { name: 'card_pick_calc', data: { totalSpend, top: ranked[0].card.name } }); } catch (_) {} }
    if (window.gtag) { try { window.gtag('event', 'card_pick_calc', { value: totalSpend, top: ranked[0].card.name, event_category: 'tools' }); } catch (_) {} }
  });

  document.addEventListener('click', (e) => {
    const a = e.target.closest && e.target.closest('a.card-link');
    if (!a) return;
    const card = a.getAttribute('data-card-name');
    if (window.va) { try { window.va('event', { name: 'card_outbound', data: { card } }); } catch (_) {} }
    if (window.gtag) { try { window.gtag('event', 'card_outbound', { card, event_category: 'monetization' }); } catch (_) {} }
  });
</script>
