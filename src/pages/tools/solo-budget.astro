---
/**
 * /tools/solo-budget — 자취 월별 예산 계산.
 *
 * 한국 청년 매우 큰 검색량: "자취 생활비", "자취 월세", "1인가구 생활비"
 */
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="자취 월별 예산 계산기 — 1인가구 생활비 평균 + 본인 시뮬"
  description="월세·관리비·공과금·식비·교통·통신 8개 항목 입력 → 월 총 예산. 한국 1인가구 평균과 자동 비교."
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-500/5 px-3 py-1 text-xs text-cyan-300">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
      1인가구 평균 비교
    </div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight">
      <span class="text-gradient">자취</span> 월 예산
    </h1>
    <p class="mt-4 text-lg text-zinc-400 leading-relaxed">8개 항목 입력 → 월 총 + 절약 가능액 + 평균 대비.</p>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-3" id="form"></div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-2">
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border border-cyan-500/40 bg-gradient-to-br from-cyan-500/15 to-blue-500/5 p-5">
        <p class="text-[10px] font-bold text-cyan-300 uppercase tracking-widest">월 총 예산</p>
        <p id="r-monthly" class="mt-2 text-3xl font-black text-white tabular-nums">-</p>
      </div>
      <div class="rounded-2xl border border-emerald-500/40 bg-gradient-to-br from-emerald-500/15 to-cyan-500/5 p-5">
        <p class="text-[10px] font-bold text-emerald-300 uppercase tracking-widest">연간 총</p>
        <p id="r-annual" class="mt-2 text-3xl font-black text-emerald-300 tabular-nums">-</p>
      </div>
    </div>
    <p id="r-vs-avg" class="mt-4 text-sm text-zinc-300"></p>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
      <h2 class="font-black mb-3">한국 1인가구 월 평균 (2026)</h2>
      <ul class="space-y-2 text-sm text-zinc-300">
        <li>→ <strong>총 평균</strong>: 월 ₩140만 (서울 ₩160만 / 지방 ₩110만)</li>
        <li>→ <strong>월세</strong>: 서울 1인 원룸 ₩50–80만 / 지방 ₩30–50만</li>
        <li>→ <strong>관리비</strong>: ₩5–15만 (오피스텔 더 비쌈)</li>
        <li>→ <strong>식비</strong>: 자취 ₩30–50만 / 배달 늘면 ₩50–80만</li>
        <li>→ <strong>교통비</strong>: ₩10–20만 (대중교통) / ₩30–50만 (차량)</li>
        <li>→ <strong>통신비</strong>: 알뜰폰 ₩2만 / 메이저 3사 ₩5–10만</li>
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-xl border border-amber-500/30 bg-amber-500/5 p-5 text-sm text-zinc-300">
      <p class="font-bold text-amber-300 mb-2">💡 청년이 받을 수 있는 지원</p>
      <ul class="space-y-1 text-xs">
        <li>→ <strong>청년 월세 한시 특별지원</strong>: 월 최대 ₩20만 × 12개월</li>
        <li>→ <strong>버팀목 전세자금대출</strong>: 청년 2.0% 우대 금리</li>
        <li>→ <strong>청년 주택드림 청약통장</strong>: 분양가 80% 대출 (저금리)</li>
        <li>→ <strong>청년 도약계좌</strong>: 월 70만 5년 + 정부 매칭 + 비과세</li>
      </ul>
      <a href="/jeonse/" class="mt-3 inline-block text-xs text-cyan-300 hover:text-cyan-200 underline">전세사기 방지 가이드 →</a>
    </div>
  </section>
</Layout>

<script is:inline>
  const items = [
    { id: 'rent', name: '월세', avg: 500000, default: 500000 },
    { id: 'mgmt', name: '관리비 + 공과금 (전기·가스·수도)', avg: 150000, default: 150000 },
    { id: 'food', name: '식비 (장보기·배달·외식)', avg: 400000, default: 400000 },
    { id: 'transit', name: '교통비', avg: 100000, default: 100000 },
    { id: 'phone', name: '통신비', avg: 60000, default: 60000 },
    { id: 'sub', name: 'OTT·구독서비스 (넷플·디플 등)', avg: 30000, default: 30000 },
    { id: 'beauty', name: '미용·옷·생활용품', avg: 100000, default: 100000 },
    { id: 'leisure', name: '여가·취미·외출', avg: 100000, default: 100000 },
  ];
  const totalAvg = items.reduce((s, i) => s + i.avg, 0);

  const form = document.getElementById('form');
  form.innerHTML = items.map((i) => `
    <label class="block">
      <span class="block text-xs font-bold text-zinc-300 mb-1.5">${i.name} <span class="text-zinc-500 text-[10px]">(평균 ₩${Math.round(i.avg/10000).toLocaleString()}만)</span></span>
      <input data-id="${i.id}" type="number" value="${i.default}" step="10000" class="cost-input w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-4 py-2.5 text-white tabular-nums" />
    </label>
  `).join('');

  function calc() {
    let total = 0;
    document.querySelectorAll('.cost-input').forEach((el) => { total += +el.value || 0; });
    document.getElementById('r-monthly').textContent = '₩' + total.toLocaleString('ko-KR');
    document.getElementById('r-annual').textContent = '₩' + (total * 12).toLocaleString('ko-KR');
    const diff = total - totalAvg;
    const pct = (diff / totalAvg * 100).toFixed(1);
    if (diff > 0) {
      document.getElementById('r-vs-avg').innerHTML = `1인가구 평균 (₩${totalAvg.toLocaleString()}) 대비 <strong class="text-rose-300">${pct}% 많음</strong> — 식비/여가 점검`;
    } else if (diff < 0) {
      document.getElementById('r-vs-avg').innerHTML = `평균 대비 <strong class="text-emerald-300">${Math.abs(pct)}% 절약</strong>`;
    } else {
      document.getElementById('r-vs-avg').textContent = '평균과 동일';
    }
    if (window.va) { try { window.va('event', { name: 'solo_budget', data: { total } }); } catch (_) {} }
  }
  document.querySelectorAll('.cost-input').forEach((el) => el.addEventListener('input', calc));
  calc();
</script>
