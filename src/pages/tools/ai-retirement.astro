---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="AI 노후 자금 시뮬레이터 — 충분성 + 절감 + 투자 전략" description="현재 자산·저축 입력 → Gemini가 노후 자금 충분성 + 부족액 + 전략 + 추천 포트폴리오 자동.">
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/5 px-3 py-1 text-xs text-emerald-300">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Gemini — 노후 시뮬
    </div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight"><span class="text-gradient">AI 노후 자금</span></h1>
    <p class="mt-4 text-lg text-zinc-400">충분성 + 전략 + 포트폴리오.</p>
  </section>
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-3">
      <div class="grid sm:grid-cols-3 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">현재 나이</span><input id="age" type="number" value="35" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">은퇴 목표</span><input id="retireAge" type="number" value="65" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">기대 수명</span><input id="lifeExpectancy" type="number" value="85" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">현재 총 자산 (₩)</span><input id="currentAssets" type="number" value="100000000" step="10000000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-2.5 text-white tabular-nums" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">월 소득 (₩)</span><input id="monthlyIncome" type="number" value="4000000" step="100000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-2.5 text-white tabular-nums" /></label>
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">월 저축액 (₩)</span><input id="monthlySaving" type="number" value="1000000" step="100000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-2.5 text-white tabular-nums" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">노후 월 필요 생활비 (₩)</span><input id="targetMonthlyCost" type="number" value="3000000" step="100000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-2.5 text-white tabular-nums" /></label>
      </div>
      <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">주택 보유</span><select id="homeOwnership" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-2.5 text-white"><option>무주택</option><option>1주택 (자가)</option><option>다주택</option></select></label>
      <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">가입 연금 (콤마 구분)</span><input id="pensionEnrolled" type="text" value="국민연금" placeholder="예: 국민연금, 퇴직연금, 연금저축, IRP" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-2.5 text-white" /></label>
      <button id="go" type="button" class="w-full rounded-lg bg-emerald-500 hover:bg-emerald-400 text-white font-black py-3 disabled:opacity-50">AI 노후 시뮬</button>
      <p id="status" class="text-xs text-zinc-400 text-center"></p>
    </div>
  </section>
  <section id="result" class="hidden mx-auto max-w-3xl px-4 py-2 space-y-3">
    <div id="box" class="rounded-3xl border-2 p-8">
      <p class="text-[10px] font-bold uppercase tracking-widest" id="lbl">은퇴 시 예상 자산</p>
      <p id="projected" class="mt-2 text-5xl font-black tabular-nums">-</p>
      <p id="verdict" class="mt-2 text-2xl font-black">-</p>
      <div class="mt-3 grid grid-cols-3 gap-2 text-sm">
        <div><p class="text-[10px] text-zinc-400">충당 가능</p><p id="monthsCovered" class="font-black">-</p></div>
        <div><p class="text-[10px] text-zinc-400">부족/잉여</p><p id="shortfall" class="font-black tabular-nums">-</p></div>
        <div><p class="text-[10px] text-zinc-400">남은 시간</p><p id="years" class="font-black">-</p></div>
      </div>
    </div>
    <h3 class="text-xl font-black text-emerald-300">전략</h3>
    <div id="strategies" class="space-y-3"></div>
    <div class="rounded-2xl border border-cyan-500/40 bg-cyan-500/5 p-5"><h4 class="text-xs font-black text-cyan-300 uppercase tracking-widest mb-3">📊 권장 자산 배분</h4><div id="allocation" class="grid grid-cols-5 gap-2 text-center"></div></div>
    <div class="rounded-2xl border border-zinc-700 bg-zinc-900/40 p-5"><h4 class="text-xs font-black text-zinc-300 uppercase tracking-widest mb-3">현재 포트폴리오 평가</h4><p id="portfolio" class="text-sm text-zinc-300"></p></div>
    <div class="rounded-2xl border border-rose-500/40 bg-rose-500/5 p-5"><h4 class="text-xs font-black text-rose-300 uppercase tracking-widest mb-3">⚠ 주의</h4><ul id="warnings" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
  </section>
</Layout>
<script is:inline>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const fmt = (n) => '₩' + (+(n || '0').toString().replace(/[^\d]/g,'')).toLocaleString('ko-KR');
  $('go').addEventListener('click', async () => {
    if (!+$('age').value) { $('status').textContent = '⚠ 나이 필수'; $('status').className = 'text-xs text-rose-300 text-center'; return; }
    $('go').disabled = true; $('status').textContent = '🤖 노후 시뮬 중...'; $('status').className = 'text-xs text-emerald-300 text-center animate-pulse';
    const body = {};
    ['age','retireAge','currentAssets','monthlySaving','monthlyIncome','targetMonthlyCost','homeOwnership','lifeExpectancy'].forEach((id) => { body[id] = $(id).value; });
    body.pensionEnrolled = $('pensionEnrolled').value.split(',').map(s => s.trim()).filter(Boolean);
    try {
      const res = await fetch('/api/ai-retirement', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const data = await res.json();
      if (!data.ok) { $('status').textContent = '❌ ' + data.error; $('status').className = 'text-xs text-rose-300 text-center'; $('go').disabled = false; return; }
      $('result').classList.remove('hidden'); $('status').textContent = '✓ 완료'; $('status').className = 'text-xs text-emerald-300 text-center';
      const v = data.verdict || '-';
      let color = 'text-emerald-300', bg = 'border-emerald-500/40 bg-emerald-500/5';
      if (v === '위험') { color = 'text-rose-300'; bg = 'border-rose-500/40 bg-rose-500/10'; }
      else if (v === '부족') { color = 'text-orange-300'; bg = 'border-orange-500/40 bg-orange-500/5'; }
      else if (v === '보통') { color = 'text-amber-300'; bg = 'border-amber-500/40 bg-amber-500/5'; }
      $('box').className = 'rounded-3xl border-2 p-8 ' + bg;
      $('lbl').className = 'text-[10px] font-bold uppercase tracking-widest ' + color;
      $('projected').className = 'mt-2 text-5xl font-black tabular-nums ' + color;
      $('verdict').className = 'mt-2 text-2xl font-black ' + color;
      $('projected').textContent = fmt(data.projectedTotalAtRetirement);
      $('verdict').textContent = v;
      $('monthsCovered').textContent = data.monthsCovered || '-';
      $('shortfall').textContent = fmt(data.shortfallOrSurplus);
      $('years').textContent = (data.yearsToRetirement || '-') + '년';
      $('strategies').innerHTML = (data.strategies || []).map((s) => `<div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-5">
        <div class="flex items-start justify-between mb-2"><h4 class="font-black text-white">${esc(s.title || '')}</h4><span class="text-xs font-black px-2 py-0.5 rounded bg-emerald-500 text-white">${fmt(s.expectedImpact)}</span></div>
        <p class="text-sm text-zinc-300 mb-2">${esc(s.action || '')}</p>
        <span class="text-xs text-zinc-500">난이도: ${esc(s.difficulty || '')}</span>
      </div>`).join('');
      const alloc = data.recommendedAllocation || {};
      $('allocation').innerHTML = Object.entries(alloc).map(([k, v]) => `<div class="rounded-lg bg-zinc-900/60 p-2"><p class="text-[10px] text-zinc-400">${esc(k)}</p><p class="text-base font-black tabular-nums">${esc(String(v))}</p></div>`).join('');
      $('portfolio').textContent = data.currentPortfolio || '';
      $('warnings').innerHTML = (data.warnings || []).map((x) => `<li>${esc(x)}</li>`).join('');
      if (window.va) { try { window.va('event', { name: 'ai_retirement' }); } catch (_) {} }
    } catch (e) { $('status').textContent = '❌ ' + e.message; $('status').className = 'text-xs text-rose-300 text-center'; }
    finally { $('go').disabled = false; }
  });
</script>
