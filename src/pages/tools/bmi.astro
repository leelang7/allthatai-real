---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="BMI 계산기 + 일일 칼로리 — 한국 기준 비만도 / 기초대사량"
  description="키·체중·나이·성별 입력 → BMI 비만도 + 기초대사량 (BMR) + 일일 권장 칼로리. 한국인 기준 (대한비만학회)."
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-500/5 px-3 py-1 text-xs text-cyan-300">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
      대한비만학회 기준
    </div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight">
      <span class="text-gradient">BMI</span> + 일일 칼로리
    </h1>
    <p class="mt-4 text-lg text-zinc-400 leading-relaxed">
      비만도 + 기초대사량 + 활동량별 권장 칼로리.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 grid grid-cols-2 sm:grid-cols-4 gap-3">
      <label class="block">
        <span class="block text-xs font-bold text-zinc-300 mb-1.5">키 (cm)</span>
        <input id="height" type="number" value="170" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-3 py-2.5 text-white" />
      </label>
      <label class="block">
        <span class="block text-xs font-bold text-zinc-300 mb-1.5">체중 (kg)</span>
        <input id="weight" type="number" value="65" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-3 py-2.5 text-white" />
      </label>
      <label class="block">
        <span class="block text-xs font-bold text-zinc-300 mb-1.5">나이</span>
        <input id="age" type="number" value="30" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-3 py-2.5 text-white" />
      </label>
      <label class="block">
        <span class="block text-xs font-bold text-zinc-300 mb-1.5">성별</span>
        <select id="sex" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-3 py-2.5 text-white">
          <option value="m">남성</option>
          <option value="f">여성</option>
        </select>
      </label>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-2">
    <div class="grid sm:grid-cols-2 gap-4">
      <div class="rounded-2xl border border-cyan-500/40 bg-gradient-to-br from-cyan-500/15 to-blue-500/5 p-6">
        <p class="text-[10px] font-bold text-cyan-300 uppercase tracking-widest">BMI</p>
        <p id="r-bmi" class="mt-2 text-6xl font-black text-white tabular-nums">-</p>
        <p id="r-bmi-cat" class="mt-3 text-sm font-bold"></p>
        <p id="r-bmi-detail" class="mt-1 text-xs text-zinc-400"></p>
      </div>
      <div class="rounded-2xl border border-emerald-500/40 bg-gradient-to-br from-emerald-500/15 to-cyan-500/5 p-6">
        <p class="text-[10px] font-bold text-emerald-300 uppercase tracking-widest">기초대사량 (BMR)</p>
        <p id="r-bmr" class="mt-2 text-6xl font-black text-white tabular-nums">-</p>
        <p class="mt-3 text-xs text-zinc-400">kcal/일 — 가만히 있어도 소비</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-6">
    <h2 class="text-sm font-black text-zinc-400 mb-3 uppercase tracking-widest">활동량별 일일 권장 kcal</h2>
    <div id="tdee-grid" class="grid grid-cols-2 sm:grid-cols-5 gap-2"></div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
      <h2 class="font-black mb-3">BMI 기준 (대한비만학회 2018)</h2>
      <ul class="space-y-1.5 text-sm text-zinc-300">
        <li>→ <strong class="text-cyan-300">18.5 미만</strong>: 저체중</li>
        <li>→ <strong class="text-emerald-300">18.5–22.9</strong>: 정상</li>
        <li>→ <strong class="text-amber-300">23–24.9</strong>: 과체중</li>
        <li>→ <strong class="text-orange-300">25–29.9</strong>: 1단계 비만</li>
        <li>→ <strong class="text-rose-300">30–34.9</strong>: 2단계 비만</li>
        <li>→ <strong class="text-rose-400">35 이상</strong>: 3단계 비만 (고도비만)</li>
      </ul>
      <p class="mt-3 text-xs text-zinc-500">※ WHO 기준은 25부터 과체중. 한국·아시아인은 23부터 과체중 (체질 차이 반영)</p>
    </div>
  </section>
</Layout>

<script is:inline>
  const activities = [
    { name: '거의 안 함', mult: 1.2 },
    { name: '가벼움 (주 1–3 운동)', mult: 1.375 },
    { name: '보통 (주 3–5)', mult: 1.55 },
    { name: '활발 (주 6–7)', mult: 1.725 },
    { name: '매우 활발 (선수)', mult: 1.9 },
  ];

  function calc() {
    const h = parseFloat(document.getElementById('height').value);
    const w = parseFloat(document.getElementById('weight').value);
    const a = parseFloat(document.getElementById('age').value);
    const s = document.getElementById('sex').value;
    if (!h || !w || !a) return;

    const bmi = w / Math.pow(h / 100, 2);
    document.getElementById('r-bmi').textContent = bmi.toFixed(1);

    let cat, color, detail;
    if (bmi < 18.5) { cat = '저체중'; color = 'text-cyan-300'; detail = '체중을 늘릴 필요 있음. 단백질 + 충분한 칼로리.'; }
    else if (bmi < 23) { cat = '정상'; color = 'text-emerald-300'; detail = '건강한 범위. 현재 식습관 + 운동 유지.'; }
    else if (bmi < 25) { cat = '과체중'; color = 'text-amber-300'; detail = '한국 기준 과체중. 식습관 점검 권장.'; }
    else if (bmi < 30) { cat = '1단계 비만'; color = 'text-orange-300'; detail = '식이·운동 개선 필요. -5kg부터 목표.'; }
    else if (bmi < 35) { cat = '2단계 비만'; color = 'text-rose-300'; detail = '의료 상담 권장 (내분비·당뇨·고혈압 검진).'; }
    else { cat = '3단계 비만 (고도비만)'; color = 'text-rose-400'; detail = '의료 개입 권장. 비만 클리닉 또는 내분비내과.'; }

    const catEl = document.getElementById('r-bmi-cat');
    catEl.textContent = cat;
    catEl.className = 'mt-3 text-sm font-bold ' + color;
    document.getElementById('r-bmi-detail').textContent = detail;

    // Mifflin–St Jeor
    const bmr = Math.round(s === 'm'
      ? 10 * w + 6.25 * h - 5 * a + 5
      : 10 * w + 6.25 * h - 5 * a - 161);
    document.getElementById('r-bmr').textContent = bmr.toLocaleString('ko-KR');

    // TDEE grid
    const grid = document.getElementById('tdee-grid');
    grid.innerHTML = activities.map((act) => {
      const tdee = Math.round(bmr * act.mult);
      return `<div class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-3 text-center">
        <p class="text-[10px] text-zinc-500 leading-tight min-h-[2.4em]">${act.name}</p>
        <p class="mt-2 text-xl font-black text-white">${tdee.toLocaleString('ko-KR')}</p>
        <p class="text-[10px] text-zinc-500">kcal/일</p>
      </div>`;
    }).join('');

    if (window.va) { try { window.va('event', { name: 'bmi_calc', data: { bmi: bmi.toFixed(1) } }); } catch (_) {} }
    if (window.gtag) { try { window.gtag('event', 'bmi_calc', { value: bmi, event_category: 'tools' }); } catch (_) {} }
  }

  ['height', 'weight', 'age', 'sex'].forEach((id) => {
    document.getElementById(id).addEventListener('input', calc);
  });
  calc();
</script>
