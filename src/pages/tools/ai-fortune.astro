---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="AI 사주·운세 풀이 — 생년월일 기반 종합 운세" description="생년월일 입력 → Gemini가 사주 오행·직업운·재물운·애정운·올해 흐름·행운의 색·월 자동.">
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-purple-500/30 bg-purple-500/5 px-3 py-1 text-xs text-purple-300"><span class="inline-block w-1.5 h-1.5 rounded-full bg-purple-400"></span>Gemini — 사주 풀이</div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight"><span class="text-gradient">AI 사주·운세</span></h1>
    <p class="mt-4 text-lg text-zinc-400">오행 + 직업·재물·애정·건강.</p>
  </section>
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-3">
      <div class="grid sm:grid-cols-3 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">생년월일 *</span><input id="birthDate" type="date" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-purple-500 outline-none px-4 py-2.5 text-white" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">출생 시간</span><input id="birthTime" type="time" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-purple-500 outline-none px-4 py-2.5 text-white" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">성별</span><select id="gender" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-purple-500 outline-none px-3 py-2 text-white"><option></option><option>남</option><option>여</option></select></label>
      </div>
      <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">관심사</span><select id="focus" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-purple-500 outline-none px-4 py-2.5 text-white"><option value="all">전반</option><option value="career">직업·재물</option><option value="love">애정·결혼</option><option value="health">건강</option></select></label>
      <button id="go" type="button" class="w-full rounded-lg bg-purple-500 hover:bg-purple-400 text-white font-black py-3 disabled:opacity-50">AI 사주 풀이</button>
      <p id="status" class="text-xs text-zinc-400 text-center"></p>
      <p class="text-[10px] text-zinc-500 text-center">⚠ 엔터테인먼트·자기성찰 목적</p>
    </div>
  </section>
  <section id="result" class="hidden mx-auto max-w-3xl px-4 py-2 space-y-3">
    <div class="rounded-3xl border-2 border-purple-500/40 bg-gradient-to-br from-purple-500/15 to-fuchsia-500/5 p-8">
      <p class="text-[10px] font-bold text-purple-300 uppercase tracking-widest">종합 사주</p>
      <p id="summary" class="mt-2 text-lg text-zinc-200"></p>
      <p id="elements" class="mt-3 text-sm font-bold text-fuchsia-300"></p>
    </div>
    <div class="grid sm:grid-cols-4 gap-3">
      <div class="rounded-2xl border border-emerald-500/40 bg-emerald-500/5 p-5"><h4 class="text-xs font-black text-emerald-300 uppercase tracking-widest mb-2">💼 직업운</h4><p id="career" class="text-sm text-zinc-300"></p></div>
      <div class="rounded-2xl border border-amber-500/40 bg-amber-500/5 p-5"><h4 class="text-xs font-black text-amber-300 uppercase tracking-widest mb-2">💰 재물운</h4><p id="wealth" class="text-sm text-zinc-300"></p></div>
      <div class="rounded-2xl border border-rose-500/40 bg-rose-500/5 p-5"><h4 class="text-xs font-black text-rose-300 uppercase tracking-widest mb-2">❤️ 애정운</h4><p id="love" class="text-sm text-zinc-300"></p></div>
      <div class="rounded-2xl border border-cyan-500/40 bg-cyan-500/5 p-5"><h4 class="text-xs font-black text-cyan-300 uppercase tracking-widest mb-2">🌱 건강운</h4><p id="health" class="text-sm text-zinc-300"></p></div>
    </div>
    <div class="rounded-2xl border border-violet-500/40 bg-violet-500/5 p-5"><h4 class="text-xs font-black text-violet-300 uppercase tracking-widest mb-3">📅 올해 (2026) 흐름</h4><p id="thisYear" class="text-sm text-zinc-200"></p></div>
    <div class="grid sm:grid-cols-3 gap-3">
      <div class="rounded-2xl border border-pink-500/40 bg-pink-500/5 p-5"><h4 class="text-xs font-black text-pink-300 uppercase tracking-widest mb-2">🍀 행운의 달</h4><p id="luckyMonths" class="text-sm font-black text-zinc-200"></p></div>
      <div class="rounded-2xl border border-pink-500/40 bg-pink-500/5 p-5"><h4 class="text-xs font-black text-pink-300 uppercase tracking-widest mb-2">🎨 행운의 색</h4><p id="luckyColors" class="text-sm font-black text-zinc-200"></p></div>
      <div class="rounded-2xl border border-pink-500/40 bg-pink-500/5 p-5"><h4 class="text-xs font-black text-pink-300 uppercase tracking-widest mb-2">🧭 행운의 방향</h4><p id="luckyDirections" class="text-sm font-black text-zinc-200"></p></div>
    </div>
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border border-emerald-500/40 bg-emerald-500/5 p-5"><h4 class="text-xs font-black text-emerald-300 uppercase tracking-widest mb-3">👍 강점</h4><ul id="strengths" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
      <div class="rounded-2xl border border-rose-500/40 bg-rose-500/5 p-5"><h4 class="text-xs font-black text-rose-300 uppercase tracking-widest mb-3">⚠ 주의 영역</h4><ul id="weaknesses" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
    </div>
    <div class="rounded-2xl border border-zinc-700 bg-zinc-900/40 p-5"><h4 class="text-xs font-black text-zinc-300 uppercase tracking-widest mb-3">💬 조언</h4><ul id="advice" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
  </section>
</Layout>
<script is:inline>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  $('go').addEventListener('click', async () => {
    if (!$('birthDate').value) { $('status').textContent = '⚠ 생년월일 필수'; $('status').className = 'text-xs text-rose-300 text-center'; return; }
    $('go').disabled = true; $('status').textContent = '🤖 사주 풀이 중...'; $('status').className = 'text-xs text-purple-300 text-center animate-pulse';
    try {
      const res = await fetch('/api/ai-fortune', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ birthDate: $('birthDate').value, birthTime: $('birthTime').value, gender: $('gender').value, focus: $('focus').value }) });
      const data = await res.json();
      if (!data.ok) { $('status').textContent = '❌ ' + data.error; $('status').className = 'text-xs text-rose-300 text-center'; $('go').disabled = false; return; }
      $('result').classList.remove('hidden'); $('status').textContent = '✓ 완료'; $('status').className = 'text-xs text-emerald-300 text-center';
      $('summary').textContent = data.summary || '';
      $('elements').textContent = '오행: ' + ((data.elements || {}).오행 || '-');
      $('career').textContent = data.career || ''; $('wealth').textContent = data.wealth || '';
      $('love').textContent = data.love || ''; $('health').textContent = data.health || '';
      $('thisYear').textContent = data.thisYear || '';
      $('luckyMonths').textContent = (data.luckyMonths || []).join(', ') + '월';
      $('luckyColors').textContent = (data.luckyColors || []).join(', ');
      $('luckyDirections').textContent = (data.luckyDirections || []).join(', ');
      $('strengths').innerHTML = (data.strengths || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('weaknesses').innerHTML = (data.weaknesses || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('advice').innerHTML = (data.advice || []).map((x) => `<li>${esc(x)}</li>`).join('');
      if (window.va) { try { window.va('event', { name: 'ai_fortune' }); } catch (_) {} }
    } catch (e) { $('status').textContent = '❌ ' + e.message; $('status').className = 'text-xs text-rose-300 text-center'; }
    finally { $('go').disabled = false; }
  });
</script>
