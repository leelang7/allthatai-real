---
/**
 * /tools/salary-calc — 연봉 실수령액 계산기 (2026 기준).
 *
 * 한국 검색량 top 5 키워드: "연봉 실수령액 계산기", "월 실수령액", "세후 연봉"
 * 광고 단가 매우 높음 (재테크·금융 카테고리).
 *
 * 계산: 연봉 → 월 세전 → 4대보험 + 소득세 + 지방세 차감 → 실수령액.
 * 2026 기준 (변경 시 weekly cron 또는 수동 업데이트).
 */
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="연봉 실수령액 계산기 2026 — 세후 월급 + 4대보험 계산"
  description="연봉 입력 → 월 실수령액 즉시 계산. 4대보험(국민연금·건강보험·고용보험·장기요양)·소득세·지방세 자동 차감. 2026년 기준."
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/5 px-3 py-1 text-xs text-emerald-300">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      2026 기준
    </div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight">
      연봉 → <span class="text-gradient">월 실수령액</span>
    </h1>
    <p class="mt-4 text-lg text-zinc-400 leading-relaxed">
      연봉 입력하면 4대보험 + 소득세 + 지방세 자동 차감. 비과세·부양가족 옵션 포함.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
      <div class="grid sm:grid-cols-2 gap-4">
        <label class="block sm:col-span-2">
          <span class="block text-xs font-bold text-zinc-300 mb-1.5">연봉 (세전, ₩)</span>
          <input
            id="salary"
            type="number"
            value="40000000"
            step="1000000"
            class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-3 text-2xl font-black text-white tabular-nums"
          />
        </label>
        <label class="block">
          <span class="block text-xs font-bold text-zinc-300 mb-1.5">비과세 (월, ₩)</span>
          <input
            id="nontax"
            type="number"
            value="200000"
            step="10000"
            class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-2.5 text-white"
          />
          <span class="block text-[10px] text-zinc-500 mt-1">식대·차량유지비 등 (최대 월 ₩20만)</span>
        </label>
        <label class="block">
          <span class="block text-xs font-bold text-zinc-300 mb-1.5">부양가족 (본인 포함)</span>
          <input
            id="dependents"
            type="number"
            value="1"
            min="1"
            max="10"
            class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-2.5 text-white"
          />
        </label>
        <label class="block">
          <span class="block text-xs font-bold text-zinc-300 mb-1.5">20세 이하 자녀 수</span>
          <input
            id="children"
            type="number"
            value="0"
            min="0"
            max="10"
            class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-2.5 text-white"
          />
        </label>
      </div>
    </div>
  </section>

  <!-- RESULT -->
  <section class="mx-auto max-w-3xl px-4 py-4">
    <div class="rounded-2xl border border-emerald-500/40 bg-gradient-to-br from-emerald-500/15 to-cyan-500/5 p-8">
      <p class="text-[10px] font-bold text-emerald-300 uppercase tracking-widest">월 실수령액</p>
      <p id="result-monthly" class="mt-2 text-5xl sm:text-6xl font-black text-white tabular-nums">₩-</p>
      <p id="result-annual" class="mt-2 text-sm text-zinc-400">연 실수령 -</p>
    </div>
  </section>

  <!-- BREAKDOWN -->
  <section class="mx-auto max-w-3xl px-4 py-4">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 overflow-hidden">
      <div class="px-5 py-3 border-b border-zinc-800 bg-zinc-900/60">
        <p class="text-sm font-black">차감 내역 (월 기준)</p>
      </div>
      <div class="divide-y divide-zinc-800">
        <div class="flex justify-between px-5 py-3"><span class="text-sm text-zinc-400">월 세전</span><span id="b-gross" class="font-bold tabular-nums">₩-</span></div>
        <div class="flex justify-between px-5 py-3"><span class="text-sm text-rose-300">국민연금 (4.5%)</span><span id="b-pension" class="font-bold text-rose-300 tabular-nums">-</span></div>
        <div class="flex justify-between px-5 py-3"><span class="text-sm text-rose-300">건강보험 (3.545%)</span><span id="b-health" class="font-bold text-rose-300 tabular-nums">-</span></div>
        <div class="flex justify-between px-5 py-3"><span class="text-sm text-rose-300">장기요양 (건강의 12.81%)</span><span id="b-care" class="font-bold text-rose-300 tabular-nums">-</span></div>
        <div class="flex justify-between px-5 py-3"><span class="text-sm text-rose-300">고용보험 (0.9%)</span><span id="b-unemp" class="font-bold text-rose-300 tabular-nums">-</span></div>
        <div class="flex justify-between px-5 py-3"><span class="text-sm text-rose-300">소득세 (간이세액표)</span><span id="b-income" class="font-bold text-rose-300 tabular-nums">-</span></div>
        <div class="flex justify-between px-5 py-3"><span class="text-sm text-rose-300">지방소득세 (소득세 10%)</span><span id="b-local" class="font-bold text-rose-300 tabular-nums">-</span></div>
        <div class="flex justify-between px-5 py-3 bg-zinc-900/60"><span class="text-sm font-bold text-rose-300">총 공제</span><span id="b-total" class="font-bold text-rose-300 tabular-nums">-</span></div>
        <div class="flex justify-between px-5 py-3 bg-emerald-500/10"><span class="text-sm font-black text-emerald-300">월 실수령</span><span id="b-net" class="font-black text-emerald-300 tabular-nums">-</span></div>
      </div>
    </div>
  </section>

  <!-- DISCLAIMER + RELATED -->
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-xl border border-amber-500/30 bg-amber-500/5 p-5 text-sm text-zinc-300">
      <p class="font-bold text-amber-300 mb-1">⓲ 추정치</p>
      <p class="text-xs leading-relaxed">
        실제 세액은 부양가족 공제·연말정산·신용카드/체크카드 공제·기부금 등에 따라 변동.
        본 계산은 <strong>2026년 간이세액표</strong> 기준 매월 원천징수 추정. 정확한 환급/추징은
        다음해 2월 연말정산 결과로 확정.
      </p>
    </div>

    <div class="mt-4 grid sm:grid-cols-2 gap-3">
      <a href="/tools/card-pick/" class="rounded-xl border border-zinc-800 hover:border-cyan-500/40 bg-zinc-900/40 p-4 transition">
        <p class="font-bold">신용카드 추천 계산기</p>
        <p class="mt-1 text-xs text-zinc-500">월 소비 패턴 → 최고 캐시백</p>
      </a>
      <a href="/tools/ai-pricing/" class="rounded-xl border border-zinc-800 hover:border-cyan-500/40 bg-zinc-900/40 p-4 transition">
        <p class="font-bold">AI 도구 비용 계산</p>
        <p class="mt-1 text-xs text-zinc-500">Claude·GPT·Cursor 조합 추천</p>
      </a>
    </div>
  </section>
</Layout>

<script is:inline>
  // 2026 간이세액표 — 1인 가구 기준 근사치
  // (실제 표는 매우 길어서 구간별 선형 근사)
  function incomeTaxMonthly(taxableMonthly, dependents, children) {
    // 비과세 제외 후 과세 대상 월급
    // 간이세액표는 부양가족 수에 따라 다름 — 본인 1, 자녀 추가 1씩 카운트
    const family = dependents + children * 1;
    // 표 근사 (₩백만 단위, 1인 가구):
    // 250만: 3만 / 300만: 7만 / 350만: 12만 / 400만: 18만 / 500만: 33만 / 600만: 50만 / 700만: 70만 / 1000만: 130만
    // 다인가구는 약 -5%~30% 감면 (대략)
    let base;
    const t = taxableMonthly;
    if (t < 2000000) base = 0;
    else if (t < 2500000) base = (t - 2000000) * 0.06;
    else if (t < 3000000) base = 30000 + (t - 2500000) * 0.08;
    else if (t < 3500000) base = 70000 + (t - 3000000) * 0.10;
    else if (t < 4000000) base = 120000 + (t - 3500000) * 0.12;
    else if (t < 5000000) base = 180000 + (t - 4000000) * 0.15;
    else if (t < 6000000) base = 330000 + (t - 5000000) * 0.17;
    else if (t < 7000000) base = 500000 + (t - 6000000) * 0.20;
    else if (t < 8500000) base = 700000 + (t - 7000000) * 0.225;
    else if (t < 10000000) base = 1037500 + (t - 8500000) * 0.24;
    else base = 1397500 + (t - 10000000) * 0.275;

    // 부양가족 공제 (간단 근사)
    const familyDiscount = Math.min(0.30, (family - 1) * 0.08);
    base = base * (1 - familyDiscount);

    return Math.max(0, Math.round(base));
  }

  function fmt(n) { return '₩' + Math.round(n).toLocaleString('ko-KR'); }

  function calc() {
    const salary = Math.max(0, parseInt(document.getElementById('salary').value, 10) || 0);
    const nontax = Math.min(200000, Math.max(0, parseInt(document.getElementById('nontax').value, 10) || 0));
    const dependents = Math.max(1, Math.min(10, parseInt(document.getElementById('dependents').value, 10) || 1));
    const children = Math.max(0, Math.min(10, parseInt(document.getElementById('children').value, 10) || 0));

    const monthGross = Math.round(salary / 12);
    const monthTaxable = Math.max(0, monthGross - nontax); // 4대보험 + 소득세 기준

    // 국민연금 4.5% (상한 590만, 하한 39만)
    const pensionBase = Math.min(5900000, Math.max(390000, monthTaxable));
    const pension = Math.round(pensionBase * 0.045);

    // 건강보험 3.545% (상한 약 8800만 기준 — 단순화: 동일 base)
    const health = Math.round(monthTaxable * 0.03545);
    const care = Math.round(health * 0.1281);

    // 고용보험 0.9%
    const unemp = Math.round(monthTaxable * 0.009);

    const income = incomeTaxMonthly(monthTaxable, dependents, children);
    const local = Math.round(income * 0.10);

    const totalDeduct = pension + health + care + unemp + income + local;
    const net = monthGross - totalDeduct;
    const netAnnual = net * 12;

    document.getElementById('result-monthly').textContent = fmt(net);
    document.getElementById('result-annual').textContent = '연 실수령 ' + fmt(netAnnual);
    document.getElementById('b-gross').textContent = fmt(monthGross);
    document.getElementById('b-pension').textContent = '−' + fmt(pension);
    document.getElementById('b-health').textContent = '−' + fmt(health);
    document.getElementById('b-care').textContent = '−' + fmt(care);
    document.getElementById('b-unemp').textContent = '−' + fmt(unemp);
    document.getElementById('b-income').textContent = '−' + fmt(income);
    document.getElementById('b-local').textContent = '−' + fmt(local);
    document.getElementById('b-total').textContent = '−' + fmt(totalDeduct);
    document.getElementById('b-net').textContent = fmt(net);

    if (window.va) { try { window.va('event', { name: 'salary_calc', data: { salary } }); } catch (_) {} }
    if (window.gtag) { try { window.gtag('event', 'salary_calc', { salary, event_category: 'tools' }); } catch (_) {} }
  }

  ['salary', 'nontax', 'dependents', 'children'].forEach((id) => {
    document.getElementById(id).addEventListener('input', calc);
  });
  calc();
</script>
