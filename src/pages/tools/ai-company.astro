---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="AI 회사 분석 — 평판·연봉·문화·전망 자동" description="회사명 + 직무 입력 → Gemini가 연봉 범위·복지·문화·장단점·면접 팁 자동.">
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/5 px-3 py-1 text-xs text-indigo-300"><span class="inline-block w-1.5 h-1.5 rounded-full bg-indigo-400"></span>Gemini — 회사 분석</div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight"><span class="text-gradient">AI 회사 분석</span></h1>
    <p class="mt-4 text-lg text-zinc-400">평판·연봉·문화·전망.</p>
  </section>
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-3">
      <div class="grid sm:grid-cols-3 gap-3">
        <label class="block sm:col-span-2"><span class="block text-xs font-bold text-zinc-300 mb-1.5">회사명 *</span><input id="company" type="text" placeholder="예: 카카오, 네이버, 토스, 쿠팡" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-indigo-500 outline-none px-4 py-2.5 text-white" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">초점</span><select id="focus" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-indigo-500 outline-none px-3 py-2 text-white"><option value="all">종합</option><option value="salary">연봉·복지</option><option value="culture">문화·워라밸</option><option value="growth">성장·전망</option></select></label>
      </div>
      <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">직무 (선택)</span><input id="role" type="text" placeholder="예: 백엔드 개발자, PM" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-indigo-500 outline-none px-4 py-2.5 text-white" /></label>
      <button id="go" type="button" class="w-full rounded-lg bg-indigo-500 hover:bg-indigo-400 text-white font-black py-3 disabled:opacity-50">AI 회사 분석</button>
      <p id="status" class="text-xs text-zinc-400 text-center"></p>
    </div>
  </section>
  <section id="result" class="hidden mx-auto max-w-3xl px-4 py-2 space-y-3">
    <div id="box" class="rounded-3xl border-2 p-8">
      <p class="text-[10px] font-bold uppercase tracking-widest" id="lbl">종합 평가</p>
      <p id="score" class="mt-2 text-6xl font-black tabular-nums">-</p>
      <p id="verdict" class="mt-2 text-2xl font-black">-</p>
      <div class="mt-3 flex flex-wrap gap-3 text-sm"><span><span id="industry" class="font-black">-</span></span><span>· 규모: <span id="size" class="font-black">-</span></span></div>
    </div>
    <div class="rounded-2xl border border-emerald-500/40 bg-emerald-500/5 p-5"><h4 class="text-xs font-black text-emerald-300 uppercase tracking-widest mb-3">💰 연봉 범위</h4><div id="salary" class="grid grid-cols-3 gap-2 text-center"></div></div>
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border border-cyan-500/40 bg-cyan-500/5 p-5"><h4 class="text-xs font-black text-cyan-300 uppercase tracking-widest mb-3">🎁 복지</h4><ul id="benefits" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
      <div class="rounded-2xl border border-violet-500/40 bg-violet-500/5 p-5"><h4 class="text-xs font-black text-violet-300 uppercase tracking-widest mb-3">🏢 문화</h4><div id="culture" class="space-y-1 text-sm text-zinc-300"></div></div>
    </div>
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border border-emerald-500/40 bg-emerald-500/5 p-5"><h4 class="text-xs font-black text-emerald-300 uppercase tracking-widest mb-3">👍 장점</h4><ul id="pros" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
      <div class="rounded-2xl border border-rose-500/40 bg-rose-500/5 p-5"><h4 class="text-xs font-black text-rose-300 uppercase tracking-widest mb-3">👎 단점</h4><ul id="cons" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
    </div>
    <div class="rounded-2xl border border-amber-500/40 bg-amber-500/5 p-5"><h4 class="text-xs font-black text-amber-300 uppercase tracking-widest mb-3">⚠ 알려진 이슈</h4><ul id="issues" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border border-blue-500/40 bg-blue-500/5 p-5"><h4 class="text-xs font-black text-blue-300 uppercase tracking-widest mb-3">📈 사업 전망</h4><p id="outlook" class="text-sm text-zinc-300"></p></div>
      <div class="rounded-2xl border border-teal-500/40 bg-teal-500/5 p-5"><h4 class="text-xs font-black text-teal-300 uppercase tracking-widest mb-3">🎤 면접 팁</h4><ul id="interview" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
    </div>
    <div class="rounded-2xl border border-zinc-700 bg-zinc-900/40 p-5"><h4 class="text-xs font-black text-zinc-300 uppercase tracking-widest mb-3">경쟁사</h4><div id="competitors" class="flex flex-wrap gap-2"></div></div>
  </section>
</Layout>
<script is:inline>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  $('go').addEventListener('click', async () => {
    if (!$('company').value.trim()) { $('status').textContent = '⚠ 회사명 필수'; $('status').className = 'text-xs text-rose-300 text-center'; return; }
    $('go').disabled = true; $('status').textContent = '🤖 회사 분석 중...'; $('status').className = 'text-xs text-indigo-300 text-center animate-pulse';
    try {
      const res = await fetch('/api/ai-company', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ company: $('company').value, role: $('role').value, focus: $('focus').value }) });
      const data = await res.json();
      if (!data.ok) { $('status').textContent = '❌ ' + data.error; $('status').className = 'text-xs text-rose-300 text-center'; $('go').disabled = false; return; }
      $('result').classList.remove('hidden'); $('status').textContent = '✓ 완료'; $('status').className = 'text-xs text-emerald-300 text-center';
      const s = data.overallScore || 0;
      let color = 'text-emerald-300', bg = 'border-emerald-500/40 bg-emerald-500/5';
      if (s < 50) { color = 'text-rose-300'; bg = 'border-rose-500/40 bg-rose-500/10'; }
      else if (s < 70) { color = 'text-amber-300'; bg = 'border-amber-500/40 bg-amber-500/5'; }
      $('box').className = 'rounded-3xl border-2 p-8 ' + bg;
      $('lbl').className = 'text-[10px] font-bold uppercase tracking-widest ' + color;
      $('score').className = 'mt-2 text-6xl font-black tabular-nums ' + color;
      $('verdict').className = 'mt-2 text-2xl font-black ' + color;
      $('score').textContent = s + ' / 100';
      $('verdict').textContent = data.verdict || '-';
      $('industry').textContent = data.industry || '';
      $('size').textContent = data.size || '';
      const sal = data.salaryRange || {};
      $('salary').innerHTML = `<div class="rounded-lg bg-zinc-900/60 p-3"><p class="text-[10px] text-zinc-400">주니어</p><p class="text-base font-black">${esc(sal.junior || '-')}</p></div>
        <div class="rounded-lg bg-zinc-900/60 p-3"><p class="text-[10px] text-zinc-400">미들</p><p class="text-base font-black">${esc(sal.mid || '-')}</p></div>
        <div class="rounded-lg bg-zinc-900/60 p-3"><p class="text-[10px] text-zinc-400">시니어</p><p class="text-base font-black">${esc(sal.senior || '-')}</p></div>`;
      $('benefits').innerHTML = (data.benefits || []).map((x) => `<li>${esc(x)}</li>`).join('');
      const cu = data.culture || {};
      $('culture').innerHTML = `<p><strong>워라밸:</strong> ${esc(cu.workLifeBalance || '-')}</p><p><strong>수직성:</strong> ${esc(cu.hierarchy || '-')}</p><p><strong>성장 기회:</strong> ${esc(cu.growth || '-')}</p>`;
      $('pros').innerHTML = (data.pros || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('cons').innerHTML = (data.cons || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('issues').innerHTML = (data.knownIssues || []).map((x) => `<li>${esc(x)}</li>`).join('') || '<li class="list-none text-zinc-500">알려진 이슈 없음</li>';
      $('outlook').textContent = data.businessOutlook || '';
      $('interview').innerHTML = (data.interviewTips || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('competitors').innerHTML = (data.competitors || []).map((c) => `<span class="text-xs font-bold px-3 py-1 rounded-full bg-zinc-700 text-zinc-200">${esc(c)}</span>`).join('');
      if (window.va) { try { window.va('event', { name: 'ai_company', data: { company: $('company').value } }); } catch (_) {} }
    } catch (e) { $('status').textContent = '❌ ' + e.message; $('status').className = 'text-xs text-rose-300 text-center'; }
    finally { $('go').disabled = false; }
  });
</script>
