---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="AI 반려동물 케어 가이드 — 식단·운동·건강·예산" description="반려동물 정보 → Gemini가 식단·운동·백신·검진 일정·월 예산 자동.">
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-orange-500/30 bg-orange-500/5 px-3 py-1 text-xs text-orange-300"><span class="inline-block w-1.5 h-1.5 rounded-full bg-orange-400"></span>Gemini — 펫 케어</div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight"><span class="text-gradient">AI 반려동물 케어</span></h1>
    <p class="mt-4 text-lg text-zinc-400">식단·운동·백신·예산 자동.</p>
  </section>
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-3">
      <div class="grid sm:grid-cols-2 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">종</span><select id="species" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-orange-500 outline-none px-4 py-2.5 text-white"><option>강아지</option><option>고양이</option><option>토끼</option><option>햄스터</option><option>기타</option></select></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">품종</span><input id="breed" type="text" placeholder="예: 푸들, 코숏" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-orange-500 outline-none px-4 py-2.5 text-white" /></label>
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">나이</span><input id="age" type="text" placeholder="예: 3개월, 5살" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-orange-500 outline-none px-4 py-2.5 text-white" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">체중 (kg)</span><input id="weight" type="number" value="5" step="0.5" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-orange-500 outline-none px-4 py-2.5 text-white tabular-nums" /></label>
      </div>
      <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">건강 관심사</span><textarea id="healthConcern" rows="2" placeholder="예: 슬개골 약함, 알레르기, 비만" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-orange-500 outline-none px-4 py-2.5 text-sm text-zinc-200"></textarea></label>
      <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">생활 환경</span><input id="livingEnv" type="text" placeholder="예: 아파트, 1인 가구, 산책 30분/일" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-orange-500 outline-none px-4 py-2.5 text-white" /></label>
      <button id="go" type="button" class="w-full rounded-lg bg-orange-500 hover:bg-orange-400 text-white font-black py-3 disabled:opacity-50">AI 케어 가이드</button>
      <p id="status" class="text-xs text-zinc-400 text-center"></p>
    </div>
  </section>
  <section id="result" class="hidden mx-auto max-w-3xl px-4 py-2 space-y-3">
    <div class="rounded-2xl border border-orange-500/40 bg-orange-500/5 p-5"><p id="summary" class="text-sm text-zinc-200"></p><p id="budget" class="mt-2 text-lg font-black text-orange-300 tabular-nums"></p></div>
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border border-emerald-500/40 bg-emerald-500/5 p-5"><h4 class="text-xs font-black text-emerald-300 uppercase tracking-widest mb-3">🍽 식단</h4><div id="diet" class="space-y-1 text-sm text-zinc-300"></div></div>
      <div class="rounded-2xl border border-cyan-500/40 bg-cyan-500/5 p-5"><h4 class="text-xs font-black text-cyan-300 uppercase tracking-widest mb-3">🏃 운동·그루밍</h4><p id="exercise" class="text-sm text-zinc-300 mb-2"></p><p id="grooming" class="text-sm text-zinc-300"></p></div>
    </div>
    <div class="rounded-2xl border border-violet-500/40 bg-violet-500/5 p-5"><h4 class="text-xs font-black text-violet-300 uppercase tracking-widest mb-3">💉 백신·검진</h4><ul id="vaccination" class="space-y-1 text-sm text-zinc-300 list-disc list-inside mb-3"></ul><div id="checkup" class="space-y-1 text-xs text-zinc-400"></div></div>
    <div class="rounded-2xl border border-amber-500/40 bg-amber-500/5 p-5"><h4 class="text-xs font-black text-amber-300 uppercase tracking-widest mb-3">⚠ 흔한 질환</h4><div id="issues" class="space-y-2"></div></div>
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border border-blue-500/40 bg-blue-500/5 p-5"><h4 class="text-xs font-black text-blue-300 uppercase tracking-widest mb-3">🎓 훈련 팁</h4><ul id="training" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
      <div class="rounded-2xl border border-rose-500/40 bg-rose-500/5 p-5"><h4 class="text-xs font-black text-rose-300 uppercase tracking-widest mb-3">⚠ 주의</h4><ul id="warnings" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
    </div>
  </section>
</Layout>
<script is:inline>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  $('go').addEventListener('click', async () => {
    $('go').disabled = true; $('status').textContent = '🤖 케어 분석 중...'; $('status').className = 'text-xs text-orange-300 text-center animate-pulse';
    const body = {};
    ['species','breed','age','weight','healthConcern','livingEnv'].forEach((id) => { body[id] = $(id).value; });
    try {
      const res = await fetch('/api/ai-pet-care', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const data = await res.json();
      if (!data.ok) { $('status').textContent = '❌ ' + data.error; $('status').className = 'text-xs text-rose-300 text-center'; $('go').disabled = false; return; }
      $('result').classList.remove('hidden'); $('status').textContent = '✓ 완료'; $('status').className = 'text-xs text-emerald-300 text-center';
      $('summary').textContent = data.summary || '';
      $('budget').textContent = '월 예상 비용: ' + (data.monthlyBudget || '-');
      const d = data.diet || {};
      $('diet').innerHTML = `<p><strong>사료:</strong> ${esc(d.food || '-')}</p><p><strong>일일 양:</strong> ${esc(d.amountPerDay || '-')}</p><p><strong>빈도:</strong> ${esc(d.frequency || '-')}</p><p class="text-rose-300"><strong>피해야 할:</strong> ${(d.avoid || []).map(esc).join(', ')}</p>`;
      $('exercise').textContent = '운동: ' + (data.exercise || '');
      $('grooming').textContent = '그루밍: ' + (data.grooming || '');
      $('vaccination').innerHTML = (data.vaccination || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('checkup').innerHTML = (data.healthCheckSchedule || []).map((c) => `<p><strong>${esc(c.age)}:</strong> ${esc(c.what)}</p>`).join('');
      $('issues').innerHTML = (data.commonIssues || []).map((i) => `<div class="rounded-lg bg-zinc-900/60 p-3"><p class="text-sm font-bold text-amber-300">${esc(i.issue || '')}</p><p class="text-xs text-zinc-300 mt-1"><strong>증상:</strong> ${esc(i.signs || '')}</p><p class="text-xs text-zinc-300"><strong>조치:</strong> ${esc(i.action || '')}</p></div>`).join('');
      $('training').innerHTML = (data.trainingTips || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('warnings').innerHTML = (data.warnings || []).map((x) => `<li>${esc(x)}</li>`).join('');
      if (window.va) { try { window.va('event', { name: 'ai_pet' }); } catch (_) {} }
    } catch (e) { $('status').textContent = '❌ ' + e.message; $('status').className = 'text-xs text-rose-300 text-center'; }
    finally { $('go').disabled = false; }
  });
</script>
