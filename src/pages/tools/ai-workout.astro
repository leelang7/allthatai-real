---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="AI 운동·식단 플랜 — 목표·신체 → 주간 루틴 + 매크로" description="목표·신체·시간·기구 입력 → Gemini가 주간 운동·식단·매크로·보충제 자동.">
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-red-500/30 bg-red-500/5 px-3 py-1 text-xs text-red-300"><span class="inline-block w-1.5 h-1.5 rounded-full bg-red-400"></span>Gemini — 운동·식단</div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight"><span class="text-gradient">AI 운동·식단</span></h1>
    <p class="mt-4 text-lg text-zinc-400">주간 루틴 + 매크로 + 식단.</p>
  </section>
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-3">
      <div class="grid sm:grid-cols-2 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">목표</span><select id="goal" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-red-500 outline-none px-4 py-2.5 text-white"><option value="fat-loss">체지방 감량</option><option value="muscle">근육 증가</option><option value="recomp">재구성</option><option value="maintain">유지</option></select></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">활동량</span><select id="activityLevel" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-red-500 outline-none px-4 py-2.5 text-white"><option value="sedentary">앉아서 일</option><option value="light">가벼움</option><option value="moderate" selected>보통</option><option value="active">활발</option></select></label>
      </div>
      <div class="grid sm:grid-cols-4 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">나이</span><input id="age" type="number" value="30" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-red-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">성별</span><select id="gender" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-red-500 outline-none px-3 py-2 text-white"><option>남</option><option>여</option></select></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">신장 (cm)</span><input id="height" type="number" value="170" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-red-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">체중 (kg)</span><input id="weight" type="number" value="70" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-red-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
      </div>
      <div class="grid sm:grid-cols-3 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">주 N일</span><input id="daysPerWeek" type="number" value="4" min="1" max="7" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-red-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">회당 분</span><input id="timePerSession" type="number" value="60" min="15" max="120" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-red-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">환경</span><select id="equipment" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-red-500 outline-none px-3 py-2 text-white"><option value="gym">헬스장</option><option value="home-eq">홈+덤벨</option><option value="home">맨몸</option></select></label>
      </div>
      <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">제한사항</span><input id="restrictions" type="text" placeholder="예: 무릎 부상, 알레르기, 채식" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-red-500 outline-none px-4 py-2.5 text-white" /></label>
      <button id="go" type="button" class="w-full rounded-lg bg-red-500 hover:bg-red-400 text-white font-black py-3 disabled:opacity-50">AI 플랜 생성</button>
      <p id="status" class="text-xs text-zinc-400 text-center"></p>
    </div>
  </section>
  <section id="result" class="hidden mx-auto max-w-3xl px-4 py-2 space-y-3">
    <div class="rounded-3xl border-2 border-red-500/40 bg-gradient-to-br from-red-500/15 to-orange-500/5 p-8">
      <p class="text-[10px] font-bold text-red-300 uppercase tracking-widest">목표 칼로리</p>
      <p id="targetCal" class="mt-2 text-5xl font-black text-white tabular-nums">-</p>
      <p id="tdee" class="mt-1 text-sm text-zinc-300"></p>
      <div class="mt-3 grid grid-cols-3 gap-2"><div class="rounded-lg bg-zinc-900/60 p-2"><p class="text-[10px] text-zinc-400">단백질</p><p id="protein" class="text-lg font-black">-</p></div><div class="rounded-lg bg-zinc-900/60 p-2"><p class="text-[10px] text-zinc-400">탄수화물</p><p id="carbs" class="text-lg font-black">-</p></div><div class="rounded-lg bg-zinc-900/60 p-2"><p class="text-[10px] text-zinc-400">지방</p><p id="fat" class="text-lg font-black">-</p></div></div>
      <p id="timeline" class="mt-3 text-sm font-bold text-emerald-300"></p>
    </div>
    <h3 class="text-xl font-black text-red-300">주간 운동 스케줄</h3>
    <div id="schedule" class="space-y-2"></div>
    <h3 class="text-xl font-black text-amber-300">식단</h3>
    <div id="meals" class="space-y-2"></div>
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border border-cyan-500/40 bg-cyan-500/5 p-5"><h4 class="text-xs font-black text-cyan-300 uppercase tracking-widest mb-3">💊 보충제</h4><ul id="supplements" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
      <div class="rounded-2xl border border-emerald-500/40 bg-emerald-500/5 p-5"><h4 class="text-xs font-black text-emerald-300 uppercase tracking-widest mb-3">💡 결과 팁</h4><ul id="tips" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
    </div>
    <div class="rounded-2xl border border-rose-500/40 bg-rose-500/5 p-5"><h4 class="text-xs font-black text-rose-300 uppercase tracking-widest mb-3">⚠ 주의</h4><ul id="warnings" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
  </section>
</Layout>
<script is:inline>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  $('go').addEventListener('click', async () => {
    if (!+$('weight').value || !+$('height').value) { $('status').textContent = '⚠ 신장·체중 필수'; $('status').className = 'text-xs text-rose-300 text-center'; return; }
    $('go').disabled = true; $('status').textContent = '🤖 플랜 생성 중...'; $('status').className = 'text-xs text-red-300 text-center animate-pulse';
    const body = {};
    ['goal','age','gender','height','weight','activityLevel','daysPerWeek','timePerSession','equipment','restrictions'].forEach((id) => { body[id] = $(id).value; });
    try {
      const res = await fetch('/api/ai-workout', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const data = await res.json();
      if (!data.ok) { $('status').textContent = '❌ ' + data.error; $('status').className = 'text-xs text-rose-300 text-center'; $('go').disabled = false; return; }
      $('result').classList.remove('hidden'); $('status').textContent = '✓ 완료'; $('status').className = 'text-xs text-emerald-300 text-center';
      $('targetCal').textContent = (data.targetCalories || '-') + ' kcal';
      $('tdee').textContent = 'TDEE: ' + (data.tdee || '-') + ' kcal';
      const m = data.macros || {};
      $('protein').textContent = m.protein || '-'; $('carbs').textContent = m.carbs || '-'; $('fat').textContent = m.fat || '-';
      $('timeline').textContent = '예상 기간: ' + (data.timeline || '-');
      $('schedule').innerHTML = (data.weeklySchedule || []).map((d) => `<div class="rounded-lg bg-zinc-900/60 p-3"><div class="flex items-center justify-between mb-2"><span class="text-sm font-bold">${esc(d.day || '')}</span><span class="text-xs text-cyan-300">${esc(d.type || '')} · ${esc(d.duration || '')}분</span></div><ul class="text-xs text-zinc-300 list-disc list-inside">${(d.exercises || []).map((e) => `<li>${esc(e)}</li>`).join('')}</ul></div>`).join('');
      $('meals').innerHTML = (data.mealPlan || []).map((m) => `<div class="rounded-lg bg-zinc-900/60 p-3"><div class="flex items-center justify-between mb-2"><span class="text-sm font-bold">${esc(m.meal || '')}</span><span class="text-xs text-amber-300">${esc(m.calories || '')} kcal</span></div><ul class="text-xs text-zinc-300 list-disc list-inside">${(m.options || []).map((o) => `<li>${esc(o)}</li>`).join('')}</ul></div>`).join('');
      $('supplements').innerHTML = (data.supplements || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('tips').innerHTML = (data.tipsForResults || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('warnings').innerHTML = (data.warnings || []).map((x) => `<li>${esc(x)}</li>`).join('');
      if (window.va) { try { window.va('event', { name: 'ai_workout' }); } catch (_) {} }
    } catch (e) { $('status').textContent = '❌ ' + e.message; $('status').className = 'text-xs text-rose-300 text-center'; }
    finally { $('go').disabled = false; }
  });
</script>
