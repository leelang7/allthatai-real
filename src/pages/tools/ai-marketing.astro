---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="AI 마케팅 카피 — 제품 → 광고·SNS·랜딩" description="제품·타겟 입력 → Gemini가 슬로건·광고·SNS 포스트·CTA·키워드 자동.">
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8"><h1 class="text-4xl sm:text-5xl font-black"><span class="text-gradient">AI 마케팅 카피</span></h1><p class="mt-4 text-lg text-zinc-400">제품 → 광고·SNS·랜딩.</p></section>
  <section class="mx-auto max-w-3xl px-4 py-6"><div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-3">
    <input id="product" type="text" placeholder="제품/서비스 *" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-orange-500 outline-none px-4 py-2.5 text-white" />
    <textarea id="features" rows="2" placeholder="특징·기능" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-orange-500 outline-none px-4 py-2.5 text-sm text-zinc-200"></textarea>
    <input id="target" type="text" placeholder="타겟 (예: 30대 직장인 여성)" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-orange-500 outline-none px-4 py-2.5 text-white" />
    <div class="grid sm:grid-cols-2 gap-3">
      <input id="price" type="text" placeholder="가격" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-orange-500 outline-none px-4 py-2.5 text-white" />
      <select id="tone" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-orange-500 outline-none px-3 py-2 text-white"><option>professional</option><option>friendly</option><option>luxury</option><option>playful</option><option>urgent</option></select>
    </div>
    <input id="usp" type="text" placeholder="USP (Unique Selling Point)" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-orange-500 outline-none px-4 py-2.5 text-white" />
    <button id="go" type="button" class="w-full rounded-lg bg-orange-500 hover:bg-orange-400 text-white font-black py-3 disabled:opacity-50">AI 카피 생성</button>
    <p id="status" class="text-xs text-zinc-400 text-center"></p>
  </div></section>
  <section id="result" class="hidden mx-auto max-w-3xl px-4 py-2 space-y-3">
    <div class="rounded-3xl border-2 border-orange-500/40 bg-gradient-to-br from-orange-500/15 to-amber-500/5 p-8"><p class="text-[10px] font-bold text-orange-300 uppercase tracking-widest">슬로건</p><p id="tagline" class="mt-2 text-4xl font-black text-white"></p><p id="shortDesc" class="mt-3 text-lg text-zinc-200"></p></div>
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-5"><h4 class="text-xs font-black text-zinc-300 uppercase mb-2">본문</h4><p id="longDesc" class="text-sm text-zinc-200 whitespace-pre-wrap"></p></div>
    <div class="rounded-2xl border border-amber-500/40 bg-amber-500/5 p-5"><h4 class="text-xs font-black text-amber-300 uppercase mb-3">광고 헤드라인</h4><ul id="headlines" class="space-y-2 text-sm"></ul></div>
    <div class="rounded-2xl border border-cyan-500/40 bg-cyan-500/5 p-5"><h4 class="text-xs font-black text-cyan-300 uppercase mb-3">SNS 포스트</h4><div id="sns" class="space-y-2"></div></div>
    <div class="rounded-2xl border border-violet-500/40 bg-violet-500/5 p-5"><h4 class="text-xs font-black text-violet-300 uppercase mb-2">랜딩 페이지</h4><ol id="landing" class="space-y-1 text-sm text-zinc-300 list-decimal list-inside"></ol></div>
    <div class="grid sm:grid-cols-3 gap-3">
      <div class="rounded-2xl border border-emerald-500/40 bg-emerald-500/5 p-5"><h4 class="text-xs font-black text-emerald-300 uppercase mb-2">CTA</h4><ul id="cta" class="space-y-1 text-xs text-zinc-300 list-disc list-inside"></ul></div>
      <div class="rounded-2xl border border-pink-500/40 bg-pink-500/5 p-5"><h4 class="text-xs font-black text-pink-300 uppercase mb-2">키워드</h4><ul id="keywords" class="space-y-1 text-xs text-zinc-300 list-disc list-inside"></ul></div>
      <div class="rounded-2xl border border-blue-500/40 bg-blue-500/5 p-5"><h4 class="text-xs font-black text-blue-300 uppercase mb-2">A/B 테스트</h4><ul id="ab" class="space-y-1 text-xs text-zinc-300 list-disc list-inside"></ul></div>
    </div>
  </section>
</Layout>
<script is:inline>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  $('go').addEventListener('click', async () => {
    if (!$('product').value.trim()) { $('status').textContent = '⚠ 제품 필수'; $('status').className = 'text-xs text-rose-300 text-center'; return; }
    $('go').disabled = true; $('status').textContent = '🤖 카피 생성 중...'; $('status').className = 'text-xs text-orange-300 text-center animate-pulse';
    const body = {}; ['product','features','target','price','tone','usp'].forEach((id) => { body[id] = $(id).value; });
    try {
      const res = await fetch('/api/ai-marketing', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const data = await res.json();
      if (!data.ok) { $('status').textContent = '❌ ' + data.error; $('status').className = 'text-xs text-rose-300 text-center'; $('go').disabled = false; return; }
      $('result').classList.remove('hidden'); $('status').textContent = '✓ 완료'; $('status').className = 'text-xs text-emerald-300 text-center';
      $('tagline').textContent = data.tagline || '';
      $('shortDesc').textContent = data.shortDesc || '';
      $('longDesc').textContent = data.longDesc || '';
      $('headlines').innerHTML = (data.headlines || []).map((h) => `<li class="text-zinc-200 italic">"${esc(h)}"</li>`).join('');
      const sns = data.snsPosts || {};
      $('sns').innerHTML = Object.entries(sns).map(([k, v]) => `<div class="rounded-lg bg-zinc-900/60 p-3"><p class="text-xs font-black text-cyan-300 mb-1">${esc(k)}</p><p class="text-sm text-zinc-200 whitespace-pre-wrap">${esc(String(v))}</p></div>`).join('');
      $('landing').innerHTML = (data.landingPageOutline || []).map((l) => `<li>${esc(l)}</li>`).join('');
      $('cta').innerHTML = (data.callsToAction || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('keywords').innerHTML = (data.keywords || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('ab').innerHTML = (data.abTestIdeas || []).map((x) => `<li>${esc(x)}</li>`).join('');
      if (window.va) { try { window.va('event', { name: 'ai_marketing' }); } catch (_) {} }
    } catch (e) { $('status').textContent = '❌ ' + e.message; $('status').className = 'text-xs text-rose-300 text-center'; }
    finally { $('go').disabled = false; }
  });
</script>
