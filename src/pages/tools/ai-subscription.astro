---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="AI 청약 자격·전략 진단 — 점수 + 자격 + 우선 단지 추천" description="나이·가족·무주택·통장·소득 입력 → Gemini가 청약 가점·자격·전략·우선 단지·놓친 특공 자동.">
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-500/5 px-3 py-1 text-xs text-cyan-300">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-cyan-400"></span>Gemini — 청약 전략 진단
    </div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight"><span class="text-gradient">AI 청약 진단</span></h1>
    <p class="mt-4 text-lg text-zinc-400">가점 + 자격 + 우선 전략 자동.</p>
  </section>
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-3">
      <div class="grid sm:grid-cols-3 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">만 나이 *</span><input id="age" type="number" value="32" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
        <label class="flex items-center gap-2 mt-6"><input id="married" type="checkbox" class="w-4 h-4 accent-cyan-500" /><span class="text-sm text-zinc-300">기혼</span></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">결혼 N년차</span><input id="marriedYears" type="number" value="0" min="0" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
      </div>
      <div class="grid sm:grid-cols-3 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">자녀</span><input id="children" type="number" value="0" min="0" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">부모 부양</span><input id="parents" type="number" value="0" min="0" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">무주택 N년</span><input id="noHouseYears" type="number" value="2" min="0" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">청약통장 N년</span><input id="bankYears" type="number" value="3" min="0" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-4 py-2.5 text-white tabular-nums" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">통장 잔액 (₩)</span><input id="bankBalance" type="number" value="5000000" step="500000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-4 py-2.5 text-white tabular-nums" /></label>
      </div>
      <div class="grid sm:grid-cols-3 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">거주 지역</span><select id="region" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-3 py-2 text-white"><option>서울</option><option>경기</option><option>인천</option><option>지방</option></select></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">월 소득 (₩)</span><input id="monthlyIncome" type="number" value="4000000" step="500000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">자산 (₩)</span><input id="assets" type="number" value="100000000" step="10000000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        <label class="flex items-center gap-2 pt-6"><input id="firstTimeBuyer" type="checkbox" class="w-4 h-4 accent-cyan-500" checked /><span class="text-sm text-zinc-300">생애최초 (생애 첫 구입)</span></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">목표 유형</span><select id="target" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-3 py-2 text-white"><option>아파트</option><option>공공임대</option><option>행복주택</option><option>오피스텔</option></select></label>
      </div>
      <button id="go" type="button" class="w-full rounded-lg bg-cyan-500 hover:bg-cyan-400 text-white font-black py-3 disabled:opacity-50">AI 청약 진단</button>
      <p id="status" class="text-xs text-zinc-400 text-center"></p>
    </div>
  </section>
  <section id="result" class="hidden mx-auto max-w-3xl px-4 py-2 space-y-3">
    <div class="rounded-3xl border-2 border-cyan-500/40 bg-gradient-to-br from-cyan-500/15 to-blue-500/5 p-8">
      <p class="text-[10px] font-bold text-cyan-300 uppercase tracking-widest">현재 가점 / 청약 등급</p>
      <p id="score" class="mt-2 text-6xl font-black text-white tabular-nums">-</p>
      <p id="tier" class="mt-2 text-2xl font-black text-cyan-300">-</p>
      <div id="breakdown" class="mt-3 grid grid-cols-3 gap-2 text-sm"></div>
    </div>
    <div class="rounded-2xl border border-emerald-500/40 bg-emerald-500/5 p-5"><h4 class="text-xs font-black text-emerald-300 uppercase tracking-widest mb-3">✓ 자격 보유 유형</h4><div id="qualifies" class="flex flex-wrap gap-2"></div></div>
    <h3 class="text-xl font-black text-cyan-300">전략</h3>
    <div id="strategies" class="space-y-3"></div>
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border border-rose-500/40 bg-rose-500/5 p-5"><h4 class="text-xs font-black text-rose-300 uppercase tracking-widest mb-3">⚠ 놓치고 있는 기회</h4><ul id="missed" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
      <div class="rounded-2xl border border-amber-500/40 bg-amber-500/5 p-5"><h4 class="text-xs font-black text-amber-300 uppercase tracking-widest mb-3">📌 오늘 할 일</h4><ul id="actions" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
    </div>
    <div class="rounded-2xl border border-zinc-700 bg-zinc-900/40 p-5"><h4 class="text-xs font-black text-zinc-300 uppercase tracking-widest mb-3">주의</h4><ul id="warnings" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
  </section>
</Layout>
<script is:inline>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  $('go').addEventListener('click', async () => {
    if (!+$('age').value) { $('status').textContent = '⚠ 나이 필수'; $('status').className = 'text-xs text-rose-300 text-center'; return; }
    $('go').disabled = true; $('status').textContent = '🤖 청약 진단 중...'; $('status').className = 'text-xs text-cyan-300 text-center animate-pulse';
    const body = {};
    ['age','marriedYears','children','parents','noHouseYears','bankYears','bankBalance','monthlyIncome','assets','region','target'].forEach((id) => { body[id] = $(id).value; });
    body.married = $('married').checked;
    body.firstTimeBuyer = $('firstTimeBuyer').checked;
    try {
      const res = await fetch('/api/ai-subscription', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const data = await res.json();
      if (!data.ok) { $('status').textContent = '❌ ' + data.error; $('status').className = 'text-xs text-rose-300 text-center'; $('go').disabled = false; return; }
      $('result').classList.remove('hidden'); $('status').textContent = '✓ 완료'; $('status').className = 'text-xs text-emerald-300 text-center';
      $('score').textContent = (data.currentScore || 0) + ' / 84';
      $('tier').textContent = data.tier || '-';
      const b = data.scoreBreakdown || {};
      $('breakdown').innerHTML = `
        <div class="rounded-lg bg-zinc-900/60 p-2"><p class="text-[10px] text-zinc-400">무주택</p><p class="text-lg font-black">${b['무주택']||0}/32</p></div>
        <div class="rounded-lg bg-zinc-900/60 p-2"><p class="text-[10px] text-zinc-400">부양가족</p><p class="text-lg font-black">${b['부양가족']||0}/35</p></div>
        <div class="rounded-lg bg-zinc-900/60 p-2"><p class="text-[10px] text-zinc-400">통장</p><p class="text-lg font-black">${b['통장']||0}/17</p></div>`;
      $('qualifies').innerHTML = (data.qualifies || []).map((q) => `<span class="text-xs font-bold px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">${esc(q)}</span>`).join('');
      $('strategies').innerHTML = (data.strategies || []).map((s) => `<div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-5">
        <h4 class="font-black text-white mb-1">${esc(s.title || '')}</h4>
        <p class="text-sm text-cyan-300 mb-2">🎯 ${esc(s.target || '')}</p>
        <p class="text-sm text-zinc-300 mb-2">${esc(s.reasoning || '')}</p>
        <div class="flex gap-3 text-xs"><span class="text-emerald-300">📈 ${esc(s.scoreImprovement || '')}</span><span class="text-zinc-400">⏱ ${esc(s.timeframe || '')}</span></div>
      </div>`).join('');
      $('missed').innerHTML = (data.missedOpportunities || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('actions').innerHTML = (data.actionItems || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('warnings').innerHTML = (data.warnings || []).map((x) => `<li>${esc(x)}</li>`).join('');
      if (window.va) { try { window.va('event', { name: 'ai_subscription', data: { score: data.currentScore } }); } catch (_) {} }
    } catch (e) { $('status').textContent = '❌ ' + e.message; $('status').className = 'text-xs text-rose-300 text-center'; }
    finally { $('go').disabled = false; }
  });
</script>
