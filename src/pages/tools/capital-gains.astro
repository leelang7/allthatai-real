---
/**
 * /tools/capital-gains — 주식 양도소득세 (2026).
 *
 * 한국 검색: "주식 양도소득세", "대주주 양도세", "해외주식 양도세"
 */
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="주식 양도소득세 계산기 — 국내 대주주 + 해외주식 자동"
  description="국내주식 (대주주 한정) + 해외주식 + 비상장 양도세 자동. 250만 기본공제 + 22% 단일세율."
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight">
      <span class="text-gradient">주식 양도세</span>
    </h1>
    <p class="mt-4 text-lg text-zinc-400 leading-relaxed">국내 대주주 + 해외주식 + 비상장 — 양도세 자동.</p>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-4">
      <label class="block">
        <span class="block text-xs font-bold text-zinc-300 mb-1.5">주식 종류</span>
        <select id="kind" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-4 py-3 text-white">
          <option value="domestic-small">국내 상장 (소액주주) — 비과세</option>
          <option value="domestic-major">국내 상장 (대주주)</option>
          <option value="domestic-unlisted">국내 비상장</option>
          <option value="overseas" selected>해외 주식</option>
        </select>
      </label>
      <div class="grid sm:grid-cols-2 gap-3">
        <label class="block">
          <span class="block text-xs font-bold text-zinc-300 mb-1.5">매도 금액 (₩)</span>
          <input id="sell" type="number" value="20000000" step="100000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-4 py-2.5 text-white tabular-nums" />
        </label>
        <label class="block">
          <span class="block text-xs font-bold text-zinc-300 mb-1.5">매수 금액 (₩, 평균단가 × 수량)</span>
          <input id="buy" type="number" value="15000000" step="100000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-4 py-2.5 text-white tabular-nums" />
        </label>
        <label class="block sm:col-span-2">
          <span class="block text-xs font-bold text-zinc-300 mb-1.5">매매 수수료 (₩, 증권사 + 세금)</span>
          <input id="fee" type="number" value="50000" step="1000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-cyan-500 outline-none px-4 py-2.5 text-white tabular-nums" />
        </label>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-2">
    <div class="rounded-3xl border-2 border-emerald-500/40 bg-gradient-to-br from-emerald-500/15 to-cyan-500/5 p-8">
      <p class="text-[10px] font-bold text-emerald-300 uppercase tracking-widest">양도소득세</p>
      <p id="r-tax" class="mt-2 text-5xl sm:text-6xl font-black text-white tabular-nums">-</p>
      <p id="r-detail" class="mt-3 text-sm text-zinc-300"></p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-4">
    <div id="breakdown" class="rounded-2xl border border-zinc-800 bg-zinc-900/40 overflow-hidden"></div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
      <h2 class="font-black mb-3">주식 양도세 — 2026 기준</h2>
      <ul class="space-y-2 text-sm text-zinc-300">
        <li>→ <strong>국내 상장 소액주주</strong>: 양도세 X (단, 증권거래세 0.18% 매도시 자동)</li>
        <li>→ <strong>국내 상장 대주주</strong>: 보유 1년 이상 22% / 1년 미만 33%</li>
        <li>→ <strong>국내 비상장 + 해외주식</strong>: 22% 단일세율 (지방세 포함)</li>
        <li>→ <strong>기본공제</strong>: 연 ₩250만 (해외+국내 비상장 합산)</li>
        <li>→ <strong>신고 기간</strong>: 다음해 5월 (종합소득세 신고와 별도)</li>
        <li>→ <strong>대주주 기준</strong>: 단일 종목 ₩50억 또는 지분 1%(코스피)/2%(코스닥)</li>
      </ul>
    </div>
  </section>
</Layout>

<script is:inline>
  const $ = (id) => document.getElementById(id);
  const fmt = (n) => '₩' + Math.round(n).toLocaleString('ko-KR');

  function calc() {
    const kind = $('kind').value;
    const sell = +$('sell').value || 0;
    const buy = +$('buy').value || 0;
    const fee = +$('fee').value || 0;

    const profit = sell - buy - fee;
    let tax = 0;
    let rate = 0.22;
    let exempt = 2500000;
    let detail = '';

    if (kind === 'domestic-small') {
      tax = 0;
      detail = '소액주주 — 양도세 0 (증권거래세 ₩' + Math.round(sell * 0.0018).toLocaleString() + '만 자동 차감)';
    } else if (kind === 'domestic-major') {
      const taxBase = Math.max(0, profit - exempt);
      tax = taxBase * 0.22; // 1년 이상 보유 가정 — 단순화
      detail = `대주주 (1년+) 22% · 기본공제 ₩250만`;
    } else {
      const taxBase = Math.max(0, profit - exempt);
      tax = taxBase * 0.22;
      detail = `${kind === 'overseas' ? '해외주식' : '비상장'} · 22% 단일 + ₩250만 공제`;
    }

    $('r-tax').textContent = fmt(tax);
    $('r-detail').textContent = `수익 ${fmt(profit)} · ${detail}`;

    $('breakdown').innerHTML = `
      <div class="px-5 py-3 border-b border-zinc-800 bg-zinc-900/60"><p class="text-sm font-black">계산 내역</p></div>
      <div class="divide-y divide-zinc-800">
        <div class="flex justify-between px-5 py-3"><span class="text-sm">매도</span><span class="font-bold tabular-nums">${fmt(sell)}</span></div>
        <div class="flex justify-between px-5 py-3"><span class="text-sm">매수</span><span class="font-bold tabular-nums">${fmt(buy)}</span></div>
        <div class="flex justify-between px-5 py-3"><span class="text-sm">수수료·세금</span><span class="font-bold tabular-nums">−${fmt(fee)}</span></div>
        <div class="flex justify-between px-5 py-3 bg-zinc-900/60"><span class="text-sm font-bold">양도차익</span><span class="font-bold tabular-nums ${profit > 0 ? 'text-emerald-300' : 'text-rose-300'}">${fmt(profit)}</span></div>
        <div class="flex justify-between px-5 py-3"><span class="text-sm text-emerald-300">기본공제</span><span class="font-bold text-emerald-300 tabular-nums">−${fmt(exempt)}</span></div>
        <div class="flex justify-between px-5 py-3 bg-emerald-500/10"><span class="text-sm font-black text-emerald-300">최종 양도세</span><span class="font-black text-emerald-300 tabular-nums">${fmt(tax)}</span></div>
      </div>
    `;

    if (window.va) { try { window.va('event', { name: 'capital_gains', data: { kind, profit } }); } catch (_) {} }
  }

  ['kind', 'sell', 'buy', 'fee'].forEach((id) => {
    const el = $(id);
    el.addEventListener('input', calc);
    el.addEventListener('change', calc);
  });
  calc();
</script>
