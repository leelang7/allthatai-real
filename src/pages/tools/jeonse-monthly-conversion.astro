---
/**
 * /tools/jeonse-monthly-conversion — 전월세 전환율.
 *
 * 매우 큰 검색량: "전월세 전환율", "월세 전세 환산"
 *
 * 2026: 법정 전월세전환율 = 한국은행 기준금리 + 2% (현 6.5%)
 * 상한선이지만 시장 실거래는 4~7% 범위
 */
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="전월세 전환율 계산기 — 전세 ↔ 월세 환산 + 법정 상한"
  description="전세금 ↔ 월세 양방향 환산. 한국은행 기준금리 + 2% 법정 상한. 실거래 평균 비교."
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight">
      <span class="text-gradient">전월세 전환율</span>
    </h1>
    <p class="mt-4 text-lg text-zinc-400 leading-relaxed">전세 ↔ 월세 환산 + 법정 상한 (기준금리 + 2%).</p>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-4">
      <div class="flex gap-2 p-1 bg-zinc-900 rounded-lg">
        <button id="tab-j2m" type="button" class="flex-1 py-2 px-4 rounded-md text-sm font-bold bg-emerald-500 text-white">전세 → 월세</button>
        <button id="tab-m2j" type="button" class="flex-1 py-2 px-4 rounded-md text-sm font-bold text-zinc-400">월세 → 전세</button>
      </div>

      <div id="form-j2m" class="space-y-3">
        <label class="block">
          <span class="block text-xs font-bold text-zinc-300 mb-1.5">전세 보증금 (₩)</span>
          <input id="jeonse" type="number" value="300000000" step="10000000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-3 text-xl font-black text-white tabular-nums" />
        </label>
        <label class="block">
          <span class="block text-xs font-bold text-zinc-300 mb-1.5">월세로 전환할 금액 (₩) — 보증금에서 차감</span>
          <input id="convertAmt" type="number" value="200000000" step="10000000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-2.5 text-white tabular-nums" />
          <span class="block text-[10px] text-zinc-500 mt-1">예: 3억 전세 → 1억 보증금 + 월세로 전환 시 2억 입력</span>
        </label>
      </div>

      <div id="form-m2j" class="hidden space-y-3">
        <label class="block">
          <span class="block text-xs font-bold text-zinc-300 mb-1.5">보증금 (₩)</span>
          <input id="depositM" type="number" value="50000000" step="10000000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-2.5 text-white tabular-nums" />
        </label>
        <label class="block">
          <span class="block text-xs font-bold text-zinc-300 mb-1.5">월세 (₩)</span>
          <input id="monthlyM" type="number" value="800000" step="50000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-emerald-500 outline-none px-4 py-2.5 text-white tabular-nums" />
        </label>
      </div>

      <label class="block">
        <span class="block text-xs font-bold text-zinc-300 mb-1.5">전월세전환율 (%)</span>
        <input id="rate" type="range" min="3" max="8" step="0.1" value="5.5" class="w-full accent-emerald-500" />
        <div class="flex justify-between text-xs text-zinc-400 mt-1">
          <span>3% (저)</span>
          <span id="rateVal" class="font-black text-emerald-300">5.5%</span>
          <span>8% (고)</span>
        </div>
        <p class="mt-2 text-[10px] text-zinc-500">법정 상한: 기준금리 (3.5%) + 2% = <strong class="text-emerald-300">5.5%</strong>. 시장 평균은 5~6%</p>
      </label>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-2">
    <div class="rounded-3xl border-2 border-emerald-500/40 bg-gradient-to-br from-emerald-500/15 to-cyan-500/5 p-8">
      <p id="r-label" class="text-[10px] font-bold text-emerald-300 uppercase tracking-widest">월세 환산</p>
      <p id="r-main" class="mt-2 text-5xl sm:text-6xl font-black text-white tabular-nums">-</p>
      <p id="r-sub" class="mt-3 text-sm text-zinc-300"></p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
      <h2 class="font-black mb-3">전월세 전환율 — 알아두면 좋은 것</h2>
      <ul class="space-y-2 text-sm text-zinc-300">
        <li>→ <strong>법정 상한</strong>: 주택임대차보호법상 한국은행 기준금리 + 2%. 현재 5.5%</li>
        <li>→ <strong>전환 산식</strong>: 월세 = 전환금액 × 전환율 / 12</li>
        <li>→ <strong>예시</strong>: 2억 × 5.5% / 12 = 월 약 91만</li>
        <li>→ <strong>실거래 평균</strong>: 서울 아파트 5.5~6.5%, 빌라·오피스텔 6~8%</li>
        <li>→ <strong>임차인 유리</strong>: 전환율이 낮을수록 (월세 비용 낮음)</li>
        <li>→ <strong>임대인 유리</strong>: 전환율이 높을수록 (월세 수입 높음)</li>
        <li>→ <strong>판단</strong>: 본인 자금조달 비용(예금금리 or 대출금리) 비교. 자금조달 비용 &lt; 전환율 → 보증금 많이</li>
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-4">
    <div class="grid sm:grid-cols-3 gap-2">
      <a href="/tools/real-estate-lifecycle/" class="rounded-xl border border-zinc-800 hover:border-emerald-500/40 bg-zinc-900/40 p-3 transition text-sm">부동산 라이프사이클 →</a>
      <a href="/tools/rental-yield/" class="rounded-xl border border-zinc-800 hover:border-emerald-500/40 bg-zinc-900/40 p-3 transition text-sm">임대 수익률 →</a>
      <a href="/jeonse/" class="rounded-xl border border-zinc-800 hover:border-emerald-500/40 bg-zinc-900/40 p-3 transition text-sm">전세 안전 →</a>
    </div>
  </section>
</Layout>

<script is:inline>
  const $ = (id) => document.getElementById(id);
  const fmt = (n) => '₩' + Math.round(n).toLocaleString('ko-KR');

  let mode = 'j2m';

  $('tab-j2m').addEventListener('click', () => {
    mode = 'j2m';
    $('tab-j2m').className = 'flex-1 py-2 px-4 rounded-md text-sm font-bold bg-emerald-500 text-white';
    $('tab-m2j').className = 'flex-1 py-2 px-4 rounded-md text-sm font-bold text-zinc-400';
    $('form-j2m').classList.remove('hidden');
    $('form-m2j').classList.add('hidden');
    $('r-label').textContent = '월세 환산';
    calc();
  });
  $('tab-m2j').addEventListener('click', () => {
    mode = 'm2j';
    $('tab-m2j').className = 'flex-1 py-2 px-4 rounded-md text-sm font-bold bg-emerald-500 text-white';
    $('tab-j2m').className = 'flex-1 py-2 px-4 rounded-md text-sm font-bold text-zinc-400';
    $('form-m2j').classList.remove('hidden');
    $('form-j2m').classList.add('hidden');
    $('r-label').textContent = '전세 환산';
    calc();
  });

  $('rate').addEventListener('input', () => { $('rateVal').textContent = (+$('rate').value).toFixed(1) + '%'; calc(); });

  function calc() {
    const rate = (+$('rate').value || 0) / 100;
    if (mode === 'j2m') {
      const jeonse = +$('jeonse').value || 0;
      const conv = Math.min(+$('convertAmt').value || 0, jeonse);
      const newDeposit = jeonse - conv;
      const monthly = conv * rate / 12;
      $('r-main').textContent = fmt(monthly) + '/월';
      $('r-sub').textContent = `보증금 ${fmt(newDeposit)} + 월세 ${fmt(monthly)} (전환금 ${fmt(conv)})`;
    } else {
      const deposit = +$('depositM').value || 0;
      const monthly = +$('monthlyM').value || 0;
      // 월세 → 전세 환산 = 보증금 + (월세 × 12 / 전환율)
      const jeonse = deposit + (monthly * 12 / rate);
      $('r-main').textContent = fmt(jeonse);
      $('r-sub').textContent = `보증금 ${fmt(deposit)} + 월세 환산 ${fmt(monthly * 12 / rate)}`;
    }
    if (window.va) { try { window.va('event', { name: 'jeonse_conv', data: { mode, rate } }); } catch (_) {} }
  }

  ['jeonse','convertAmt','depositM','monthlyM'].forEach((id) => {
    const el = $(id);
    if (el) { el.addEventListener('input', calc); el.addEventListener('change', calc); }
  });
  calc();
</script>
