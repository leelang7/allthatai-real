---
/**
 * /tools/wedding-cost — 결혼 비용 종합 계산.
 *
 * 한국 매우 큰 검색량 + 광고 단가 큼 (웨딩 카테고리).
 */
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="결혼 비용 계산기 — 예식·신혼집·예단·신혼여행 종합 평균"
  description="한국 결혼 비용 종합 계산. 예식장·스드메·예단·신혼여행·신혼집까지 8개 항목 평균 + 본인 입력."
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-pink-500/30 bg-pink-500/5 px-3 py-1 text-xs text-pink-300">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-pink-400"></span>
      2026 결혼 정보
    </div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight">
      <span class="text-gradient">결혼 비용</span> 종합
    </h1>
    <p class="mt-4 text-lg text-zinc-400 leading-relaxed">예식·스드메·예단·신혼집까지 8개 항목 본인 입력 → 총 비용 + 평균 비교.</p>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-3" id="form">
      <!-- inputs auto-generated -->
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-2">
    <div class="rounded-3xl border-2 border-pink-500/40 bg-gradient-to-br from-pink-500/15 to-rose-500/5 p-8">
      <p class="text-[10px] font-bold text-pink-300 uppercase tracking-widest">총 결혼 비용</p>
      <p id="r-total" class="mt-2 text-5xl sm:text-6xl font-black text-white tabular-nums">-</p>
      <p id="r-vs-avg" class="mt-3 text-sm text-zinc-300"></p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
      <h2 class="font-black mb-3">한국 결혼 비용 평균 (2026)</h2>
      <ul class="space-y-2 text-sm text-zinc-300">
        <li>→ <strong>총 평균</strong>: ₩3억 5천만 (신혼집 ₩2.5억 + 결혼식·신혼여행 ₩1억)</li>
        <li>→ <strong>예식장</strong>: 평균 ₩1,000만 (강남 ₩2,000만+)</li>
        <li>→ <strong>스드메 (스튜디오·드레스·메이크업)</strong>: ₩400–800만</li>
        <li>→ <strong>예단·예물</strong>: ₩1,000–3,000만 (지역·집안 따라)</li>
        <li>→ <strong>신혼여행</strong>: 동남아 ₩500만 / 유럽 ₩1,200만</li>
        <li>→ <strong>가전·가구</strong>: ₩1,500–3,000만 (이사 + 인테리어 별도)</li>
      </ul>
      <p class="mt-3 text-xs text-zinc-500">※ 듀오웨드 + 결혼정보회사 2026 통계 기반</p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-4">
    <div class="grid sm:grid-cols-3 gap-2">
      <a href="/tools/loan-compare/" class="rounded-xl border border-zinc-800 hover:border-pink-500/40 bg-zinc-900/40 p-3 transition text-sm">대출 계산기 →</a>
      <a href="/tools/acquisition-tax/" class="rounded-xl border border-zinc-800 hover:border-pink-500/40 bg-zinc-900/40 p-3 transition text-sm">취득세 (신혼) →</a>
      <a href="/jeonse/" class="rounded-xl border border-zinc-800 hover:border-pink-500/40 bg-zinc-900/40 p-3 transition text-sm">전세사기 방지 →</a>
    </div>
  </section>
</Layout>

<script is:inline>
  const items = [
    { id: 'wedding-hall', name: '예식장 + 음식', avg: 12000000, default: 12000000 },
    { id: 'wedding-photo', name: '스튜디오·드레스·메이크업 (스드메)', avg: 5000000, default: 5000000 },
    { id: 'wedding-jewel', name: '예단·예물·한복', avg: 15000000, default: 15000000 },
    { id: 'honeymoon', name: '신혼여행', avg: 7000000, default: 7000000 },
    { id: 'home-deposit', name: '신혼집 (전세보증금 or 매수)', avg: 200000000, default: 200000000 },
    { id: 'home-interior', name: '인테리어·도배·기본 공사', avg: 15000000, default: 15000000 },
    { id: 'home-furniture', name: '가전·가구·생활용품', avg: 20000000, default: 20000000 },
    { id: 'misc', name: '기타 (선물·헝겊·예복 등)', avg: 5000000, default: 5000000 },
  ];

  const totalAvg = items.reduce((s, i) => s + i.avg, 0);

  const form = document.getElementById('form');
  form.innerHTML = items.map((i) => `
    <label class="block">
      <span class="block text-xs font-bold text-zinc-300 mb-1.5">${i.name} <span class="text-zinc-500 text-[10px]">(평균 ₩${Math.round(i.avg/10000).toLocaleString()}만)</span></span>
      <input data-id="${i.id}" type="number" value="${i.default}" step="1000000" class="cost-input w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-pink-500 outline-none px-4 py-2.5 text-white tabular-nums" />
    </label>
  `).join('');

  function calc() {
    let total = 0;
    document.querySelectorAll('.cost-input').forEach((el) => { total += +el.value || 0; });
    document.getElementById('r-total').textContent = '₩' + total.toLocaleString('ko-KR');
    const diff = total - totalAvg;
    const pct = (diff / totalAvg * 100).toFixed(1);
    if (diff > 0) {
      document.getElementById('r-vs-avg').innerHTML = `평균 대비 <strong class="text-rose-300">${pct}%</strong> 많음 (₩${Math.round(Math.abs(diff)/10000).toLocaleString()}만 추가)`;
    } else if (diff < 0) {
      document.getElementById('r-vs-avg').innerHTML = `평균 대비 <strong class="text-emerald-300">${Math.abs(pct)}%</strong> 절약 (₩${Math.round(Math.abs(diff)/10000).toLocaleString()}만 적게)`;
    } else {
      document.getElementById('r-vs-avg').textContent = '평균과 동일';
    }

    if (window.va) { try { window.va('event', { name: 'wedding_calc', data: { total } }); } catch (_) {} }
  }
  document.querySelectorAll('.cost-input').forEach((el) => el.addEventListener('input', calc));
  calc();
</script>
