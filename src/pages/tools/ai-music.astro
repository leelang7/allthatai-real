---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="AI 플레이리스트 — 기분·상황 → 15곡" description="기분·상황·취향 → Gemini가 15곡 플레이리스트 + 추천 이유 + 유사 아티스트 자동.">
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8"><h1 class="text-4xl sm:text-5xl font-black"><span class="text-gradient">AI 플레이리스트</span></h1><p class="mt-4 text-lg text-zinc-400">기분·상황 → 15곡.</p></section>
  <section class="mx-auto max-w-3xl px-4 py-6"><div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-3">
    <div class="grid sm:grid-cols-2 gap-3">
      <input id="mood" type="text" placeholder="기분 (예: 우울, 신나는, 차분한)" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-pink-500 outline-none px-4 py-2.5 text-white" />
      <input id="situation" type="text" placeholder="상황 (예: 운동, 공부, 드라이브)" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-pink-500 outline-none px-4 py-2.5 text-white" />
    </div>
    <input id="genres" type="text" placeholder="좋아하는 장르 (예: 인디, 발라드, EDM)" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-pink-500 outline-none px-4 py-2.5 text-white" />
    <input id="favoriteArtists" type="text" placeholder="좋아하는 아티스트" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-pink-500 outline-none px-4 py-2.5 text-white" />
    <div class="grid sm:grid-cols-2 gap-3">
      <select id="era" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-pink-500 outline-none px-3 py-2 text-white"><option value="any">시대 무관</option><option value="recent">최근 3년</option><option value="2010s">2010년대</option><option value="2000s">2000년대</option><option value="classic">올드 팝</option></select>
      <select id="language" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-pink-500 outline-none px-3 py-2 text-white"><option value="mixed">혼합</option><option value="kpop">K-POP</option><option value="pop">팝</option><option value="jpop">J-POP</option></select>
    </div>
    <button id="go" type="button" class="w-full rounded-lg bg-pink-500 hover:bg-pink-400 text-white font-black py-3 disabled:opacity-50">AI 플레이리스트</button>
    <p id="status" class="text-xs text-zinc-400 text-center"></p>
  </div></section>
  <section id="result" class="hidden mx-auto max-w-3xl px-4 py-2 space-y-3">
    <div class="rounded-2xl border border-pink-500/40 bg-pink-500/5 p-5"><h2 id="name" class="font-black text-2xl text-white"></h2><p id="vibe" class="mt-2 text-sm text-zinc-200"></p><div class="mt-3 flex flex-wrap gap-3 text-xs"><span>총 <span id="totalMin" class="font-black"></span>분</span><span class="text-zinc-400" id="flow"></span></div></div>
    <div id="tracks" class="space-y-1"></div>
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border border-cyan-500/40 bg-cyan-500/5 p-5"><h4 class="text-xs font-black text-cyan-300 uppercase mb-2">플랫폼</h4><ul id="platforms" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
      <div class="rounded-2xl border border-amber-500/40 bg-amber-500/5 p-5"><h4 class="text-xs font-black text-amber-300 uppercase mb-2">유사 아티스트</h4><div id="similar" class="flex flex-wrap gap-2"></div></div>
    </div>
    <p id="alt" class="text-xs text-zinc-500 italic"></p>
  </section>
</Layout>
<script is:inline>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  $('go').addEventListener('click', async () => {
    if (!$('mood').value && !$('situation').value) { $('status').textContent = '⚠ 기분 또는 상황 필수'; $('status').className = 'text-xs text-rose-300 text-center'; return; }
    $('go').disabled = true; $('status').textContent = '🤖 큐레이션 중...'; $('status').className = 'text-xs text-pink-300 text-center animate-pulse';
    const body = {}; ['mood','situation','genres','favoriteArtists','era','language'].forEach((id) => { body[id] = $(id).value; });
    try {
      const res = await fetch('/api/ai-music', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const data = await res.json();
      if (!data.ok) { $('status').textContent = '❌ ' + data.error; $('status').className = 'text-xs text-rose-300 text-center'; $('go').disabled = false; return; }
      $('result').classList.remove('hidden'); $('status').textContent = '✓ 완료'; $('status').className = 'text-xs text-emerald-300 text-center';
      $('name').textContent = data.playlistName || '';
      $('vibe').textContent = data.vibe || '';
      $('totalMin').textContent = data.totalMinutes || 0;
      $('flow').textContent = data.moodFlow || '';
      $('tracks').innerHTML = (data.tracks || []).map((t, i) => `<div class="flex items-start gap-3 rounded-lg bg-zinc-900/60 p-3"><span class="text-xs font-black text-zinc-500 w-6">${(i+1).toString().padStart(2, '0')}</span><div class="flex-1"><p class="text-sm font-bold text-white">${esc(t.title || '')} <span class="text-xs text-zinc-400">— ${esc(t.artist || '')}</span></p><p class="text-xs text-zinc-500">${esc(t.genre || '')} · ${t.year || '-'}</p><p class="text-xs text-zinc-400 mt-1">${esc(t.reason || '')}</p></div></div>`).join('');
      $('platforms').innerHTML = (data.platforms || []).map((p) => `<li>${esc(p.name || '')}: ${esc(p.link || '')}</li>`).join('');
      $('similar').innerHTML = (data.similarArtists || []).map((a) => `<span class="text-xs font-bold px-3 py-1 rounded-full bg-zinc-700 text-zinc-200">${esc(a)}</span>`).join('');
      $('alt').textContent = data.alternativeVibe || '';
      if (window.va) { try { window.va('event', { name: 'ai_music' }); } catch (_) {} }
    } catch (e) { $('status').textContent = '❌ ' + e.message; $('status').className = 'text-xs text-rose-300 text-center'; }
    finally { $('go').disabled = false; }
  });
</script>
