---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="AI 마인드맵 — 주제 → 구조화 노드 + 실행 단계" description="주제 → Gemini가 1·2차 가지 + 인사이트 + 실행 단계 + 탐구 질문 자동.">
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8"><h1 class="text-4xl sm:text-5xl font-black"><span class="text-gradient">AI 마인드맵</span></h1><p class="mt-4 text-lg text-zinc-400">주제 → 가지·노드.</p></section>
  <section class="mx-auto max-w-3xl px-4 py-6"><div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-3">
    <input id="topic" type="text" placeholder="주제 (예: 사업 아이디어 검증, 면접 준비)" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-yellow-500 outline-none px-4 py-2.5 text-white" />
    <div class="grid sm:grid-cols-2 gap-3">
      <select id="purpose" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-yellow-500 outline-none px-3 py-2 text-white"><option value="learning">학습</option><option value="planning">기획</option><option value="brainstorm">브레인스토밍</option><option value="problem">문제해결</option></select>
      <select id="depth" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-yellow-500 outline-none px-3 py-2 text-white"><option value="3">3개 가지</option><option value="4">4개 가지</option><option value="5">5개 가지</option></select>
    </div>
    <button id="go" type="button" class="w-full rounded-lg bg-yellow-500 hover:bg-yellow-400 text-white font-black py-3 disabled:opacity-50">AI 마인드맵</button>
    <p id="status" class="text-xs text-zinc-400 text-center"></p>
  </div></section>
  <section id="result" class="hidden mx-auto max-w-3xl px-4 py-2 space-y-3">
    <div class="rounded-3xl border-2 border-yellow-500/40 bg-gradient-to-br from-yellow-500/15 to-amber-500/5 p-8 text-center"><p class="text-[10px] font-bold text-yellow-300 uppercase tracking-widest">중심 주제</p><p id="central" class="mt-2 text-3xl font-black text-white"></p></div>
    <div id="branches" class="space-y-3"></div>
    <div class="rounded-2xl border border-emerald-500/40 bg-emerald-500/5 p-5"><h4 class="text-xs font-black text-emerald-300 uppercase mb-3">💡 핵심 인사이트</h4><ul id="insights" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border border-cyan-500/40 bg-cyan-500/5 p-5"><h4 class="text-xs font-black text-cyan-300 uppercase mb-2">📌 실행 단계</h4><ul id="steps" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
      <div class="rounded-2xl border border-violet-500/40 bg-violet-500/5 p-5"><h4 class="text-xs font-black text-violet-300 uppercase mb-2">❓ 탐구 질문</h4><ul id="questions" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
    </div>
    <div class="rounded-2xl border border-zinc-700 bg-zinc-900/40 p-5"><h4 class="text-xs font-black text-zinc-300 uppercase mb-2">🔗 관련 주제</h4><div id="related" class="flex flex-wrap gap-2"></div></div>
  </section>
</Layout>
<script is:inline>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  $('go').addEventListener('click', async () => {
    if (!$('topic').value.trim()) { $('status').textContent = '⚠ 주제 필수'; $('status').className = 'text-xs text-rose-300 text-center'; return; }
    $('go').disabled = true; $('status').textContent = '🤖 마인드맵 생성 중...'; $('status').className = 'text-xs text-yellow-300 text-center animate-pulse';
    try {
      const res = await fetch('/api/ai-mindmap', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ topic: $('topic').value, purpose: $('purpose').value, depth: $('depth').value }) });
      const data = await res.json();
      if (!data.ok) { $('status').textContent = '❌ ' + data.error; $('status').className = 'text-xs text-rose-300 text-center'; $('go').disabled = false; return; }
      $('result').classList.remove('hidden'); $('status').textContent = '✓ 완료'; $('status').className = 'text-xs text-emerald-300 text-center';
      $('central').textContent = data.central || '';
      const colors = ['yellow', 'cyan', 'pink', 'emerald', 'violet'];
      $('branches').innerHTML = (data.branches || []).map((b, i) => {
        const c = colors[i % colors.length];
        return `<div class="rounded-2xl border border-${c}-500/40 bg-${c}-500/5 p-5"><h4 class="font-black text-lg text-white mb-3">${esc(b.label || '')}</h4><div class="space-y-2 pl-4 border-l-2 border-${c}-500/30">${(b.children || []).map((ch) => `<div><p class="text-sm font-bold text-${c}-300">${esc(ch.label || '')}</p><p class="text-xs text-zinc-400 mt-1">${esc(ch.details || '')}</p></div>`).join('')}</div></div>`;
      }).join('');
      $('insights').innerHTML = (data.keyInsights || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('steps').innerHTML = (data.actionableSteps || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('questions').innerHTML = (data.questionsToExplore || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('related').innerHTML = (data.relatedTopics || []).map((t) => `<span class="text-xs font-bold px-3 py-1 rounded-full bg-zinc-700 text-zinc-200">${esc(t)}</span>`).join('');
      if (window.va) { try { window.va('event', { name: 'ai_mindmap' }); } catch (_) {} }
    } catch (e) { $('status').textContent = '❌ ' + e.message; $('status').className = 'text-xs text-rose-300 text-center'; }
    finally { $('go').disabled = false; }
  });
</script>
