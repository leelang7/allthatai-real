---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="AI 매물 광고 작성 — 직거래·중개 매도자용 SEO 광고문 자동" description="매물 정보 → Gemini가 제목·본문·해시태그·플랫폼별 팁 자동. 직거래 부동산 매도 도구.">
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-lime-500/30 bg-lime-500/5 px-3 py-1 text-xs text-lime-300"><span class="inline-block w-1.5 h-1.5 rounded-full bg-lime-400"></span>Gemini — 광고 작성</div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight"><span class="text-gradient">AI 매물 광고</span></h1>
    <p class="mt-4 text-lg text-zinc-400">직거래·중개 광고 자동.</p>
  </section>
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-3">
      <div class="grid sm:grid-cols-2 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">매물 유형</span><select id="propertyType" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-lime-500 outline-none px-4 py-2.5 text-white"><option>아파트</option><option>빌라</option><option>오피스텔</option><option>주택</option><option>상가</option></select></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">거래</span><select id="dealType" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-lime-500 outline-none px-4 py-2.5 text-white"><option value="sale">매매</option><option value="jeonse">전세</option><option value="monthly">월세</option></select></label>
      </div>
      <div class="grid sm:grid-cols-3 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">매매가/전세가 (₩)</span><input id="price" type="number" value="500000000" step="10000000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-lime-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">보증금 (월세)</span><input id="deposit" type="number" value="0" step="10000000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-lime-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">월세</span><input id="monthly" type="number" value="0" step="50000" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-lime-500 outline-none px-3 py-2 text-white tabular-nums" /></label>
      </div>
      <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">위치 (시·구·동)</span><input id="region" type="text" placeholder="예: 서울 마포구 공덕동" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-lime-500 outline-none px-4 py-2.5 text-white" /></label>
      <div class="grid sm:grid-cols-2 gap-3">
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">단지/건물명</span><input id="complex" type="text" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-lime-500 outline-none px-4 py-2.5 text-white" /></label>
        <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">면적·층·방</span><input id="area" type="text" placeholder="84m² · 10층 · 3룸 2욕" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-lime-500 outline-none px-4 py-2.5 text-white" /></label>
      </div>
      <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">강점·특징 (콤마)</span><textarea id="features" rows="2" placeholder="예: 남향, 역세권 도보 5분, 학군 우수, 풀옵션, 리모델링 완료" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-lime-500 outline-none px-4 py-2.5 text-sm text-zinc-200"></textarea></label>
      <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">단점 (정직 공개 - 신뢰 ↑)</span><input id="cons" type="text" placeholder="예: 1층, 엘리베이터 X, 주차 1대" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-lime-500 outline-none px-4 py-2.5 text-white" /></label>
      <button id="go" type="button" class="w-full rounded-lg bg-lime-500 hover:bg-lime-400 text-white font-black py-3 disabled:opacity-50">AI 광고 작성</button>
      <p id="status" class="text-xs text-zinc-400 text-center"></p>
    </div>
  </section>
  <section id="result" class="hidden mx-auto max-w-3xl px-4 py-2 space-y-3">
    <div class="rounded-2xl border border-lime-500/40 bg-lime-500/5 p-5">
      <div class="flex items-start justify-between mb-2">
        <h3 id="title" class="font-black text-2xl text-white">-</h3>
        <button id="copyAll" type="button" class="text-xs font-bold px-3 py-1.5 rounded-md bg-lime-500 hover:bg-lime-400 text-white whitespace-nowrap">📋 전체 복사</button>
      </div>
      <p id="shortDesc" class="text-sm text-zinc-200 mb-3"></p>
      <pre id="fullDesc" class="whitespace-pre-wrap text-sm text-zinc-200 bg-zinc-900/60 rounded-lg p-4 leading-relaxed"></pre>
      <div class="mt-3 flex flex-wrap gap-2" id="hashtags"></div>
      <p id="cta" class="mt-3 text-sm font-bold text-lime-300"></p>
    </div>
    <div class="rounded-2xl border border-emerald-500/40 bg-emerald-500/5 p-5"><h4 class="text-xs font-black text-emerald-300 uppercase tracking-widest mb-3">⭐ 대표 강점</h4><ul id="highlights" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
    <div class="rounded-2xl border border-cyan-500/40 bg-cyan-500/5 p-5"><h4 class="text-xs font-black text-cyan-300 uppercase tracking-widest mb-3">📱 플랫폼별 팁</h4><div id="platforms" class="space-y-2"></div></div>
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border border-amber-500/40 bg-amber-500/5 p-5"><h4 class="text-xs font-black text-amber-300 uppercase tracking-widest mb-3">✏ 정직성 체크</h4><ul id="honesty" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
      <div class="rounded-2xl border border-violet-500/40 bg-violet-500/5 p-5"><h4 class="text-xs font-black text-violet-300 uppercase tracking-widest mb-3">📸 사진 팁</h4><ul id="photo" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
    </div>
  </section>
</Layout>
<script is:inline>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  $('go').addEventListener('click', async () => {
    if (!$('region').value.trim()) { $('status').textContent = '⚠ 위치 필수'; $('status').className = 'text-xs text-rose-300 text-center'; return; }
    $('go').disabled = true; $('status').textContent = '🤖 광고 작성 중...'; $('status').className = 'text-xs text-lime-300 text-center animate-pulse';
    const body = {};
    ['propertyType','dealType','price','deposit','monthly','region','complex','area','features','cons'].forEach((id) => { body[id] = $(id).value; });
    try {
      const res = await fetch('/api/ai-listing-write', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const data = await res.json();
      if (!data.ok) { $('status').textContent = '❌ ' + data.error; $('status').className = 'text-xs text-rose-300 text-center'; $('go').disabled = false; return; }
      $('result').classList.remove('hidden'); $('status').textContent = '✓ 완료'; $('status').className = 'text-xs text-emerald-300 text-center';
      $('title').textContent = data.title || '';
      $('shortDesc').textContent = data.shortDesc || '';
      $('fullDesc').textContent = data.fullDescription || '';
      $('cta').textContent = data.callToAction || '';
      $('hashtags').innerHTML = (data.hashtags || []).map((h) => `<span class="text-xs font-bold px-2 py-1 rounded bg-zinc-700 text-zinc-200">${esc(h)}</span>`).join('');
      $('highlights').innerHTML = (data.highlights || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('platforms').innerHTML = (data.platforms || []).map((p) => `<div class="rounded-lg bg-zinc-900/60 p-3"><p class="text-sm font-bold text-cyan-300">${esc(p.platform || '')}</p><p class="text-xs text-zinc-300 mt-1">${esc(p.tip || '')}</p></div>`).join('');
      $('honesty').innerHTML = (data.honestyCheck || []).map((x) => `<li>${esc(x)}</li>`).join('') || '<li class="list-none text-zinc-500">정직성 OK</li>';
      $('photo').innerHTML = (data.photoTips || []).map((x) => `<li>${esc(x)}</li>`).join('');
      if (window.va) { try { window.va('event', { name: 'ai_listing_write' }); } catch (_) {} }
    } catch (e) { $('status').textContent = '❌ ' + e.message; $('status').className = 'text-xs text-rose-300 text-center'; }
    finally { $('go').disabled = false; }
  });
  $('copyAll').addEventListener('click', () => {
    const text = ($('title').textContent + '\n\n' + $('shortDesc').textContent + '\n\n' + $('fullDesc').textContent + '\n\n' + Array.from($('hashtags').children).map(c => c.textContent).join(' '));
    navigator.clipboard.writeText(text).then(() => { $('copyAll').textContent = '✓ 복사됨'; setTimeout(() => { $('copyAll').textContent = '📋 전체 복사'; }, 2000); });
  });
</script>
