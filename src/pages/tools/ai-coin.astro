---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="AI 코인 분석 — 펀더멘털·기술·리스크·러그 신호" description="코인명 → Gemini가 용도·토크노믹스·긍정/부정·리스크·러그 신호 자동.">
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-yellow-500/30 bg-yellow-500/5 px-3 py-1 text-xs text-yellow-300"><span class="inline-block w-1.5 h-1.5 rounded-full bg-yellow-400"></span>Gemini — 코인 분석</div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight"><span class="text-gradient">AI 코인 분석</span></h1>
    <p class="mt-4 text-lg text-zinc-400">펀더멘털 + 리스크 + 러그 신호.</p>
  </section>
  <section class="mx-auto max-w-3xl px-4 py-6">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 space-y-3">
      <label class="block"><span class="block text-xs font-bold text-zinc-300 mb-1.5">코인명 / 심볼 *</span><input id="coin" type="text" value="비트코인" placeholder="예: 비트코인, ETH, 도지코인" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-yellow-500 outline-none px-4 py-2.5 text-white" /></label>
      <textarea id="context" rows="2" placeholder="추가 맥락 (선택)" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-yellow-500 outline-none px-4 py-2.5 text-sm text-zinc-200"></textarea>
      <button id="go" type="button" class="w-full rounded-lg bg-yellow-500 hover:bg-yellow-400 text-white font-black py-3 disabled:opacity-50">AI 코인 분석</button>
      <p id="status" class="text-xs text-zinc-400 text-center"></p>
      <p class="text-[10px] text-zinc-500 text-center">⚠ 정보 제공용. 암호화폐는 매우 위험</p>
    </div>
  </section>
  <section id="result" class="hidden mx-auto max-w-3xl px-4 py-2 space-y-3">
    <div id="box" class="rounded-3xl border-2 p-8">
      <p class="text-[10px] font-bold uppercase tracking-widest" id="lbl">의견</p>
      <p id="verdict" class="mt-2 text-4xl font-black">-</p>
      <p id="name" class="mt-2 text-lg text-zinc-300">-</p>
      <div class="mt-3 flex flex-wrap gap-3 text-sm"><span>카테고리: <span id="category" class="font-black">-</span></span><span>시총 등급: <span id="tier" class="font-black">-</span></span><span>리스크: <span id="riskScore" class="font-black">-</span></span></div>
    </div>
    <div class="rounded-2xl border border-cyan-500/40 bg-cyan-500/5 p-5"><h4 class="text-xs font-black text-cyan-300 uppercase tracking-widest mb-3">📚 펀더멘털</h4><div id="fundamentals" class="space-y-1 text-sm text-zinc-300"></div></div>
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border border-emerald-500/40 bg-emerald-500/5 p-5"><h4 class="text-xs font-black text-emerald-300 uppercase tracking-widest mb-3">👍 긍정</h4><ul id="bull" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
      <div class="rounded-2xl border border-rose-500/40 bg-rose-500/5 p-5"><h4 class="text-xs font-black text-rose-300 uppercase tracking-widest mb-3">👎 부정</h4><ul id="bear" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
    </div>
    <div class="rounded-2xl border border-violet-500/40 bg-violet-500/5 p-5"><h4 class="text-xs font-black text-violet-300 uppercase tracking-widest mb-3">📈 기술적 분석</h4><p id="technical" class="text-sm text-zinc-300"></p></div>
    <div class="rounded-2xl border border-rose-500/40 bg-rose-500/5 p-5"><h4 class="text-xs font-black text-rose-300 uppercase tracking-widest mb-3">🚨 러그·사기 신호</h4><ul id="redFlags" class="space-y-1 text-sm text-zinc-300 list-disc list-inside"></ul></div>
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="rounded-2xl border border-amber-500/40 bg-amber-500/5 p-5"><h4 class="text-xs font-black text-amber-300 uppercase tracking-widest mb-3">⚖ 경쟁 코인</h4><p id="competitor" class="text-sm text-zinc-300"></p></div>
      <div class="rounded-2xl border border-blue-500/40 bg-blue-500/5 p-5"><h4 class="text-xs font-black text-blue-300 uppercase tracking-widest mb-3">⚠ 규제 위험</h4><p id="regulatory" class="text-sm text-zinc-300"></p></div>
    </div>
    <div class="rounded-2xl border border-zinc-700 bg-zinc-900/40 p-5"><h4 class="text-xs font-black text-zinc-300 uppercase tracking-widest mb-3">조언</h4><p id="advice" class="text-sm font-bold text-yellow-300"></p></div>
  </section>
</Layout>
<script is:inline>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  $('go').addEventListener('click', async () => {
    if (!$('coin').value.trim()) { $('status').textContent = '⚠ 코인명 필수'; $('status').className = 'text-xs text-rose-300 text-center'; return; }
    $('go').disabled = true; $('status').textContent = '🤖 코인 분석 중...'; $('status').className = 'text-xs text-yellow-300 text-center animate-pulse';
    try {
      const res = await fetch('/api/ai-coin', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ coin: $('coin').value, context: $('context').value }) });
      const data = await res.json();
      if (!data.ok) { $('status').textContent = '❌ ' + data.error; $('status').className = 'text-xs text-rose-300 text-center'; $('go').disabled = false; return; }
      $('result').classList.remove('hidden'); $('status').textContent = '✓ 완료'; $('status').className = 'text-xs text-emerald-300 text-center';
      const v = data.verdict || '-';
      let color = 'text-amber-300', bg = 'border-amber-500/40 bg-amber-500/5';
      if (v === '장기보유') { color = 'text-emerald-300'; bg = 'border-emerald-500/40 bg-emerald-500/5'; }
      else if (v === '회피') { color = 'text-rose-300'; bg = 'border-rose-500/40 bg-rose-500/10'; }
      $('box').className = 'rounded-3xl border-2 p-8 ' + bg;
      $('lbl').className = 'text-[10px] font-bold uppercase tracking-widest ' + color;
      $('verdict').className = 'mt-2 text-4xl font-black ' + color;
      $('verdict').textContent = v;
      $('name').textContent = (data.name || '') + ' (' + (data.symbol || '') + ')';
      $('category').textContent = data.category || '-';
      $('tier').textContent = data.marketCapTier || '-';
      $('riskScore').textContent = (data.riskScore || 0) + '/100';
      const f = data.fundamentals || {};
      $('fundamentals').innerHTML = `<p><strong>용도:</strong> ${esc(f.useCase || '-')}</p><p><strong>토크노믹스:</strong> ${esc(f.tokenomics || '-')}</p><p><strong>팀:</strong> ${esc(f.team || '-')}</p>`;
      $('bull').innerHTML = (data.bullCase || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('bear').innerHTML = (data.bearCase || []).map((x) => `<li>${esc(x)}</li>`).join('');
      $('technical').textContent = data.technicalView || '';
      $('redFlags').innerHTML = (data.redFlags || []).map((x) => `<li>${esc(x)}</li>`).join('') || '<li class="list-none text-zinc-500">탐지된 신호 없음</li>';
      $('competitor').textContent = data.competitorComparison || '';
      $('regulatory').textContent = data.regulatoryRisk || '';
      $('advice').textContent = data.actionableAdvice || '';
      if (window.va) { try { window.va('event', { name: 'ai_coin', data: { coin: $('coin').value } }); } catch (_) {} }
    } catch (e) { $('status').textContent = '❌ ' + e.message; $('status').className = 'text-xs text-rose-300 text-center'; }
    finally { $('go').disabled = false; }
  });
</script>
