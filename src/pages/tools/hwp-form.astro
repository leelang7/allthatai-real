---
import Layout from '../../layouts/Layout.astro';

const SITE = 'https://real.allthatai.kr';
const URL_ = `${SITE}/tools/hwp-form/`;

// 화면의 FAQ 와 FAQPage 스키마를 같은 데이터로 만든다(검색엔진은 보이는 질문과 다르면 무시한다).
// ★ 여기 적는 말은 전부 실측한 사실만 — 2026-09~10 운영 서버에서 양식 30여 종으로 확인했다.
const faqs = [
  { q: '한컴오피스(한글 프로그램)가 없어도 되나요?',
    a: '네. 브라우저만 있으면 됩니다. 만든 파일은 rhwp 크롬 확장, 한컴독스 웹(무료), 네이버 MYBOX에서 열어 보고 고칠 수 있고, 이 페이지에서도 내려받기 전에 쪽별로 미리 볼 수 있습니다.' },
  { q: '옛 한글 파일(.hwp)도 되나요?',
    a: '됩니다. .hwp를 올리면 브라우저 안에서 .hwpx로 바꾼 뒤 채웁니다. 결과는 한글에서 그대로 열리는 .hwpx 파일로 받습니다.' },
  { q: '올린 파일이 서버에 저장되나요?',
    a: '아니요. 파일 읽기, 빈칸 찾기, 채우기, 검사, 미리보기가 전부 이 브라우저 안에서 일어나고 파일은 어디로도 전송되지 않습니다.' },
  { q: '어떤 양식에 쓸 수 있나요?',
    a: '공모전·지원사업의 참가신청서, 사업계획서, 아이디어 제안서, 기획서처럼 표 안에 빈칸이 있는 양식입니다. 파란 예시 글씨, "내용을 입력하세요" 같은 자리표시, 음영 제목 아래의 작성 요령 칸, 장학금 신청서의 "20   학년도  제   학기" 같은 문장 속 빈칸을 찾아 채웁니다. 문장 속 빈칸은 그 자리 글자만 바꿔 밑줄과 줄 배치가 그대로 남습니다. 공고문 본문이나 체크·서명만 하는 동의서는 채울 대상이 아닙니다.' },
  { q: '이름·연락처 같은 개인정보도 채워 주나요?',
    a: '개인정보 칸에는 표시를 달아 따로 알려 드립니다. 비워 두면 양식의 원래 예시가 그대로 남으니, 한글에서 직접 입력하세요.' },
  { q: '글자 크기나 분량 규정은 맞춰 주나요?',
    a: '양식 안에 "글자 크기 11pt, 줄간격 160%, 3쪽 이내"처럼 적힌 규정을 읽어 맞추고, 칸별 "○○자 이내" 제한도 입력란에 걸어 둡니다. 채운 뒤에는 글자 넘침, 흐린 예시 색 잔존 같은 결함을 검사해 결과를 보여 줍니다.' },
  { q: '휴대폰에서도 되나요?',
    a: '됩니다. 다만 처음 한 번은 문서 엔진(약 8MB)을 받느라 중급 휴대폰·4G에서 30초 안팎 걸립니다. 이 페이지를 여는 순간 받기 시작하고, 다음부터는 바로 시작됩니다.' },
];

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '한글 양식 자동 작성',
    url: URL_,
    applicationCategory: 'BusinessApplication',
    operatingSystem: '웹 브라우저',
    inLanguage: 'ko-KR',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
    description: '한글(.hwp/.hwpx) 신청서·사업계획서 양식의 빈칸을 찾아 채운 제출본을 만드는 무료 웹 도구. 파일은 서버로 전송되지 않는다.',
    publisher: { '@id': `${SITE}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: '도구', item: `${SITE}/tools/` },
      { '@type': 'ListItem', position: 3, name: '한글 양식 자동 작성', item: URL_ },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Layout title="한글(HWP) 신청서·사업계획서 무료 자동 작성 — 한컴오피스 없이" description="한글 .hwp·.hwpx 양식을 올리면 빈칸을 찾아 채우고 글자 크기·줄간격·칸 높이까지 맞춘 제출본을 만듭니다. 한컴오피스 설치·회원가입 없이 브라우저에서, 파일은 서버로 보내지 않습니다.">
  {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)}></script>)}
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-6">
    <h1 class="text-4xl sm:text-5xl font-black"><span class="text-gradient">한글 양식 자동 작성</span></h1>
    <p class="mt-4 text-lg text-zinc-400">신청서·사업계획서 양식(.hwp · .hwpx)을 올리면 빈칸을 찾아 채운 제출본을 만듭니다. 한컴오피스가 없어도 됩니다.</p>
    <p class="mt-2 text-xs text-emerald-300">🔒 파일이 서버로 가지 않습니다. 전부 이 브라우저 안에서 처리합니다.</p>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-2">
    <div id="drop" class="rounded-2xl border-2 border-dashed border-zinc-700 hover:border-violet-500 bg-zinc-900/40 p-10 text-center cursor-pointer transition">
      <p class="text-5xl">📄</p>
      <p class="mt-3 font-black text-white">양식 파일을 끌어다 놓거나 눌러서 고르세요</p>
      <p class="mt-1 text-xs text-zinc-500">.hwp · .hwpx 파일 · 결과는 한글에서 그대로 열리는 .hwpx로 받습니다</p>
      <input id="file" type="file" accept=".hwp,.hwpx" class="hidden" />
    </div>
    <p id="status" class="mt-3 text-xs text-zinc-400 text-center"></p>
  </section>

  <section id="empty" class="hidden mx-auto max-w-3xl px-4 py-4">
    <div class="rounded-2xl border border-amber-500/40 bg-amber-500/5 p-6">
      <p class="text-4xl">🔍</p>
      <p class="mt-3 font-black text-white">채울 빈칸을 찾지 못했습니다</p>
      <p id="emptyWhy" class="mt-2 text-sm text-zinc-300 leading-relaxed"></p>
      <p class="mt-3 text-xs text-zinc-400">제출용 양식 파일(신청서·계획서)을 올리면 빈칸을 찾아 채웁니다. 공고문 본문은 채울 대상이 아닙니다.</p>
    </div>
  </section>

  <section id="fields" class="hidden mx-auto max-w-3xl px-4 py-4 space-y-3">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-5">
      <h4 class="text-xs font-black text-zinc-300 uppercase tracking-widest">양식 분석</h4>
      <p id="meta" class="mt-2 text-sm text-zinc-300"></p>
      <p id="cons" class="mt-1 text-xs text-amber-300"></p>
    </div>
    <div id="slots" class="space-y-3"></div>
    <button id="make" type="button" class="w-full rounded-lg bg-violet-500 hover:bg-violet-400 text-white font-black py-3 disabled:opacity-50">제출본 만들기</button>
  </section>

  <section id="result" class="hidden mx-auto max-w-3xl px-4 py-2 space-y-3">
    <div id="verdict" class="rounded-3xl border-2 p-8 text-center"></div>
    <button id="dl" type="button" class="w-full rounded-lg bg-emerald-500 hover:bg-emerald-400 text-white font-black py-3">한글 파일(HWPX) 내려받기</button>
    <div id="previewBox" class="hidden rounded-2xl border border-zinc-800 bg-zinc-900/40 p-4 space-y-3">
      <h4 class="text-xs font-black text-zinc-300 uppercase tracking-widest">미리보기 — 내려받을 파일 그대로</h4>
      <p id="previewNote" class="text-xs text-zinc-500"></p>
      <div id="preview" class="space-y-3"></div>
      <div id="previewMore"></div>
    </div>
    <div id="findings" class="space-y-2"></div>
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-5">
      <h4 class="text-xs font-black text-zinc-300 uppercase tracking-widest mb-2">한글 프로그램 없이 열어보려면</h4>
      <ul class="space-y-1 text-sm text-zinc-300 list-disc list-inside">
        <li><a href="https://chromewebstore.google.com/detail/pgakpjflombjmehnebnbpnalhegaanag" target="_blank" rel="noopener" class="text-violet-300 hover:underline">rhwp 크롬 확장</a> — 가입 없이 바로 열고 편집</li>
        <li><a href="https://www.hancomdocs.com/" target="_blank" rel="noopener" class="text-violet-300 hover:underline">한컴독스 웹</a> — 무료 2GB, 편집은 웹·모바일에서</li>
        <li><a href="https://mybox.naver.com/" target="_blank" rel="noopener" class="text-violet-300 hover:underline">네이버 MYBOX</a> — 네이버 아이디로 한컴오피스 웹</li>
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pt-12 pb-6">
    <h2 class="text-xl font-black text-white">이렇게 씁니다</h2>
    <ol class="mt-4 space-y-3 text-sm text-zinc-300 leading-relaxed">
      <li><b class="text-violet-300">1. 양식 올리기</b> — 공고에 붙은 참가신청서·사업계획서·아이디어 제안서 파일(.hwp 또는 .hwpx)을 끌어다 놓습니다.</li>
      <li><b class="text-violet-300">2. 빈칸 채우기</b> — 찾아낸 칸이 항목 이름과 함께 입력란으로 뜹니다. 양식의 작성 요령과 글자 수 제한도 함께 보여 줍니다.</li>
      <li><b class="text-violet-300">3. 미리 보고 내려받기</b> — 서식(글꼴·줄간격·칸 높이)을 맞춘 제출본을 쪽별로 미리 본 뒤 .hwpx로 받습니다.</li>
    </ol>
  </section>

  <section class="mx-auto max-w-3xl px-4 pt-6 pb-24">
    <h2 class="text-xl font-black text-white">자주 묻는 질문</h2>
    <div class="mt-4 space-y-2">
      {faqs.map((f) => (
        <details class="rounded-xl border border-zinc-800 bg-zinc-900/40 px-4 py-3">
          <summary class="cursor-pointer text-sm font-bold text-zinc-200">{f.q}</summary>
          <p class="mt-2 text-sm text-zinc-400 leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>

<script is:inline>
  const PYODIDE = 'https://cdn.jsdelivr.net/pyodide/v314.0.6/full/';
  const ENGINE = ['profile_ref.py', 'form_tool.py', 'audit.py'];
  const WHEEL = '/hwpx/python_hwpx-6.4.0-py3-none-any.whl';
  const PERSONAL_RE = /성명|이름|성함|생년|휴대|전화|이메일|메일|소속|주소|연락|서명|직위|직급|학교|학년|나이|주민|사용자명|신청인|신청자명|대표자명|담당자/;
  // ★ 양식은 정렬하려고 '연 락 처'처럼 글자 사이를 띄운다. 띄어쓰기를 지우고 봐야 한다
  //   (거북섬마리나 신청서에서 '연 락 처'가 개인정보로 안 잡혀 채워진 것을 렌더로 발견).
  const isPersonal = (label) => PERSONAL_RE.test(String(label || '').replace(/\s+/g, ''));

  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const say = (msg, cls) => { $('status').textContent = msg; $('status').className = 'mt-3 text-xs text-center ' + (cls || 'text-zinc-400'); };

  let py = null, info = null, outBytes = null, busy = false;
  let srcName = '';   // 엔진은 늘 'form.hwpx'로 읽으므로, 사용자가 올린 원래 이름은 따로 들고 있는다
  const cellLabel = {};   // "표0(3,2)" → 라벨. 검사 결과가 알려주는 칸 위치를 사람 말로 되돌린다.

  // 엔진은 13MB다. 느린 폰에서 45초가 걸리므로 (1) 파일을 고르려는 낌새가 보이면 미리 받기 시작하고
  // (2) 받는 동안 경과 초를 보여 준다 — 멈춘 화면으로 오해해 떠나는 것을 막는다.
  let booting = null, tick = null;
  function startTick(label) {
    const t0 = Date.now();
    clearInterval(tick);
    tick = setInterval(() => {
      const s = Math.round((Date.now() - t0) / 1000);
      say(`${label} ${s}초 · 처음 한 번만 받습니다 (약 13MB). 다음부터는 바로 시작됩니다.`, 'text-violet-300');
    }, 1000);
  }
  // 중급폰 실측(4G·CPU÷4) 47초의 내역: 파이썬 본체 24s · micropip+설치 14s · 엔진 import 8s.
  // 설치는 '본체 다 받고 → micropip 받고 → wheel 받고 → lxml 받고'로 줄을 서서 생긴 대기였다.
  //  · lxml 은 loadPyodide 의 packages 로 본체와 동시에, 엔진 wheel·.py 는 그사이 미리 받아 둔다
  //  · micropip 없이 wheel 을 그대로 푼다(의존성은 lxml 하나뿐이다)
  //  · 엔진 import 까지 여기서 끝내 둔다 — 사용자가 파일을 고르는 동안 지나간다
  function boot() {
    if (py) return Promise.resolve(py);
    if (booting) return booting;
    booting = (async () => {
      const wheelP = fetch(WHEEL).then((r) => r.arrayBuffer());
      const srcP = Promise.all(ENGINE.map((f) => fetch('/hwpx/' + f).then((r) => r.text())));
      const mod = await import(PYODIDE + 'pyodide.mjs');
      const _py = await mod.loadPyodide({ indexURL: PYODIDE, packages: ['lxml'] });
      // 기본값은 작업 폴더라 import 가 안 된다 — site-packages 로 푼다
      const site = _py.runPython('import sysconfig; sysconfig.get_paths()["purelib"]');
      _py.unpackArchive(await wheelP, 'wheel', { extractDir: site });
      const srcs = await srcP;
      _py.FS.mkdir('/engine');
      ENGINE.forEach((f, i) => _py.FS.writeFile('/engine/' + f, srcs[i]));
      await _py.runPythonAsync('import sys, os\nsys.path.insert(0, "/engine")\nos.chdir("/engine")\nimport form_tool, audit');
      py = _py;
      return py;
    })();
    // 실패(네트워크 끊김 등)한 준비를 붙잡고 있으면 다시 시도할 길이 없다
    booting.catch(() => { booting = null; });
    return booting;
  }

  // 이 페이지에 온 사람은 쓰려고 온 사람이다 — 열리자마자 받기 시작해, 파일을 찾는 시간에 대기를 숨긴다.
  // 데이터 절약 모드나 3G 이하에서는 13MB를 함부로 받지 않고, 파일을 고를 때 받는다(아래 preload).
  (function eagerBoot() {
    const c = navigator.connection || {};
    if (c.saveData || /(^|-)2g|3g/.test(c.effectiveType || '')) return;
    const go = () => boot().catch(() => {});
    if ('requestIdleCallback' in window) requestIdleCallback(go, { timeout: 2500 });
    else setTimeout(go, 1200);
  })();

  // 앞 파일의 화면·결과를 모두 지운다. 이게 없으면 새 양식을 올려도 이전 빈칸과
  // 이전 제출본이 남아 있어, 엉뚱한 양식으로 채운 파일을 내려받게 된다.
  function reset() {
    info = null; outBytes = null;
    for (const k of Object.keys(cellLabel)) delete cellLabel[k];
    $('fields').classList.add('hidden');
    $('empty').classList.add('hidden');
    $('result').classList.add('hidden');
    $('slots').innerHTML = '';
    $('findings').innerHTML = '';
    clearPreview();
    $('meta').textContent = '';
    $('cons').textContent = '';
    $('status').textContent = '';    // 앞 파일의 성공·실패 문구가 남아 새 결과처럼 보이지 않게
    $('make').disabled = false;
  }

  // 한국 양식은 아직 대부분 옛 .hwp다(내 PC 기준 hwp 83 : hwpx 31, 양식류 hwp 33개).
  // rhwp(MIT, Rust→WASM)로 브라우저 안에서 HWPX로 바꾼 뒤 같은 엔진에 넣는다.
  // 실측: 양식 33개 전부 변환·열기 성공, 대부분 수십 ms. WASM 3.5MB(gzip)는 .hwp를 올린 사람만 받는다.
  let rhwp = null;
  async function loadRhwp() {
    if (!rhwp) {
      const m = await import('/hwpx/rhwp/rhwp.js');
      await m.default({ module_or_path: '/hwpx/rhwp/rhwp_bg.wasm' });
      rhwp = m;
    }
    return rhwp;
  }
  async function toHwpx(bytes) {
    await loadRhwp();
    const doc = new rhwp.HwpDocument(bytes);
    try { return doc.exportHwpx(); }
    finally { try { doc.free(); } catch (e) {} }
  }

  // 만든 제출본을 그 자리에서 쪽별로 보여 준다. 한컴오피스가 없는 사람은 내려받아도 열어 볼
  // 곳이 없어 '예쁜 서식으로 나왔는지' 확인할 길이 없었다. rhwp의 SVG 렌더(쪽당 수십 ms)를 쓴다.
  // ★ SVG는 <img>로만 띄운다 — 문서에서 나온 마크업을 innerHTML로 넣지 않는다(스크립트 차단).
  const PREVIEW_FIRST = 3;
  let previewUrls = [], previewGen = 0;
  function clearPreview() {
    previewGen++;          // 그리는 도중 새 파일이 오면 옛 미리보기가 뒤늦게 붙지 않게
    previewUrls.forEach((u) => URL.revokeObjectURL(u));
    previewUrls = [];
    $('preview').innerHTML = '';
    $('previewMore').innerHTML = '';
    $('previewBox').classList.add('hidden');
  }
  async function renderPreview(bytes) {
    clearPreview();
    const gen = previewGen;
    $('previewBox').classList.remove('hidden');
    $('previewNote').textContent = '미리보기를 그리는 중…';
    try {
      await loadRhwp();
      if (gen !== previewGen) return;
      const doc = new rhwp.HwpDocument(bytes);
      try {
        const n = doc.pageCount();
        const draw = (from, to) => {
          for (let i = from; i < to; i++) {
            const url = URL.createObjectURL(new Blob([doc.renderPageSvg(i)], { type: 'image/svg+xml' }));
            previewUrls.push(url);
            const img = document.createElement('img');
            img.src = url; img.alt = (i + 1) + '쪽'; img.loading = 'lazy';
            img.className = 'w-full rounded-lg bg-white shadow-lg';
            $('preview').appendChild(img);
          }
        };
        draw(0, Math.min(n, PREVIEW_FIRST));
        $('previewNote').textContent = `전체 ${n}쪽 · 글꼴은 기기에 설치된 것으로 대신 그려 한글과 조금 다를 수 있습니다.`;
        if (n > PREVIEW_FIRST) {
          const more = document.createElement('button');
          more.type = 'button';
          more.className = 'w-full rounded-lg border border-zinc-700 hover:border-violet-500 py-2 text-sm text-zinc-300';
          more.textContent = `나머지 ${n - PREVIEW_FIRST}쪽 더 보기`;
          more.onclick = () => {
            more.remove();
            const doc2 = new rhwp.HwpDocument(bytes);
            try {
              for (let i = PREVIEW_FIRST; i < n; i++) {
                const url = URL.createObjectURL(new Blob([doc2.renderPageSvg(i)], { type: 'image/svg+xml' }));
                previewUrls.push(url);
                const img = document.createElement('img');
                img.src = url; img.alt = (i + 1) + '쪽'; img.loading = 'lazy';
                img.className = 'w-full rounded-lg bg-white shadow-lg';
                $('preview').appendChild(img);
              }
            } finally { try { doc2.free(); } catch (e) {} }
          };
          $('previewMore').appendChild(more);
        }
      } finally { try { doc.free(); } catch (e) {} }
    } catch (e) {
      $('previewNote').textContent = '미리보기를 그리지 못했습니다. 내려받은 파일은 그대로 쓸 수 있습니다.';
    }
  }

  async function onFile(f) {
    if (!f) return;
    if (busy) { say('⏳ 앞 파일을 처리하는 중입니다. 잠시만요.', 'text-amber-300'); return; }
    reset();
    const lower = f.name.toLowerCase();
    const isHwp = lower.endsWith('.hwp');
    if (!isHwp && !lower.endsWith('.hwpx')) {
      say('⚠ 한글 파일(.hwp, .hwpx)만 됩니다.', 'text-rose-300');
      return;
    }
    if (f.size > 30 * 1024 * 1024) {
      say('⚠ 30MB가 넘는 파일은 브라우저에서 처리하기 어렵습니다.', 'text-rose-300');
      return;
    }
    busy = true;
    srcName = f.name;
    let bytes = new Uint8Array(await f.arrayBuffer());
    try {
      if (!py) startTick('⚙ 한글 문서 엔진을 준비하고 있습니다 —');
      else if (isHwp) say('🔄 옛 한글(.hwp)을 HWPX로 바꾸는 중…', 'text-violet-300 animate-pulse');
      // 파이썬 엔진 준비와 .hwp 변환을 동시에 — 느린 폰에서 두 대기를 겹친다
      const [, converted] = await Promise.all([boot(), isHwp ? toHwpx(bytes) : null]);
      if (isHwp) bytes = converted;
      clearInterval(tick);
      say('🔎 빈칸을 찾는 중…', 'text-violet-300 animate-pulse');
      py.FS.writeFile('/engine/form.hwpx', bytes);
      const raw = await py.runPythonAsync([
        'import io, json, sys',
        'import form_tool as FT',
        '_o = sys.stdout; sys.stdout = io.StringIO()',
        'try:',
        '    _r = FT.scan("form.hwpx")',
        'finally:',
        '    sys.stdout = _o',
        'json.dumps(_r, ensure_ascii=False)'
      ].join('\n'));
      info = JSON.parse(raw);
      render();
    } catch (e) {
      clearInterval(tick);
      const raw = String(e);
      const why = /password|암호|encrypt/i.test(raw) ? '암호가 걸린 한글 파일입니다. 한글에서 암호를 풀고 다시 저장해 올려주세요.'
        : /BadZipFile|not a zip|End of central|CFB|OLE|HwpDocument|parse/i.test(raw) ? '한글 파일이 아니거나 파일이 손상됐습니다.'
        : /KeyError|section0|header\.xml/i.test(raw) ? 'HWPX 구조가 아닙니다. 한글에서 다시 저장해 보세요.'
        : /Memory|Out of/i.test(raw) ? '파일이 너무 커서 이 기기에서 처리하지 못했습니다.'
        : (raw.split('\n').filter(Boolean).pop() || '').slice(0, 90)
          || '이 파일은 읽을 수 없습니다. 한글에서 HWPX로 다시 저장해 보세요.';
      say('❌ ' + why, 'text-rose-300');
    } finally {
      busy = false;
    }
  }

  // 라벨이 표 밖에 있어 못 찾은 칸은 '칸 7'로만 보인다. 그럴 땐 그 칸의 안내문
  // ("* 분석/시각화 결과 내용 (도표, 이미지…") 앞머리를 항목 이름으로 삼는다.
  function nameFromHint(hint) {
    let s = String(hint || '').replace(/^[\s*※•\-–—]+/, '').trim();
    s = s.split(/[(（:：]/)[0].trim();
    s = s.replace(/\s*(예시|작성|제시|기술|설명|내용)\s*$/, '').trim();
    return s.length >= 2 && s.length <= 24 ? s : '';
  }

  function render() {
    const items = [];
    (info.slots || []).forEach((s, i) => items.push({
      key: s.label || nameFromHint(s.current) || ('칸 ' + (i + 1)),
      limit: s.limit, hint: s.current, big: !!s.big_box, at: s, blanks: s.blanks || null,
    }));
    (info.narrative || []).forEach((n, i) => items.push({
      key: n.label || nameFromHint(n.guide) || ('서술 ' + (i + 1)),
      limit: n.limit, hint: n.guide, big: true, at: n,
    }));

    const seen = {};
    for (const it of items) {
      seen[it.key] = (seen[it.key] || 0) + 1;
      if (seen[it.key] > 1) it.key += ' (' + seen[it.key] + ')';
      if (it.at) cellLabel['표' + it.at.table + '(' + it.at.row + ',' + it.at.col + ')'] = it.key;
    }

    const c = info.constraints || {};
    const rules = [];
    if (c.font_pt) rules.push('글자 크기 ' + c.font_pt + 'pt');
    if (c.line_spacing) rules.push('줄간격 ' + c.line_spacing + '%');
    if (c.page_limit) rules.push(c.page_limit + '쪽 이내');
    if (c.font_family) rules.push('글꼴 ' + c.font_family);

    $('meta').textContent = srcName + ' · 표 ' + info.tables + '개 · 채울 칸 ' + items.length + '개';
    $('cons').textContent = rules.length ? '이 양식의 규칙: ' + rules.join(' · ') + ' — 자동으로 맞춥니다' : '';

    const card = (it) => {
      const badge = isPersonal(it.key)
        ? '<span class="ml-2 rounded px-1.5 py-0.5 text-[10px] font-bold bg-rose-500/20 text-rose-300">개인정보 · 비워두면 원본 유지</span>'
        : (it.limit ? '<span class="ml-2 rounded px-1.5 py-0.5 text-[10px] font-bold bg-amber-500/20 text-amber-300">' + it.limit + '자 이내</span>' : '');
      // 값은 라벨이 아니라 칸 위치(@표:행:열)로 보낸다 — 같은 이름의 칸이 여럿이면 라벨로는 첫 칸만 채워졌다
      const pos = it.at ? '@' + it.at.table + ':' + it.at.row + ':' + it.at.col : '';
      const cls = ' class="mt-2 w-full rounded-lg bg-zinc-900 border border-zinc-700 focus:border-violet-500 outline-none px-3 py-2 text-sm text-zinc-200"';
      const attrs = ' data-k="' + esc(it.key) + '" data-pos="' + pos + '"' + (it.limit ? ' maxlength="' + it.limit + '"' : '') + cls;
      let input;
      if (it.blanks && it.blanks.length) {
        // 틀 문장 속 빈칸 — 빈칸마다 앞뒤 문맥과 함께 작은 입력란. 빈칸 자리만 바뀌고 밑줄·문단은 그대로 남는다
        input = '<div class="mt-2 space-y-1.5">' + it.blanks.map((b, bi) =>
          '<div class="flex items-center gap-2 text-sm text-zinc-300">'
          + '<span class="shrink-0 text-zinc-400">' + esc(b.before) + '</span>'
          + '<input type="text" maxlength="24" data-k="' + esc(it.key) + '" data-pos="' + pos + '" data-bi="' + bi + '" data-nb="' + it.blanks.length + '"'
          + ' class="w-28 rounded-md bg-zinc-900 border border-zinc-700 focus:border-violet-500 outline-none px-2 py-1 text-sm text-zinc-200" />'
          + '<span class="text-zinc-400">' + esc(b.after) + '</span></div>').join('') + '</div>';
      } else {
        input = it.big ? '<textarea rows="4"' + attrs + '></textarea>' : '<input type="text"' + attrs + ' />';
      }
      const hint = (it.hint && !(it.blanks && it.blanks.length)) ? '<p class="mt-1 text-[11px] text-zinc-500">양식 안내: ' + esc(String(it.hint).slice(0, 160)) + '</p>' : '';
      return '<div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-4">'
        + '<label class="text-sm font-bold text-zinc-200">' + esc(it.key) + badge + '</label>' + input + hint + '</div>';
    };

    // 표 모양 칸(팀 구성·추진 일정·사업비)은 표 그대로 보여 준다. 예비창업패키지 사업계획서는 이런 칸이
    // 121개라 낱개 입력란으로 늘어놓으면 화면이 끝없이 길어졌다. 칸은 절 제목 아래로 묶는다.
    const grid = (group) => {
      const rows = [...new Set(group.map((it) => it.at.row))].sort((a, b) => a - b);
      const cols = [...new Set(group.map((it) => it.at.col))].sort((a, b) => a - b);
      const at = {};
      group.forEach((it) => { at[it.at.row + ':' + it.at.col] = it; });
      const head = cols.map((c) => {
        const names = group.filter((it) => it.at.col === c).map((it) => it.key.replace(/ \(\d+\)$/, ''));
        const name = names.sort((a, b) => names.filter((x) => x === b).length - names.filter((x) => x === a).length)[0] || '';
        return '<th class="px-2 py-1.5 text-left text-[11px] font-bold text-zinc-300 whitespace-nowrap">' + esc(name)
          + (isPersonal(name) ? ' <span class="text-rose-300">·개인정보</span>' : '') + '</th>';
      }).join('');
      const body = rows.map((r) => '<tr>' + cols.map((c) => {
        const it = at[r + ':' + c];
        if (!it) return '<td></td>';
        const pos = '@' + it.at.table + ':' + it.at.row + ':' + it.at.col;
        return '<td class="p-1"><input type="text" data-k="' + esc(it.key) + '" data-pos="' + pos + '"'
          + (it.limit ? ' maxlength="' + it.limit + '"' : '') + ' placeholder="' + esc(String(it.hint || '').slice(0, 30)) + '"'
          + ' class="w-full min-w-[7rem] rounded-md bg-zinc-900 border border-zinc-700 focus:border-violet-500 outline-none px-2 py-1.5 text-xs text-zinc-200 placeholder:text-zinc-600" /></td>';
      }).join('') + '</tr>').join('');
      return '<div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-3 overflow-x-auto">'
        + '<p class="mb-2 text-[11px] text-zinc-500">표 ' + rows.length + '줄 · 회색 글씨는 양식의 예시입니다</p>'
        + '<table class="w-full border-separate border-spacing-0"><thead><tr>' + head + '</tr></thead><tbody>' + body + '</tbody></table></div>';
    };

    const byTable = new Map();
    items.forEach((it) => {
      const t = it.at ? it.at.table : -1;
      if (!byTable.has(t)) byTable.set(t, []);
      byTable.get(t).push(it);
    });
    const sections = info.sections || [];
    let html = '', lastSec = null;
    for (const [t, group] of byTable) {
      const title = t >= 0 ? (sections[t] || '') : '';
      if (title && title !== lastSec) {
        html += '<h3 class="pt-4 pb-1 text-sm font-black text-violet-300">' + esc(title) + '</h3>';
        lastSec = title;
      }
      // 데이터 표 = 같은 열의 칸들이 같은 이름(열 머리글)을 가진다. '라벨|값' 이 섞인 신청서 표는
      // 같은 열에 주제명·팀 정보 같은 다른 이름이 오므로 표 모양으로 그리지 않는다.
      const base = (it) => it.key.replace(/ \(\d+\)$/, '');
      // 열마다 다른 이름은 하나까지 — 사업비 표의 마지막 '합 계' 줄처럼
      const colsSame = [...new Set(group.map((it) => it.at && it.at.col))].every((c) => {
        const names = group.filter((it) => it.at.col === c).map(base);
        const top = Math.max(...[...new Set(names)].map((n) => names.filter((x) => x === n).length));
        return top >= names.length - 1;
      });
      const tabular = group.every((it) => it.at && !it.big && !(it.blanks && it.blanks.length))
        && group.length >= 4 && colsSame
        && new Set(group.map((it) => it.at.row)).size >= 2
        && new Set(group.map((it) => it.at.col)).size >= 2;
      html += tabular ? grid(group) : group.map(card).join('');
    }
    $('slots').innerHTML = html;

    // 채울 칸이 없는 파일이 흔하다 — 공고문, 동의서, 이미 작성된 문서. 빈 화면을 주지 말고 왜인지 말한다.
    if (!items.length) {
      $('fields').classList.add('hidden');
      $('empty').classList.remove('hidden');
      $('emptyWhy').textContent = info.tables
        ? `표 ${info.tables}개를 읽었지만 채울 빈칸을 찾지 못했습니다. 공고문이거나 이미 작성이 끝난 문서, 또는 체크·서명만 하는 서식일 수 있습니다.`
        : '이 파일에는 표가 없습니다. 빈칸을 채우는 양식이 아니라 줄글 문서로 보입니다.';
      say('빈칸을 찾지 못했습니다', 'text-amber-300');
      return;
    }
    $('empty').classList.add('hidden');
    $('fields').classList.remove('hidden');
    say('✓ 빈칸 ' + items.length + '개를 찾았습니다. 채운 뒤 아래 버튼을 누르세요.', 'text-emerald-300');
  }

  async function make() {
    const answers = {};
    document.querySelectorAll('#slots [data-k]').forEach((el) => {
      const v = el.value.trim();
      const key = el.dataset.pos || el.dataset.k;
      if (el.dataset.bi !== undefined) {                 // 빈칸 칸: 빈칸 순서대로 목록
        if (!answers[key]) answers[key] = Array(+el.dataset.nb).fill('');
        answers[key][+el.dataset.bi] = v;
      } else if (v) {
        answers[key] = v;
      }
    });
    for (const k of Object.keys(answers)) {            // 빈칸을 하나도 안 쓴 칸은 보내지 않는다
      if (Array.isArray(answers[k]) && !answers[k].some(Boolean)) delete answers[k];
    }
    if (!info) { say('⚠ 양식 파일을 먼저 올려주세요.', 'text-rose-300'); return; }
    if (!Object.keys(answers).length) { say('⚠ 한 칸 이상 채워주세요.', 'text-rose-300'); return; }
    busy = true;
    $('make').disabled = true;
    say('✍ 제출본을 만드는 중…', 'text-violet-300 animate-pulse');
    try {
      py.FS.writeFile('/engine/ans.json', JSON.stringify(answers));
      const raw = await py.runPythonAsync([
        'import io, json, sys',
        'import form_tool as FT, audit',
        '_a = json.load(open("ans.json", encoding="utf-8"))',
        '_a = {k: v for k, v in _a.items() if not k.startswith("_")}',
        '_o = sys.stdout; sys.stdout = io.StringIO()',
        'try:',
        '    FT.fill("form.hwpx", _a, "out.hwpx")',
        '    _f = audit.audit("out.hwpx", base="form.hwpx")',
        'finally:',
        '    sys.stdout = _o',
        'json.dumps([x.as_dict() for x in _f], ensure_ascii=False)'
      ].join('\n'));
      outBytes = py.FS.readFile('/engine/out.hwpx');
      showResult(JSON.parse(raw));
    } catch (e) {
      say('❌ 만들지 못했습니다: ' + String(e).split('\n').pop().slice(0, 160), 'text-rose-300');
    } finally {
      busy = false;
      $('make').disabled = false;
    }
  }

  function showResult(found) {
    // 판정 기준은 로컬 엔진(hforge check)과 같아야 한다 — level 값은 한글이다.
    const isTodo = (f) => f.code === 'TODO' || f.level === 'TODO';
    const errs = found.filter((f) => f.level === '오류');
    const warns = found.filter((f) => f.level === '경고');
    const todo = found.filter(isTodo);
    const ok = errs.length === 0;
    $('verdict').className = 'rounded-3xl border-2 p-8 text-center ' + (ok ? 'border-emerald-500/40 bg-emerald-500/10' : 'border-rose-500/40 bg-rose-500/10');
    $('verdict').innerHTML = '<p class="text-6xl">' + (ok ? '✅' : '⚠️') + '</p>'
      + '<p class="mt-3 text-2xl font-black text-white">' + (ok ? '제출 가능' : '수정 필요 ' + errs.length + '건') + '</p>'
      + (ok && warns.length ? '<p class="mt-2 text-sm text-amber-200">경고 ' + warns.length + '건은 눈으로 확인해 주세요</p>' : '')
      + (todo.length ? '<p class="mt-2 text-sm text-zinc-300">직접 입력할 칸 ' + todo.length + '개 — 개인정보는 일부러 비웠습니다</p>' : '');
    const TONE = { '오류': 'border-rose-500/40 text-rose-200', '경고': 'border-amber-500/40 text-amber-200', '정보': 'border-zinc-700 text-zinc-400' };
    $('findings').innerHTML = found.slice(0, 40).map((f) => {
      const t = isTodo(f) ? 'border-zinc-700 text-zinc-300' : (TONE[f.level] || 'border-zinc-700 text-zinc-400');
      // 검사는 칸을 "표0(3,2)"로 가리킨다 — 사람이 알아볼 라벨로 바꿔 준다.
      let msg = String(f.message || '').replace(/표(\d+)\((\d+),(\d+)\)/g, (m) => cellLabel[m] ? cellLabel[m] : m);
      let hint = f.hint || '';
      if (isTodo(f)) {
        msg = '<b class="text-zinc-200">' + esc(msg.split(' ')[0]) + '</b> ' + esc(msg.split(' ').slice(1).join(' '));
        hint = '양식의 원래 예시가 그대로 있습니다 — 한글에서 직접 입력하세요';
      } else {
        msg = esc(msg);
      }
      // 쪽수는 렌더러가 있어야 세므로 브라우저에서는 "?쪽"이 된다. 물음표 대신 사실대로 적는다.
      if (msg.indexOf('?쪽') >= 0) {
        msg = msg.replace(/\(문서 전체 \?쪽\)/, '').trim();
        hint = '쪽수는 이 브라우저에서 셀 수 없습니다. 내려받아 한글이나 rhwp로 열어 확인하세요';
      }
      const where = isTodo(f) ? '' : esc(f.where || '') + ' — ';
      return '<div class="rounded-xl border ' + t + ' bg-zinc-900/40 px-4 py-2 text-xs"><b>' + esc(f.code) + '</b> '
        + where + msg + (hint ? ' <span class="text-zinc-500">→ ' + esc(hint) + '</span>' : '') + '</div>';
    }).join('');
    $('result').classList.remove('hidden');
    say('✓ 완료', 'text-emerald-300');
    $('result').scrollIntoView({ behavior: 'smooth' });
    renderPreview(outBytes);
  }

  // 파일을 고르려는 낌새가 보이면 그때부터 엔진을 받는다. 파일 선택창을 띄우고 고르는
  // 몇 초~수십 초가 그대로 다운로드 시간으로 쓰여, 느린 폰에서 체감 대기가 크게 준다.
  const preload = () => { boot().catch(() => {}); };
  $('drop').addEventListener('pointerenter', preload, { once: true });
  $('drop').addEventListener('touchstart', preload, { once: true, passive: true });

  $('drop').addEventListener('click', () => { preload(); $('file').click(); });
  $('file').addEventListener('change', (e) => onFile(e.target.files[0]));
  $('drop').addEventListener('dragover', (e) => { e.preventDefault(); $('drop').classList.add('border-violet-500'); });
  $('drop').addEventListener('dragleave', () => $('drop').classList.remove('border-violet-500'));
  $('drop').addEventListener('drop', (e) => {
    e.preventDefault();
    $('drop').classList.remove('border-violet-500');
    onFile(e.dataTransfer.files[0]);
  });
  $('make').addEventListener('click', make);
  $('dl').addEventListener('click', () => {
    if (!outBytes) return;
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([outBytes], { type: 'application/octet-stream' }));
    a.download = (srcName || '제출본').replace(/\.hwpx?$/i, '') + '_작성본.hwpx';
    a.click();
    URL.revokeObjectURL(a.href);
  });
</script>
