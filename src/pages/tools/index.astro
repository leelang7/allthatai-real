---
import Layout from '../../layouts/Layout.astro';

const tools = [
  { href: '/tools/salary-calc/', title: '연봉 실수령액', desc: '2026 4대보험 + 소득세 자동 차감', emoji: '💰', tag: '재무' },
  { href: '/tools/currency/', title: '환율 계산기', desc: '16개 통화 실시간 + Wise 송금 절약', emoji: '💱', tag: '재무' },
  { href: '/tools/card-pick/', title: '신용카드 추천', desc: '월 소비 패턴 → 최고 캐시백 카드', emoji: '💳', tag: '재무' },
  { href: '/tools/agent-fee-calc/', title: '대행 절감 계산', desc: 'NICE·통신판매업·사업자 직접 vs 대행', emoji: '⚠', tag: '재무' },
  { href: '/tools/loan-compare/', title: '대출 월 상환액', desc: '원리금/원금/만기일시 3가지 방식 동시 비교', emoji: '🏦', tag: '재무' },
  { href: '/tools/tax-refund/', title: '세금 환급 예상', desc: '연말정산 환급 vs 추징 즉시 계산 (2026)', emoji: '💸', tag: '재무' },
  { href: '/tools/auto-insurance/', title: '자동차 보험 비교', desc: '9개 다이렉트 + 6가지 절약 팁', emoji: '🚗', tag: '재무' },
  { href: '/jeonse/risk-calc/', title: '전세 위험 점수', desc: '계약 전 0–100 자가 진단', emoji: '🏠', tag: '재무' },
  { href: '/jeonse/etungi-analyzer/', title: '등기부등본 분석', desc: '텍스트 복붙 → 위험 자동 추출', emoji: '🔍', tag: '재무' },
  { href: '/jeonse/contract-checklist/', title: '전세 계약 체크리스트', desc: '계약 현장 48개 항목 (인쇄 가능)', emoji: '📋', tag: '재무' },
  { href: '/jeonse/landlord-verify/', title: '임대인 검증', desc: '사업자번호 체크섬 + 공식 진위 확인', emoji: '👤', tag: '재무' },
  { href: '/jeonse/hug-simulator/', title: 'HUG 안심전세 시뮬', desc: '가입 가능 여부 + 보증료 자동', emoji: '🛡️', tag: '재무' },
  { href: '/tools/holiday-2026/', title: '2026 공휴일·황금연휴', desc: '20개 공휴일 + 5개 황금연휴 + 디데이', emoji: '🎌', tag: '생활' },
  { href: '/tools/savings/', title: '적금·예금 만기 계산', desc: '단리/복리 + 세후 수령액 (이자세 15.4%)', emoji: '🏦', tag: '재무' },
  { href: '/tools/severance/', title: '퇴직금 계산기', desc: '근속·평균임금 + 퇴직소득세 자동', emoji: '💼', tag: '재무' },
  { href: '/tools/vat-calc/', title: '부가세 계산기', desc: '공급가액 ↔ 부가세 ↔ 합계 자동 분리', emoji: '🧾', tag: '재무' },
  { href: '/tools/parental-leave/', title: '육아휴직 급여', desc: '2026 + 6+6 부모육아휴직 12개월 자동', emoji: '👶', tag: '재무' },
  { href: '/tools/acquisition-tax/', title: '취득세 계산기', desc: '주택 매수 — 다주택·생애최초·신혼 자동', emoji: '🏘️', tag: '재무' },
  { href: '/tools/realtor-fee/', title: '중개수수료 계산', desc: '매매·전세·월세 법정 한도 + VAT', emoji: '🤝', tag: '재무' },
  { href: '/tools/childcare-money/', title: '자녀 지원금 총정리', desc: '부모급여·양육수당·첫만남·아동수당', emoji: '🍼', tag: '재무' },
  { href: '/tools/insurance-medical/', title: '실손·암·종신 보험', desc: '5종 보험 + 8개 보험사 + 절약 팁', emoji: '🏥', tag: '재무' },
  { href: '/tools/gift-tax/', title: '증여세 계산기', desc: '부모·자녀·배우자 공제 자동 적용', emoji: '🎁', tag: '재무' },
  { href: '/tools/capital-gains/', title: '주식 양도세', desc: '국내 대주주·해외주식 22% 자동', emoji: '📈', tag: '재무' },
  { href: '/tools/national-pension/', title: '국민연금 수령액', desc: '평균소득 + 가입기간 → 노령연금 추정', emoji: '👴', tag: '재무' },
  { href: '/tools/unemployment-benefit/', title: '실업급여 계산기', desc: '평균임금 + 연령 + 가입 → 일액·총액·기간', emoji: '🆘', tag: '재무' },
  { href: '/tools/comprehensive-income-tax/', title: '종합소득세 (5월)', desc: '프리랜서·사업·기타 → 누진세 자동 (D-14)', emoji: '📊', tag: '재무' },
  { href: '/tools/housing-subscription/', title: '청약 가점 계산', desc: '무주택+부양가족+통장 → 84점 만점', emoji: '🏢', tag: '재무' },
  { href: '/tools/loan-limit/', title: 'DSR·LTV 한도', desc: '연소득 + 주택가 → 받을 수 있는 한도', emoji: '💰', tag: '재무' },
  { href: '/tools/real-estate-capital-gains/', title: '부동산 양도세', desc: '1주택 12억 비과세·다주택 중과 자동', emoji: '🏘', tag: '재무' },
  { href: '/tools/property-tax/', title: '종합부동산세', desc: '공시가격·다주택·장기보유공제 자동', emoji: '🏛', tag: '재무' },
  { href: '/tools/health-insurance/', title: '건강보험료', desc: '직장·지역가입자 + 장기요양 12.95%', emoji: '🩺', tag: '재무' },
  { href: '/tools/real-estate-lifecycle/', title: '⚡ 부동산 라이프사이클', desc: '매수→보유→매도 5개 세금 통합 시뮬', emoji: '🔄', tag: '재무' },
  { href: '/tools/rental-yield/', title: '임대 수익률 분석', desc: '표면·실·자기자본 ROI 3단 + 레버리지', emoji: '📊', tag: '재무' },
  { href: '/tools/jeonse-monthly-conversion/', title: '전월세 전환율', desc: '전세 ↔ 월세 환산 + 법정 상한 5.5%', emoji: '🔁', tag: '재무' },
  { href: '/tools/wedding-cost/', title: '결혼 비용 계산', desc: '8개 항목 평균 + 본인 시뮬', emoji: '💒', tag: '생활' },
  { href: '/tools/solo-budget/', title: '자취 월 예산', desc: '1인가구 8개 항목 + 평균 비교', emoji: '🏠', tag: '생활' },
  { href: '/jeonse/full-check/', title: '⚡ 전세 통합 검증', desc: '임대인+건축물+시세 4개 API 동시', emoji: '🛡️', tag: '재무' },
  { href: '/jeonse/building-check/', title: '건축물대장 위반 조회', desc: '국토부 실시간 — 불법 증축 자동', emoji: '🏗️', tag: '재무' },
  { href: '/tools/car-price/', title: '중고차 시세 비교', desc: 'KB차차차·엔카·헤이딜러 + 사고이력', emoji: '🚙', tag: '재무' },
  { href: '/tools/jaso-guide/', title: 'AI 자소서 가이드', desc: 'Claude/GPT 복붙 프롬프트 3개', emoji: '✍️', tag: 'AI' },
  { href: '/tools/age-korean/', title: '만 나이 계산기', desc: '한국 만나이 통일법 기준', emoji: '🎂', tag: '생활' },
  { href: '/tools/dday/', title: '디데이 계산기', desc: '시험·기념일 + 100일·1000일 자동', emoji: '📅', tag: '생활' },
  { href: '/tools/leave-days/', title: '연차 계산기', desc: '입사일 → 발생 연차일 (근로기준법)', emoji: '🏝️', tag: '생활' },
  { href: '/tools/bmi/', title: 'BMI + 칼로리', desc: '한국 기준 비만도 + 일일 권장 kcal', emoji: '⚖️', tag: '건강' },
  { href: '/lotto/', title: '로또 번호 추천', desc: 'Hot/Cold 통계 + AI 가중치 추천', emoji: '🎰', tag: '취미' },
  { href: '/tools/ai-pricing/', title: 'AI 비용 계산', desc: '사용 패턴 → 최적 AI 도구 조합', emoji: '🤖', tag: 'AI' },
  { href: '/tools/team-plan-match/', title: '팀 플랜 분담', desc: 'Claude Team·Notion 5인 공동구매', emoji: '👥', tag: 'AI' },
  { href: '/lol/spell-timer/', title: '롤 스펠 타이머', desc: '점멸·텔포·점화 쿨다운 카운트', emoji: '⚔️', tag: 'LoL' },
  { href: '/tools/mbti/', title: 'MBTI 무료 검사', desc: '12문항 간이 → 16유형 즉시', emoji: '🧠', tag: '취미' },
  { href: '/box-office/', title: '박스오피스', desc: '한국 일별 영화 관객 순위 (KOFIC)', emoji: '🎬', tag: '취미' },
  { href: '/symbols/', title: '특수문자 복사', desc: '체크박스 ☑ 별 ★ 한 번 클릭 복사', emoji: '☑', tag: '생활' },
  { href: '/snippets/', title: '복붙 스니펫', desc: '정규식·Git·Linux·SQL·한국 특화', emoji: '📋', tag: '개발' },
];

const grouped: Record<string, typeof tools> = {};
tools.forEach((t) => {
  if (!grouped[t.tag]) grouped[t.tag] = [];
  grouped[t.tag].push(t);
});
const ordered = ['재무', '생활', '건강', '취미', 'AI', 'LoL', '개발'];
---
<Layout
  title="무료 계산기 / 도구 모음 — 연봉·환율·만나이·디데이·BMI·로또"
  description="한국에서 자주 쓰는 무료 계산기 모음. 연봉 실수령액, 환율, 만 나이, 디데이, 연차, BMI, 로또, AI 비용 등."
>
  <section class="mx-auto max-w-5xl px-4 pt-16 pb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-500/5 px-3 py-1 text-xs text-cyan-300">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
      무료 도구 모음
    </div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight">
      <span class="text-gradient">{tools.length}개 무료</span> 계산기 / 도구
    </h1>
    <p class="mt-4 text-lg text-zinc-400 leading-relaxed">
      재무·생활·건강·AI — 한국 사용자가 자주 검색하는 도구 모음. 광고 없이 즉시 사용.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-24 space-y-10">
    {ordered.filter((cat) => grouped[cat]?.length > 0).map((cat) => (
      <div>
        <h2 class="text-sm font-black text-zinc-400 mb-3 uppercase tracking-widest">{cat}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {grouped[cat].map((t) => (
            <a href={t.href} class="card-lift block rounded-2xl border border-zinc-800 hover:border-cyan-500/40 bg-zinc-900/40 p-5 transition">
              <div class="flex items-start gap-3">
                <span class="text-3xl">{t.emoji}</span>
                <div class="flex-1 min-w-0">
                  <p class="font-black text-white">{t.title}</p>
                  <p class="mt-1 text-xs text-zinc-400 leading-relaxed">{t.desc}</p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>
